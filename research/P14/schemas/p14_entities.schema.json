{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "p14_entities.schema.json",
  "title": "P14 entity contracts (v1, frozen 2026-09-07)",
  "description": "P14.1 执行契约的规范镜像。运行环境无 jsonschema，p14_integrity_gate.py 内置等价结构校验；--selftest 证明两者一致。hash 约定与失效语义见 RUNBOOK_P14_1.md §4/§5。",
  "definitions": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ref": {
      "type": "object",
      "required": ["entity_type", "entity_id", "content_sha256"],
      "properties": {
        "entity_type": {"enum": ["experiment_spec", "execution", "result", "evidence", "claim", "model_artifact"]},
        "entity_id": {"type": "string"},
        "content_sha256": {"$ref": "#/definitions/sha256"}
      }
    },
    "envelope": {
      "type": "object",
      "required": ["entity_type", "entity_id", "schema_version", "run_id", "created_at", "content_sha256", "parent_ref"],
      "properties": {
        "entity_type": {"enum": ["experiment_spec", "execution", "result", "evidence", "claim"]},
        "entity_id": {"type": "string", "pattern": "^P14-(SPEC|EXE|RES|EVI|CLM)[0-9]{3}$"},
        "schema_version": {"const": "p14.v1"},
        "run_id": {"type": "string", "pattern": "^P14-[0-9]{8}-[0-9]{2}$"},
        "created_at": {"type": "string"},
        "content_sha256": {"$ref": "#/definitions/sha256"},
        "parent_ref": {"$ref": "#/definitions/ref"}
      }
    },
    "experiment_spec": {
      "allOf": [{"$ref": "#/definitions/envelope"}],
      "required": ["question_id", "condition", "model_artifact_ref", "verification_questions", "experiments", "generator"],
      "properties": {
        "entity_type": {"const": "experiment_spec"},
        "question_id": {"enum": ["2020_B", "2024_B", "2022_C"]},
        "condition": {"enum": ["C0", "C1"]},
        "model_artifact_ref": {
          "type": "object",
          "required": ["question_id", "arm", "path", "model_artifact_hash"],
          "properties": {
            "question_id": {"enum": ["2020_B", "2024_B", "2022_C"]},
            "arm": {"enum": ["MMA", "B1_F"]},
            "path": {"type": "string"},
            "model_artifact_hash": {"$ref": "#/definitions/sha256"}
          }
        },
        "verification_questions": {"type": "array", "items": {"type": "string"}},
        "experiments": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "required": ["experiment_id", "title", "purpose", "type", "procedure", "metrics", "seed", "runs"],
            "properties": {
              "experiment_id": {"type": "string"},
              "title": {"type": "string"},
              "purpose": {"type": "string"},
              "type": {"enum": ["sensitivity", "robustness", "ablation", "extreme_value", "fit", "simulation"]},
              "procedure": {"type": "string"},
              "metrics": {"type": "array", "items": {"type": "string"}},
              "seed": {"const": 42},
              "runs": {"type": "integer", "minimum": 1}
            }
          }
        },
        "generator": {"type": "string"}
      },
      "if": {"properties": {"condition": {"const": "C0"}}},
      "then": {"properties": {"verification_questions": {"maxItems": 0}}}
    },
    "execution": {
      "allOf": [{"$ref": "#/definitions/envelope"}],
      "required": ["entity_type", "spec_ref", "experiment_id", "runner", "seed", "runs", "status", "log_path", "env_fingerprint"],
      "properties": {
        "entity_type": {"const": "execution"},
        "spec_ref": {"$ref": "#/definitions/ref"},
        "experiment_id": {"type": "string"},
        "runner": {
          "type": "object",
          "required": ["backend", "python_version", "entrypoint", "code_sha256"],
          "properties": {
            "backend": {"const": "python-sandbox"},
            "python_version": {"type": "string"},
            "entrypoint": {"type": "string"},
            "code_sha256": {"$ref": "#/definitions/sha256"}
          }
        },
        "seed": {"const": 42},
        "runs": {"type": "integer", "minimum": 1},
        "status": {"enum": ["completed", "failed", "timeout", "diverged"]},
        "log_path": {"type": "string"},
        "env_fingerprint": {"type": "string"}
      }
    },
    "result": {
      "allOf": [{"$ref": "#/definitions/envelope"}],
      "required": ["entity_type", "execution_ref", "data", "status"],
      "properties": {
        "entity_type": {"const": "result"},
        "execution_ref": {"$ref": "#/definitions/ref"},
        "data": {"type": "object"},
        "status": {"enum": ["valid", "stale", "invalid"]}
      }
    },
    "evidence": {
      "allOf": [{"$ref": "#/definitions/envelope"}],
      "required": ["entity_type", "result_ref", "interpretation", "position", "target_claim_desc", "status"],
      "properties": {
        "entity_type": {"const": "evidence"},
        "result_ref": {"$ref": "#/definitions/ref"},
        "interpretation": {"type": "string"},
        "position": {"enum": ["supports", "refutes", "characterizes"]},
        "target_claim_desc": {"type": "string"},
        "status": {"enum": ["valid", "stale", "invalid"]}
      }
    },
    "claim": {
      "allOf": [{"$ref": "#/definitions/envelope"}],
      "required": ["entity_type", "text", "model_origin", "supported_by", "refuted_by", "status"],
      "properties": {
        "entity_type": {"const": "claim"},
        "text": {"type": "string"},
        "model_origin": {
          "type": "object",
          "required": ["element_type", "anchor"],
          "properties": {
            "element_type": {"enum": ["objective", "constraint", "mechanism", "assumption", "parameter", "variable"]},
            "anchor": {"type": "string", "minLength": 2}
          }
        },
        "supported_by": {"type": "array", "items": {"type": "string", "pattern": "^P14-EVI[0-9]{3}$"}},
        "refuted_by": {"type": "array", "items": {"type": "string", "pattern": "^P14-EVI[0-9]{3}$"}},
        "status": {"enum": ["supported", "refuted", "untested", "unresolved", "stale", "invalid"]}
      }
    }
  },
  "oneOf": [
    {"$ref": "#/definitions/experiment_spec"},
    {"$ref": "#/definitions/execution"},
    {"$ref": "#/definitions/result"},
    {"$ref": "#/definitions/evidence"},
    {"$ref": "#/definitions/claim"}
  ]
}
