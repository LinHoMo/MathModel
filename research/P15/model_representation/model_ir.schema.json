{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathmodel.org/schemas/model_ir-v1.0.json",
  "title": "Model IR v1.0 — MathModel Model Representation Specification",
  "description": "Machine-readable schema for MathModel Model IR / Model Graph. Covers problem binding, assumptions, variables, parameters, objectives, constraints, mechanisms, equations, dependencies, solvers, experiments, validations, claims, model graph, and modeling trace.",
  "type": "object",
  "required": [
    "ir_version",
    "model_id",
    "model_family",
    "problem_binding",
    "assumptions",
    "variables",
    "parameters",
    "objectives",
    "constraints",
    "mechanisms",
    "equations",
    "dependencies",
    "solvers",
    "experiments",
    "validations",
    "claims",
    "model_graph"
  ],
  "properties": {
    "ir_version": {
      "type": "string",
      "const": "1.0"
    },
    "model_id": {
      "type": "string",
      "minLength": 1,
      "description": "Model instance unique identifier"
    },
    "model_family": {
      "type": "object",
      "required": [
        "primary",
        "description"
      ],
      "properties": {
        "primary": {
          "type": "string",
          "description": "Primary model family, e.g. multibody_dynamics, optimization, ode, statistical, geometric, kinematic, pde, state_space, discrete_recurrence, other"
        },
        "secondary": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "problem_binding": {
      "type": "object",
      "required": [
        "problem_id",
        "sub_question_id",
        "problem_sha256"
      ],
      "properties": {
        "problem_id": {
          "type": "string",
          "minLength": 1
        },
        "sub_question_id": {
          "type": "string",
          "minLength": 1
        },
        "problem_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "problem_card_ref": {
          "type": "string"
        },
        "competition_format": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/assumption"
      }
    },
    "variables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/variable"
      }
    },
    "parameters": {
      "type": "array",
      "minItems": 0,
      "items": {
        "$ref": "#/$defs/parameter"
      }
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/objective"
      }
    },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/constraint"
      }
    },
    "mechanisms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/mechanism"
      }
    },
    "equations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/equation"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "solvers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/solver"
      }
    },
    "experiments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/experiment"
      }
    },
    "validations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/validation"
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "model_graph": {
      "$ref": "#/$defs/model_graph"
    },
    "modeling_trace": {
      "$ref": "#/$defs/modeling_trace"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "assumption": {
      "type": "object",
      "required": [
        "assumption_id",
        "text",
        "source",
        "confidence",
        "sub_question_binding"
      ],
      "properties": {
        "assumption_id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "enum": [
            "problem_explicit",
            "reasonable_simplification",
            "domain_knowledge",
            "derived"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "anchors_to_problem": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "line": {
                "type": "integer"
              },
              "quote": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "sub_question_binding": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "projection",
            "calibration_anchor",
            "mechanism_assumption",
            "simplification"
          ]
        }
      },
      "additionalProperties": true
    },
    "variable": {
      "type": "object",
      "required": [
        "variable_id",
        "name",
        "symbol",
        "definition",
        "unit",
        "type",
        "sub_question_binding"
      ],
      "properties": {
        "variable_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "definition": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string"
        },
        "dimension": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "continuous",
            "discrete",
            "derived",
            "constant",
            "state",
            "decision",
            "input",
            "index"
          ]
        },
        "value_range": {
          "type": "object",
          "properties": {
            "min": {
              "type": [
                "number",
                "string"
              ]
            },
            "max": {
              "type": [
                "number",
                "string"
              ]
            }
          },
          "additionalProperties": true
        },
        "sub_question_binding": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "index_domain": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "parameter": {
      "type": "object",
      "required": [
        "parameter_id",
        "name",
        "symbol",
        "definition",
        "unit",
        "value",
        "source",
        "sub_question_binding"
      ],
      "properties": {
        "parameter_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "definition": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string"
        },
        "value": {
          "type": [
            "number",
            "string"
          ]
        },
        "source": {
          "type": "string",
          "enum": [
            "problem_given",
            "experimental",
            "assumed",
            "fitted",
            "derived"
          ]
        },
        "sub_question_binding": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      },
      "additionalProperties": true
    },
    "objective": {
      "type": "object",
      "required": [
        "objective_id",
        "type",
        "expression",
        "variables_refs",
        "sub_question_binding",
        "clarity_score"
      ],
      "properties": {
        "objective_id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "minimize",
            "maximize",
            "find",
            "satisfy",
            "simulate",
            "estimand"
          ]
        },
        "expression": {
          "type": "string",
          "minLength": 1
        },
        "variables_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sub_question_binding": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "clarity_score": {
          "type": "object",
          "required": [
            "direction_explicit",
            "expression_explicit",
            "score"
          ],
          "properties": {
            "direction_explicit": {
              "type": "boolean"
            },
            "expression_explicit": {
              "type": "boolean"
            },
            "score": {
              "type": "integer",
              "enum": [
                0,
                1,
                2
              ]
            }
          },
          "additionalProperties": true
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "constraint": {
      "type": "object",
      "required": [
        "constraint_id",
        "type",
        "expression",
        "variables_refs",
        "source",
        "sub_question_binding"
      ],
      "properties": {
        "constraint_id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "equality",
            "inequality",
            "boundary",
            "initial",
            "logical"
          ]
        },
        "expression": {
          "type": "string",
          "minLength": 1
        },
        "variables_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "parameters_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source": {
          "type": "string",
          "enum": [
            "problem",
            "physical_law",
            "assumption_derived",
            "geometric"
          ]
        },
        "sub_question_binding": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "mechanism": {
      "type": "object",
      "required": [
        "mechanism_id",
        "name",
        "description",
        "type",
        "governing_principle",
        "variables_refs",
        "sub_question_binding"
      ],
      "properties": {
        "mechanism_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "physical",
            "geometric",
            "statistical",
            "optimization",
            "dynamical",
            "other"
          ]
        },
        "governing_principle": {
          "type": "string",
          "minLength": 1
        },
        "variables_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "assumptions_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sub_question_binding": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      },
      "additionalProperties": true
    },
    "equation": {
      "type": "object",
      "required": [
        "equation_id",
        "latex",
        "type",
        "variables_refs",
        "derivation_trace",
        "sub_question_binding"
      ],
      "properties": {
        "equation_id": {
          "type": "string",
          "minLength": 1
        },
        "latex": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "constitutive",
            "balance",
            "definition",
            "derived",
            "boundary",
            "initial"
          ]
        },
        "variables_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "parameters_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mechanism_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "derivation_trace": {
          "type": "object",
          "required": [
            "from_assumptions",
            "from_mechanisms",
            "from_equations",
            "steps"
          ],
          "properties": {
            "from_assumptions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "from_mechanisms": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "from_equations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "steps": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": true
        },
        "sub_question_binding": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "dependency": {
      "type": "object",
      "required": [
        "dependency_id",
        "from_type",
        "from_id",
        "to_type",
        "to_id",
        "relation",
        "sub_question_binding"
      ],
      "properties": {
        "dependency_id": {
          "type": "string",
          "minLength": 1
        },
        "from_type": {
          "type": "string",
          "enum": [
            "variable",
            "parameter",
            "assumption",
            "mechanism",
            "equation",
            "constraint",
            "objective"
          ]
        },
        "from_id": {
          "type": "string",
          "minLength": 1
        },
        "to_type": {
          "type": "string",
          "enum": [
            "variable",
            "parameter",
            "assumption",
            "mechanism",
            "equation",
            "constraint",
            "objective"
          ]
        },
        "to_id": {
          "type": "string",
          "minLength": 1
        },
        "relation": {
          "type": "string",
          "enum": [
            "feeds",
            "derives",
            "governs",
            "defines",
            "constrains",
            "uses"
          ]
        },
        "sub_question_binding": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      },
      "additionalProperties": true
    },
    "solver": {
      "type": "object",
      "required": [
        "solver_id",
        "name",
        "type",
        "method",
        "sub_question_binding"
      ],
      "properties": {
        "solver_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "analytical",
            "numerical",
            "optimization",
            "simulation",
            "other"
          ]
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "object",
          "additionalProperties": true
        },
        "convergence_criteria": {
          "type": "object",
          "additionalProperties": true
        },
        "implementation_ref": {
          "type": "string"
        },
        "equations_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sub_question_binding": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      },
      "additionalProperties": true
    },
    "experiment": {
      "type": "object",
      "required": [
        "experiment_id",
        "method",
        "outputs",
        "run_metadata",
        "sub_question_binding"
      ],
      "properties": {
        "experiment_id": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "object",
          "additionalProperties": true
        },
        "inputs_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "results": {
          "type": "object",
          "additionalProperties": true
        },
        "run_metadata": {
          "type": "object",
          "required": [
            "seed",
            "repetitions"
          ],
          "properties": {
            "seed": {
              "type": "integer"
            },
            "repetitions": {
              "type": "integer"
            },
            "latency_seconds": {
              "type": "number"
            },
            "exit_code": {
              "type": "integer"
            }
          },
          "additionalProperties": true
        },
        "solver_ref": {
          "type": "string"
        },
        "sub_question_binding": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      },
      "additionalProperties": true
    },
    "validation": {
      "type": "object",
      "required": [
        "validation_id",
        "type",
        "method",
        "results",
        "pass_fail",
        "sub_question_binding"
      ],
      "properties": {
        "validation_id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "baseline",
            "sensitivity",
            "robustness",
            "uncertainty",
            "counterfactual",
            "failure_case",
            "convergence"
          ]
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "results": {
          "type": "object",
          "additionalProperties": true
        },
        "pass_fail": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "inconclusive"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "targets_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sub_question_binding": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      },
      "additionalProperties": true
    },
    "claim": {
      "type": "object",
      "required": [
        "claim_id",
        "text",
        "type",
        "evidence_refs",
        "sub_question_binding"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "result",
            "interpretation",
            "recommendation"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "model_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "experiment_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "validation_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sub_question_binding": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "supported",
            "refuted",
            "unresolved"
          ]
        }
      },
      "additionalProperties": true
    },
    "model_graph": {
      "type": "object",
      "required": [
        "graph_version",
        "nodes",
        "edges"
      ],
      "properties": {
        "graph_version": {
          "type": "string"
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "node_id",
              "node_type"
            ],
            "properties": {
              "node_id": {
                "type": "string",
                "minLength": 1
              },
              "node_type": {
                "type": "string",
                "enum": [
                  "problem",
                  "subquestion",
                  "assumption",
                  "variable",
                  "parameter",
                  "mechanism",
                  "objective",
                  "constraint",
                  "equation",
                  "solver",
                  "experiment",
                  "result",
                  "validation",
                  "claim"
                ]
              },
              "label": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "source_node",
              "target_node",
              "edge_type"
            ],
            "properties": {
              "source_node": {
                "type": "string",
                "minLength": 1
              },
              "target_node": {
                "type": "string",
                "minLength": 1
              },
              "edge_type": {
                "type": "string",
                "enum": [
                  "cites_problem",
                  "references_variable",
                  "uses_parameter",
                  "derives",
                  "governed_by",
                  "constrains",
                  "feeds",
                  "solved_by",
                  "produces",
                  "validates",
                  "evidenced_by",
                  "claims_result",
                  "supports",
                  "binds_to",
                  "defines"
                ]
              },
              "evidence_ref": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "confidence": {
                "type": "number",
                "minimum": 0.0,
                "maximum": 1.0
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "modeling_trace": {
      "type": "object",
      "required": [
        "trace_version",
        "generated_at",
        "agent_identity",
        "input_sha256"
      ],
      "properties": {
        "trace_version": {
          "type": "string"
        },
        "generated_at": {
          "type": "string"
        },
        "agent_identity": {
