      "mechanism_id": "mech_prop",
      "name": "速度传播",
      "description": "由位置对时间的导数得到各把手速度：先求螺线单位切向量，再乘各把手弧长速率；速度不是简单等于龙头速度，而是由链式约束的几何因子决定，体现内侧把手速度放大效应。",
      "type": "kinematics",
      "governing_principle": "chain-rule differentiation of position along curve",
      "variables_refs": [
        "var_v_i",
        "var_ux_i",
        "var_uy_i",
        "var_theta_i"
      ],
      "assumptions_refs": [
        "a3",
        "a4"
      ],
      "sub_question_binding": "Q1"
    },
    {
      "mechanism_id": "mech_collision",
      "name": "碰撞判定",
      "description": "把每节板凳抽象为线段（必要时含宽度 w 的矩形），逐时刻判定任意两条非相邻线段的最近距离；相邻节恒接触不参与判定。非相邻节在盘入密集处同样可能相碰，因此必须全对扫描。",
      "type": "geometry",
      "governing_principle": "segment-segment distance sweep",
      "variables_refs": [
        "var_gap",
        "var_t_col",
        "var_x_i",
        "var_y_i",
        "par_w"
      ],
      "assumptions_refs": [
        "a5"
      ],
      "sub_question_binding": "Q2"
    },
    {
      "mechanism_id": "mech_step",
      "name": "时间步进",
      "description": "以固定步长 dt 用四阶龙格-库塔推进龙头极角，每步完成链式递推、速度传播与碰撞检测；步长同时受输出采样（1 s）与碰撞精度约束，需做收敛检验确定。",
      "type": "numerical",
      "governing_principle": "explicit RK4 time marching",
      "variables_refs": [
        "var_t",
        "var_theta_i",
        "var_v_i",
        "par_dt"
      ],
      "assumptions_refs": [
        "a6"
      ],
      "sub_question_binding": "Q1"
    }
  ],
  "equations": [
    {
      "equation_id": "eq_spiral",
      "latex": "r_i = k\\,theta_i",
      "type": "geometry",
      "variables_refs": [
        "var_r_i",
        "var_theta_i"
      ],
      "parameters_refs": [
        "par_k"
      ],
      "mechanism_ref": "mech_curve",
      "derivation_trace": "等距螺线极坐标方程",
      "sub_question_binding": "Q1"
    },
    {
      "equation_id": "eq_arclen",
      "latex": "\\mathrm{d}s = \\sqrt{r^2 + k^2}\\,\\mathrm{d}theta",
      "type": "geometry",
      "variables_refs": [
        "var_s_i",
        "var_r_i",
        "var_theta_i"
      ],
      "parameters_refs": [
        "par_k"
      ],
      "mechanism_ref": "mech_curve",
      "derivation_trace": "螺线弧长微分",
      "sub_question_binding": "Q1"
    },
    {
      "equation_id": "eq_head",
      "latex": "\\frac{\\mathrm{d}theta_1}{\\mathrm{d}t} = \\frac{v_h}{\\sqrt{r_1^2 + k^2}}",
      "type": "kinematics",
      "variables_refs": [
        "var_theta_i",
        "var_r_i",
        "var_v_i"
      ],
      "parameters_refs": [
        "par_v_h",
        "par_k"
      ],
      "mechanism_ref": "mech_prop",
      "derivation_trace": "龙头弧长速率恒为 v_h",
      "sub_question_binding": "Q1"
    },
    {
      "equation_id": "eq_tangent",
      "latex": "ux_i = -\\sintheta_i,\\quad uy_i = \\costheta_i",
      "type": "geometry",
      "variables_refs": [
        "var_ux_i",
        "var_uy_i",
        "var_theta_i"
      ],
      "parameters_refs": [],
      "mechanism_ref": "mech_prop",
      "derivation_trace": "顺时针盘入时螺线单位切向量",
      "sub_question_binding": "Q1"
    },
    {
      "equation_id": "eq_pos_rate",
      "latex": "\\dot{x}_i = ux_i\\,\\sqrt{r_i^2 + k^2}\\,\\dot{theta}_i,\\quad \\dot{y}_i = uy_i\\,\\sqrt{r_i^2 + k^2}\\,\\dot{theta}_i",
      "type": "kinematics",
      "variables_refs": [
        "var_x_i",
        "var_y_i",
        "var_ux_i",
        "var_uy_i",
        "var_r_i",
        "var_theta_i"
      ],
      "parameters_refs": [
        "par_k"
      ],
      "mechanism_ref": "mech_prop",
      "derivation_trace": "位置对时间的链式法则",
      "sub_question_binding": "Q1"
    },
    {
      "equation_id": "eq_chord",
      "latex": "\\sqrt{(x_{i+1}-x_i)^2 + (y_{i+1}-y_i)^2} = d_i",
      "type": "mechanics",
      "variables_refs": [
        "var_x_i",
        "var_y_i"
      ],
      "parameters_refs": [
        "par_d1",
        "par_d"
      ],
      "mechanism_ref": "mech_recursion",
      "derivation_trace": "链式递推的弦长方程",
      "sub_question_binding": "Q1"
    },
    {
      "equation_id": "eq_speed",
      "latex": "v_i = \\sqrt{\\dot{x}_i^2 + \\dot{y}_i^2}",
      "type": "kinematics",
      "variables_refs": [
        "var_v_i",
        "var_x_i",
        "var_y_i"
      ],
      "parameters_refs": [],
      "mechanism_ref": "mech_prop",
      "derivation_trace": "速率定义",
      "sub_question_binding": "Q1"
    },
    {
      "equation_id": "eq_gap",
      "latex": "gap = \\min_{i,j,\\ |i-j|\\ge 2} \\mathrm{dist}(\\mathrm{seg}_i, \\mathrm{seg}_j)",
      "type": "constraint",
      "variables_refs": [
        "var_gap",
        "var_x_i",
        "var_y_i",
        "var_i",
        "var_j"
      ],
      "parameters_refs": [],
      "mechanism_ref": "mech_collision",
      "derivation_trace": "最小间距定义（线段间欧氏距离）",
      "sub_question_binding": "Q2"
    },
    {
      "equation_id": "eq_boundary",
      "latex": "s(theta_0) - s(theta_2) = L_c,\\quad r(theta_2) = R_turn",
      "type": "constraint",
      "variables_refs": [
        "var_s_i",
        "var_r_i",
        "var_theta_i",
        "var_p_min"
      ],
      "parameters_refs": [
        "par_L_c",
        "par_R_turn"
      ],
      "mechanism_ref": "mech_curve",
      "derivation_trace": "问题 3 边界可达条件",
      "sub_question_binding": "Q3"
    },
    {
      "equation_id": "eq_turn",
      "latex": "L_turn = R_1\\,alpha_1 + R_2\\,alpha_2,\\quad C_2 = C_1 + (R_1 + R_2)\\,n",
      "type": "geometry",
      "variables_refs": [
        "var_L_turn",
        "var_R1",
        "var_R2",
        "var_alpha1",
        "var_alpha2",
        "var_C1",
        "var_C2",
        "var_n"
      ],
      "parameters_refs": [],
      "mechanism_ref": "mech_curve",
      "derivation_trace": "问题 4 调头曲线长度与外切关系",
      "sub_question_binding": "Q4"
    },
    {
      "equation_id": "eq_vmax",
      "latex": "v_hmax = \\frac{v_lim\\, v_h}{\\max_i v_i}",
      "type": "optimization",
      "variables_refs": [
        "var_v_hmax",
        "var_v_i",
        "var_i"
      ],
      "parameters_refs": [
        "par_v_lim",
        "par_v_h"
      ],
      "mechanism_ref": "mech_prop",
      "derivation_trace": "问题 5：速率与头速线性同比例，按基准 v_h=1 的结果放大",
      "sub_question_binding": "Q5"
    }
