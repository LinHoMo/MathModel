  "mechanisms": [
    {
      "mechanism_id": "mech_kinematic_map",
      "name": "确定性运动学映射",
      "description": "内层把决策变量映射为完整位置/速度序列：螺线几何 -> 弦长递推 -> 速度耦合 -> 逐秒采样。为何采用：题面输出要求是逐时刻序列，递推是唯一满足链式约束与驱动关系的构造方式；映射对决策变量不可导，因此外层不能使用基于梯度的优化。",
      "type": "kinematics",
      "governing_principle": "composition of geometric recursion and time marching",
      "variables_refs": [
        "var_theta_i",
        "var_x_i",
        "var_y_i",
        "var_v_i"
      ],
      "assumptions_refs": [
        "a1",
        "a2"
      ],
      "sub_question_binding": "Q1"
    },
    {
      "mechanism_id": "mech_penalty",
      "name": "约束惩罚嵌入",
      "description": "把等式/不等式约束并入适应度：违反约束的个体获得惩罚项，使搜索在可行域边界收敛。为何采用：遗传算法原生无约束处理，惩罚法是保持编码简单且与运动学黑箱兼容的标准做法。",
      "type": "optimization",
      "governing_principle": "penalty function method",
      "variables_refs": [
        "var_fit",
        "var_gap",
        "var_t_col"
      ],
      "assumptions_refs": [
        "a4"
      ],
      "sub_question_binding": "Q3"
    },
    {
      "mechanism_id": "mech_ga",
      "name": "群体式随机搜索",
      "description": "以实数编码（p, rho, q 或 v_hmax 的候选解），轮盘赌选择 + 均匀交叉 + 高斯变异，精英保留；因目标含碰撞事件与相切可行性，目标函数高度非凸，群体搜索可覆盖多个局部极值。需要多次独立运行取统计，避免单次结果被当作全局最优。",
      "type": "optimization",
      "governing_principle": "genetic algorithm with elitism",
      "variables_refs": [
        "var_fit",
        "var_gbest",
        "var_p",
        "var_q",
        "var_rho"
      ],
      "assumptions_refs": [
        "a4",
        "a7"
      ],
      "sub_question_binding": "Q3"
    },
    {
      "mechanism_id": "mech_collision",
      "name": "碰撞事件检测",
      "description": "在时间步进中检测任意非相邻板凳矩形相交，首次相交时刻即为碰撞终止时刻；碰撞事件使 t_col 关于决策变量不连续，进一步支持非光滑优化的必要性。",
      "type": "geometry",
      "governing_principle": "rectangle intersection sweep",
      "variables_refs": [
        "var_gap",
        "var_t_col",
        "var_x_i",
        "var_y_i"
      ],
      "assumptions_refs": [
        "a3"
      ],
      "sub_question_binding": "Q2"
    },
    {
      "mechanism_id": "mech_scale",
      "name": "速度线性比例",
      "description": "刚性链约束使各把手速率与头速成线性比例：v_i = lambda_i * v_hmax；比例系数由几何（各把手所在圈层曲率）决定，与头速大小无关，因此问题 5 化为单变量比例缩放。",
      "type": "kinematics",
      "governing_principle": "linear homogeneity of constraint differentiation",
      "variables_refs": [
        "var_v_i",
        "var_v_hmax",
        "var_lambda_i"
      ],
      "assumptions_refs": [
        "a6"
      ],
      "sub_question_binding": "Q5"
    }
  ],
  "equations": [
    {
      "equation_id": "eq_spiral",
      "latex": "r_i = \\frac{p}{2\\pi}\\,theta_i",
      "type": "geometry",
      "variables_refs": [
        "var_r_i",
        "var_theta_i",
        "var_p"
      ],
      "parameters_refs": [],
      "mechanism_ref": "mech_kinematic_map",
      "derivation_trace": "等距螺线极坐标方程，螺距 p=2pi*k",
      "sub_question_binding": "Q1"
    },
    {
      "equation_id": "eq_arclen",
      "latex": "\\mathrm{d}s = \\sqrt{r^2 + (p/2\\pi)^2}\\,\\mathrm{d}theta",
      "type": "geometry",
      "variables_refs": [
        "var_s_i",
        "var_r_i",
        "var_theta_i",
        "var_p"
      ],
      "parameters_refs": [],
      "mechanism_ref": "mech_kinematic_map",
      "derivation_trace": "螺线弧长微分（dr/dtheta = p/2pi）",
      "sub_question_binding": "Q1"
    },
    {
      "equation_id": "eq_chord",
      "latex": "\\sqrt{(x_{i+1}-x_i)^2 + (y_{i+1}-y_i)^2} = d_i",
      "type": "mechanics",
      "variables_refs": [
        "var_x_i",
        "var_y_i"
      ],
      "parameters_refs": [
        "par_d1",
        "par_d"
      ],
      "mechanism_ref": "mech_kinematic_map",
      "derivation_trace": "刚性链孔距约束",
      "sub_question_binding": "Q1"
    },
    {
      "equation_id": "eq_vel",
      "latex": "v_i = lambda_i\\, v_h",
      "type": "kinematics",
      "variables_refs": [
        "var_v_i",
        "var_lambda_i"
      ],
      "parameters_refs": [
        "par_v_h"
      ],
      "mechanism_ref": "mech_scale",
      "derivation_trace": "速度线性比例关系（比例系数由几何决定）",
      "sub_question_binding": "Q5"
    },
    {
      "equation_id": "eq_fitness",
      "latex": "fitness = Phi(p) + mu_1\\,[gap<0] + mu_2\\,[L_c > s_0 - s_2]",
      "type": "optimization",
      "variables_refs": [
        "var_fit",
        "var_p",
        "var_gap",
        "var_t_col"
      ],
      "parameters_refs": [
        "par_L_c"
      ],
      "mechanism_ref": "mech_penalty",
      "derivation_trace": "问题 3 适应度：目标加碰撞与链长约束的指示惩罚",
      "sub_question_binding": "Q3"
    },
    {
      "equation_id": "eq_turn",
      "latex": "L_turn = rho\\,(q\\,alpha_1 + alpha_2),\\quad R_1=q\\,rho,\\ R_2=rho",
      "type": "geometry",
      "variables_refs": [
        "var_L_turn",
        "var_q",
        "var_rho",
        "var_alpha1",
        "var_alpha2"
      ],
      "parameters_refs": [],
      "mechanism_ref": "mech_ga",
      "derivation_trace": "问题 4 调头曲线长度用半径比 q 与缩放 rho 参数化",
      "sub_question_binding": "Q4"
    },
    {
      "equation_id": "eq_tangent",
      "latex": "|C_1 - C_2| = R_1 + R_2,\\quad C_1 + R_1\\,n_1 = C_2 - R_2\\,n_2",
      "type": "constraint",
      "variables_refs": [
        "var_q",
        "var_rho",
        "var_alpha1",
        "var_alpha2"
      ],
      "parameters_refs": [],
      "mechanism_ref": "mech_ga",
      "derivation_trace": "两圆弧外切且切点连续（n 为法向）",
      "sub_question_binding": "Q4"
    },
    {
      "equation_id": "eq_speed_opt",
      "latex": "v_hmax = \\frac{v_lim}{\\max_i lambda_i}",
      "type": "optimization",
      "variables_refs": [
        "var_v_hmax",
        "var_lambda_i"
      ],
      "parameters_refs": [
        "par_v_lim"
      ],
      "mechanism_ref": "mech_scale",
      "derivation_trace": "问题 5 最优头速：使最大放大系数对应的把手恰好达到限速",
      "sub_question_binding": "Q5"
    },
    {
      "equation_id": "eq_col_time",
      "latex": "t_col = \\min\\{ t : \\exists |i-j|\\ge 2,\\ \\mathrm{rect}_i(t)\\cap \\mathrm{rect}_j(t) \\neq \\emptyset \\}",
      "type": "constraint",
      "variables_refs": [
        "var_t_col",
        "var_gap",
        "var_x_i",
        "var_y_i"
      ],
      "parameters_refs": [],
      "mechanism_ref": "mech_collision",
      "derivation_trace": "碰撞终止时刻的定义式",
      "sub_question_binding": "Q2"
    }
