      "sub_question_binding": "Q5"
    },
    {
      "equation_id": "eq_fit",
      "latex": "fitness = Phi(p) + mu_1\\,[gap<0] + mu_2\\,[L_c > s_0 - s_2]",
      "type": "optimization",
      "variables_refs": [
        "var_fit",
        "var_p",
        "var_gap"
      ],
      "parameters_refs": [
        "par_L_c"
      ],
      "mechanism_ref": "mech_search",
      "derivation_trace": "问题 3 适应度函数",
      "sub_question_binding": "Q3"
    },
    {
      "equation_id": "eq_turn",
      "latex": "L_turn = rho\\,(q\\,alpha_1 + alpha_2),\\quad R_1 = q\\,rho,\\ R_2 = rho",
      "type": "geometry",
      "variables_refs": [
        "var_L_turn",
        "var_q",
        "var_rho",
        "var_alpha1",
        "var_alpha2",
        "var_R1",
