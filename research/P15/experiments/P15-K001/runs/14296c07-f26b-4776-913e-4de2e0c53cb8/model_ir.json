  "equations": [
    {
      "equation_id": "eq_spiral",
      "latex": "r_i = k\\,theta_i",
      "type": "geometry",
      "variables_refs": [
        "var_r_i",
        "var_theta_i"
      ],
      "parameters_refs": [
        "par_k"
