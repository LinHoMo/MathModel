    {
      "equation_id": "eq_head",
      "latex": "\\frac{\\mathrm{d}theta_1}{\\mathrm{d}t} = \\frac{v_h}{\\sqrt{r_1^2 + k^2}}",
      "type": "kinematics",
      "variables_refs": [
        "var_theta_i",
        "var_r_i",
        "var_v_i"
      ],
      "parameters_refs": [
        "par_v_h",
        "par_k"
      ],
      "mechanism_ref": "mech_vel",
      "derivation_trace": "龙头沿螺线弧长速率恒为 v_h",
      "sub_question_binding": "Q1"
    },
    {
      "equation_id": "eq_chord",
      "latex": "\\sqrt{(x_{i+1}-x_i)^2 + (y_{i+1}-y_i)^2} = d_i",
      "type": "mechanics",
      "variables_refs": [
        "var_x_i",
        "var_y_i"
      ],
      "parameters_refs": [
        "par_d1",
        "par_d"
      ],
      "mechanism_ref": "mech_recursion",
      "derivation_trace": "链式递推弦长方程",
      "sub_question_binding": "Q1"
    },
    {
      "equation_id": "eq_vel",
      "latex": "v_i = lambda_i\\, v_h,\\quad lambda_i = \\frac{\\sqrt{r_i^2 + k^2}\\,\\dot{theta}_i}{v_h}",
      "type": "kinematics",
      "variables_refs": [
        "var_v_i",
        "var_lambda_i",
        "var_r_i",
        "var_theta_i"
      ],
      "parameters_refs": [
