    },
    {
      "mechanism_id": "mech_recursion",
      "name": "链式递推",
      "description": "沿曲线反向回溯：由第 i 个把手按固定孔距求第 i+1 个把手位置，弦长方程用牛顿迭代求解极角。",
      "type": "mechanics",
      "governing_principle": "backward recursion with chord constraint",
      "variables_refs": [
        "var_x_i",
        "var_y_i",
        "var_theta_i"
      ],
      "assumptions_refs": [
        "a2"
      ],
      "sub_question_binding": "Q1"
    },
    {
      "mechanism_id": "mech_vel",
      "name": "速度传播",
      "description": "速度由位置沿曲线的导数给出，链式约束下内侧把手速率可大于龙头；速度传播使用弧长速率乘以切向单位向量，避免把龙头速度误当作所有把手速度。",
      "type": "kinematics",
      "governing_principle": "chain-rule velocity propagation",
      "variables_refs": [
        "var_v_i",
        "var_theta_i",
        "var_r_i"
      ],
      "assumptions_refs": [
        "a3"
      ],
      "sub_question_binding": "Q1"
    },
    {
      "mechanism_id": "mech_collide",
      "name": "全对碰撞检测",
      "description": "对全部非相邻节对计算线段最近距离，最小间距首次为零的时刻即碰撞终止时刻；密集盘入处非相邻节也可能相碰，故不能只查相邻节。",
      "type": "geometry",
