      "derivation_trace": "问题 4 调头曲线参数化",
      "sub_question_binding": "Q4"
    },
    {
      "equation_id": "eq_tangent",
      "latex": "|C_1 - C_2| = R_1 + R_2",
      "type": "constraint",
      "variables_refs": [
        "var_C1",
        "var_C2",
        "var_R1",
        "var_R2"
      ],
      "parameters_refs": [],
      "mechanism_ref": "mech_curve",
      "derivation_trace": "两圆弧外切条件",
      "sub_question_binding": "Q4"
    },
    {
      "equation_id": "eq_col",
      "latex": "t_col = \\min\\{ t : \\exists\\, |i-j| \\ge 2,\\ \\mathrm{gap}_{i,j}(t) = 0 \\}",
      "type": "constraint",
      "variables_refs": [
        "var_t_col",
        "var_gap",
        "var_i",
        "var_j"
      ],
      "parameters_refs": [],
