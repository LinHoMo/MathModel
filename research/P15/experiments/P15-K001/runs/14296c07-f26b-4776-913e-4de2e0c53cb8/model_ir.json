  "mechanisms": [
    {
      "mechanism_id": "mech_pipeline",
      "name": "几何-运动学管线",
      "description": "严格按顺序组装：曲线参数化 -> 调头段构造 -> 链式递推 -> 速度传播 -> 碰撞判定 -> 时间步进。顺序原则：几何误差若先进入链式递推会被放大进速度，再污染碰撞判定，故必须逐层完成后进入下一层。",
      "type": "structure",
      "governing_principle": "layered geometric-kinematic pipeline",
      "variables_refs": [
