      ],
      "parameters_refs": [],
      "mechanism_ref": "mech_dae",
      "derivation_trace": "约束漂移监测量",
      "sub_question_binding": "Q1"
    },
    {
      "equation_id": "eq_col",
      "latex": "t_col = \\min\\{ t : \\exists\\, |i-j| \\ge 2,\\ \\mathrm{gap}_{i,j}(t) = 0 \\}",
