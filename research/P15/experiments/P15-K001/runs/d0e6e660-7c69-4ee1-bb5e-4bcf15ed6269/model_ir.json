    {
      "equation_id": "eq_dae_g",
      "latex": "g_i = \\sqrt{(x_{i+1}-x_i)^2 + (y_{i+1}-y_i)^2} - d_i = 0",
      "type": "algebraic_constraint",
      "variables_refs": [
        "var_x_i",
        "var_y_i",
        "var_res"
      ],
      "parameters_refs": [
        "par_d1",
        "par_d"
      ],
      "mechanism_ref": "mech_dae",
      "derivation_trace": "DAE 代数约束：孔距恒定",
      "sub_question_binding": "Q1"
    },
    {
      "equation_id": "eq_dae_ode",
      "latex": "\\dot{phi}_i = \\frac{v_h}{\\sqrt{rho_i^2 + k^2}}\\,eta_i(phi),\\quad eta_1 = 1",
      "type": "differential",
      "variables_refs": [
        "var_phi_i",
        "var_rho_i",
        "var_u_i"
      ],
      "parameters_refs": [
        "par_v_h",
        "par_k"
      ],
      "mechanism_ref": "mech_dae",
      "derivation_trace": "对 g 求导降指标后的 ODE（eta_i 为约束流形上的传播系数）",
      "sub_question_binding": "Q1"
    },
    {
      "equation_id": "eq_pos",
      "latex": "x_i = rho_i\\cosphi_i,\\quad y_i = rho_i\\sinphi_i",
      "type": "geometry",
      "variables_refs": [
        "var_x_i",
        "var_y_i",
        "var_rho_i",
        "var_phi_i"
      ],
      "parameters_refs": [],
      "mechanism_ref": "mech_curve",
      "derivation_trace": "极坐标到直角坐标",
      "sub_question_binding": "Q1"
    },
    {
      "equation_id": "eq_u",
      "latex": "u_i = \\sqrt{rho_i^2 + k^2}\\,\\dot{phi}_i",
      "type": "kinematics",
      "variables_refs": [
        "var_u_i",
        "var_rho_i",
        "var_phi_i"
      ],
      "parameters_refs": [
        "par_k"
      ],
      "mechanism_ref": "mech_vel",
      "derivation_trace": "把手速率 = 弧长因子乘极角速率",
