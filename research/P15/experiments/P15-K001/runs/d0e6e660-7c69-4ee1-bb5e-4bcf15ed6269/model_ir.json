      "equation_id": "eq_arclen",
      "latex": "\\mathrm{d}sigma = \\sqrt{rho^2 + k^2}\\,\\mathrm{d}phi",
      "type": "geometry",
      "variables_refs": [
        "var_sigma_i",
        "var_rho_i",
        "var_phi_i"
