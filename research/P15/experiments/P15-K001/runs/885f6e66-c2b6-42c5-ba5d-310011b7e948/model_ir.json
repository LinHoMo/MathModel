      ],
      "sub_question_binding": "Q2"
    },
    {
      "mechanism_id": "mech_timestep",
      "name": "时间步进与逐秒采样",
      "description": "按固定步长 dt 推进龙头极角，每步先解龙头位置、再沿曲线反向递推全部把手，最后按每秒采样输出位置与速度序列。步长需满足输出采样与碰撞检测的双重精度要求。",
      "type": "numerical",
      "governing_principle": "explicit time marching with fixed step",
      "variables_refs": [
