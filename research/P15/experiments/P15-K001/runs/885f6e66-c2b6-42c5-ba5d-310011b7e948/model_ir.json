      "assumptions_refs": [
        "a2",
        "a3"
      ],
      "sub_question_binding": "Q1"
    },
    {
      "mechanism_id": "mech_velocity",
      "name": "弦长约束求导的速度传播",
      "description": "对弦长约束 |P_{i+1}-P_i|=d_i 关于时间求导，得到相邻把手速度在连线方向投影相等，即 (P_{i+1}-P_i) 与相对速度垂直；由此逐节把龙头速度传播到全部把手。这解决了“内侧把手在转弯时速度可超过龙头”的题面陷阱。",
      "type": "kinematics",
      "governing_principle": "time derivative of holonomic constraints",
      "variables_refs": [
        "var_v_i",
        "var_omega_i",
        "var_x_i",
        "var_y_i"
      ],
      "assumptions_refs": [
        "a3",
        "a4"
      ],
      "sub_question_binding": "Q1"
    },
    {
      "mechanism_id": "mech_collision",
      "name": "板凳矩形碰撞检测",
      "description": "把每节板凳视为长 L1 或 L、宽 w 的矩形，检测任意两节非相邻板凳矩形是否相交；相邻节通过把手连接必然接触，不参与碰撞判定。采用矩形外包络是几何保守且可计算的折中。",
      "type": "geometry",
      "governing_principle": "segment/rectangle intersection test",
      "variables_refs": [
