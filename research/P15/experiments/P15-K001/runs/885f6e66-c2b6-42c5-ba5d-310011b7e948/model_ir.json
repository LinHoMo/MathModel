  "equations": [
    {
      "equation_id": "eq_spiral",
      "latex": "r_i = k\\,theta_i",
      "type": "geometry",
      "variables_refs": [
        "var_r_i",
        "var_theta_i"
      ],
      "parameters_refs": [
        "par_k"
      ],
      "mechanism_ref": "mech_spiral",
      "derivation_trace": "等距螺线定义：极角每增加 2pi 半径增加螺距 p=2pi*k",
      "sub_question_binding": "Q1"
    },
    {
      "equation_id": "eq_arclen",
      "latex": "\\mathrm{d}s = \\sqrt{r^2 + k^2}\\,\\mathrm{d}theta",
      "type": "geometry",
      "variables_refs": [
        "var_s_i",
        "var_r_i",
        "var_theta_i"
      ],
      "parameters_refs": [
        "par_k"
      ],
      "mechanism_ref": "mech_spiral",
      "derivation_trace": "螺线弧长微分：dr/dtheta=k 代入 ds^2=dr^2+r^2 dtheta^2",
      "sub_question_binding": "Q1"
    },
    {
      "equation_id": "eq_head_drive",
      "latex": "\\frac{\\mathrm{d}theta_1}{\\mathrm{d}t} = \\frac{v_h}{\\sqrt{r_1^2 + k^2}}",
      "type": "kinematics",
      "variables_refs": [
        "var_theta_i",
        "var_r_i",
        "var_v_i"
      ],
      "parameters_refs": [
        "par_v_h",
        "par_k"
      ],
      "mechanism_ref": "mech_velocity",
      "derivation_trace": "龙头弧长速率恒为 v_h：ds_1/dt=v_h 与 eq_arclen 联立解出极角速率",
      "sub_question_binding": "Q1"
    },
    {
      "equation_id": "eq_pos",
      "latex": "x_i = r_i\\costheta_i,\\quad y_i = r_i\\sintheta_i",
      "type": "geometry",
      "variables_refs": [
        "var_x_i",
        "var_y_i",
        "var_r_i",
        "var_theta_i"
      ],
      "parameters_refs": [],
      "mechanism_ref": "mech_spiral",
      "derivation_trace": "极坐标到直角坐标的坐标变换",
      "sub_question_binding": "Q1"
    },
    {
      "equation_id": "eq_chord",
      "latex": "\\sqrt{(x_{i+1}-x_i)^2 + (y_{i+1}-y_i)^2} = d_i",
      "type": "mechanics",
      "variables_refs": [
        "var_x_i",
        "var_y_i"
      ],
      "parameters_refs": [
        "par_d1",
        "par_d"
      ],
      "mechanism_ref": "mech_chord",
      "derivation_trace": "刚性链孔距恒定：相邻把手欧氏距离等于该节板凳孔距",
      "sub_question_binding": "Q1"
    },
    {
      "equation_id": "eq_vel_coupling",
      "latex": "(x_{i+1}-x_i)(\\dot{x}_{i+1}-\\dot{x}_i) + (y_{i+1}-y_i)(\\dot{y}_{i+1}-\\dot{y}_i) = 0",
      "type": "kinematics",
      "variables_refs": [
        "var_x_i",
        "var_y_i",
        "var_v_i"
      ],
      "parameters_refs": [],
      "mechanism_ref": "mech_velocity",
      "derivation_trace": "对 eq_chord 两边平方后关于时间求导，消去 2 倍因子",
      "sub_question_binding": "Q1"
    },
    {
      "equation_id": "eq_speed",
      "latex": "v_i = \\sqrt{\\dot{x}_i^2 + \\dot{y}_i^2}",
      "type": "kinematics",
      "variables_refs": [
        "var_v_i",
        "var_x_i",
        "var_y_i"
      ],
      "parameters_refs": [],
      "mechanism_ref": "mech_velocity",
      "derivation_trace": "把手速率定义为速度矢量大小",
      "sub_question_binding": "Q1"
    },
    {
      "equation_id": "eq_init",
      "latex": "theta_1(0) = theta_0,\\quad \\dot{theta}_1(0) = \\frac{v_h}{\\sqrt{r_0^2 + k^2}}",
