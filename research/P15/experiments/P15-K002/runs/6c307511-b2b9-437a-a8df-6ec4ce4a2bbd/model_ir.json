      "sub_question_binding": "Q1"
    },
    {
      "equation_id": "E2",
      "latex": "V_t(l,w,f,m) = \\max_{a,b} \\big[ V_{t+1}(l', w', f', m') \\big],\\quad m' = m - p_{loc}(b) + \\mathbb 1_{\\text{挖矿}} r_{mine} + \\theta_r p_0(\\text{终点退回})",
      "type": "递推",
      "variables_refs": [
        "V2",
        "V3",
        "V4",
        "V5",
        "V7",
        "V8",
        "V10"
