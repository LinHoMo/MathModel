  "assumptions": [
    {
      "assumption_id": "A1",
      "text": "水与食物以箱为整数单位，购买、消耗、退回均按整箱计。",
      "type": "simplification",
      "rationale": "题面规定最小计量单位为箱，离散化使状态空间可枚举。"
    },
    {
      "assumption_id": "A2",
      "text": "资源消耗发生在当天行动结束，购买发生在消耗之后（或按 Result.xlsx 口径在购买后统计）。",
      "type": "calibration",
      "rationale": "题面注 2 明确剩余资金口径，递推按‘先行动消耗、后购买’的时序对齐。"
    },
    {
      "assumption_id": "A3",
      "text": "当天天气在决策时已知（Q1 全程已知；Q2 仅当天已知，次日天气随机）。",
      "type": "mechanism",
      "rationale": "题面对 Q1/Q2 的信息结构给出明确区分，作为两个模型的输入差异。"
    },
    {
      "assumption_id": "A4",
      "text": "玩家理性且追求终局剩余资金最大化，风险中性。",
      "type": "mechanism",
      "rationale": "题面目标为保留尽可能多的资金，期望最大化是标准口径。"
    },
    {
      "assumption_id": "A5",
      "text": "多玩家情形中玩家位置与行动同步可见（Q3-2），拥挤代价只发生在同日同地点同行为。",
      "type": "mechanism_assumption",
      "rationale": "题面给出‘任意 k 名玩家同行为’的规则，同步可见使拥挤代价可预测。"
    }
  ],
