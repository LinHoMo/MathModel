      "equation_id": "E1",
      "latex": "\\begin{cases} w_{t+1} = w_t - \\delta_t \\eta^w + b^w_t \\\\ f_{t+1} = f_t - \\delta_t \\eta^f + b^f_t \\end{cases},\\quad \\delta_t = \\begin{cases}1&\\text{停留}\\\\2&\\text{行走}\\\\3&\\text{挖矿}\\end{cases}",
