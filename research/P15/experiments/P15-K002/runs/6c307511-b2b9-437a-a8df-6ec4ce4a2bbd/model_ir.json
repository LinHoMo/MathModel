  "mechanisms": [
    {
      "mechanism_id": "M1",
      "description": "阶段递推机制：每天的状态转移由行动决定，资源消耗系数（停留1×/行走2×/挖矿3×）与天气强制规则构成转移核，价值函数从终点倒推。",
      "related_equations": [
        "E1",
        "E2"
      ],
      "sub_question_binding": "Q1"
    },
    {
      "mechanism_id": "M2",
      "description": "资源-资金套利机制：起点低价买入、村庄高价补给的价差决定携带策略，挖矿是资金-资源的转换通道，价值函数自动权衡。",
      "related_equations": [
        "E2"
      ],
      "sub_question_binding": "Q1"
    },
    {
      "mechanism_id": "M3",
      "description": "滚动决策机制：Q2 中次日天气未知，以天气转移概率对未来做期望折现，当天行动由当前天气与资源状态决定。",
      "related_equations": [
        "E3"
      ],
      "sub_question_binding": "Q2"
    },
    {
      "mechanism_id": "M4",
      "description": "拥挤惩罚机制：多玩家同行/同挖矿/同购使消耗倍增、收益均分、价格抬升，个体决策需预测他人路径，形成耦合最优控制。",
      "related_equations": [
        "E4"
      ],
      "sub_question_binding": "Q3"
    }
  ],
  "equations": [
