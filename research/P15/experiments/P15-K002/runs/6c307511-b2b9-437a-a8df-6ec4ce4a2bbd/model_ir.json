{
  "ir_version": "1.0",
  "model_id": "M-6c307511",
  "model_family": {
    "primary": "dynamic_programming",
    "secondary": [
      "markov_decision_process",
      "optimization"
    ],
    "description": "以天为阶段、以位置/资源/资金为状态的动态规划求解确定性天气下的最优路径，在线天气情形用马尔可夫决策过程滚动决策，多玩家情形引入同步博弈。",
    "candidates": [
      {
        "family": "dynamic_programming",
        "rationale": "题面规则天然按天分期，状态（位置、水、食物、资金）满足无后效性，确定天气下价值函数递推可直接给出最优策略，故选为主模型族。"
      },
      {
        "family": "markov_decision_process",
        "rationale": "Q2 只知当天天气、按天滚动决策，本质是带随机天气转移的 MDP；作为 Q2 的模型化扩展。"
      },
      {
        "family": "optimization",
        "rationale": "购买量、挖矿时长可写成数学规划，但离散状态递推已覆盖，规划作为校验手段。"
      },
      {
        "family": "game_theory",
        "rationale": "Q3 多玩家同路线消耗倍增产生策略互动，需博弈视角；但单玩家核仍由 DP 提供，故为扩展层。"
      },
      {
        "family": "graph_algorithm",
        "rationale": "地图移动是最短路问题，但资源约束远超图结构承载，故排除为主模型。"
      }
    ]
  },
  "problem_binding": {
