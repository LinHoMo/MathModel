      "derivation_trace": "标准动态规划价值递推；终点层 V_T = m_T + 半价退回收益；失败状态赋 -∞。",
      "sub_question_binding": "Q1"
    },
    {
      "equation_id": "E3",
      "latex": "V_t(s_t,\\cdot) = \\max_a \\mathbb E_{s_{t+1}}[V_{t+1}(s_{t+1},\\cdot)] = \\max_a \\sum_{s'} Pr(s_{t+1}=s'|s_t) V_{t+1}(s',\\cdot)",
      "type": "递推",
      "variables_refs": [
