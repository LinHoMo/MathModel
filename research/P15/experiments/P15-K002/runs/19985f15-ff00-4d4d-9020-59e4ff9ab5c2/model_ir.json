  "assumptions": [
    {
      "assumption_id": "A1",
      "text": "板凳视为刚体，相邻板凳通过把手铰接，铰接点即前后把手的中心，相邻把手中心距离恒等于所在板凳的板长。",
      "type": "mechanism",
      "rationale": "把手连接为刚性铰，板长固定，该约束决定整队位形；忽略板凳厚度与弹性变形。"
    },
    {
      "assumption_id": "A2",
      "text": "盘入时各把手中心严格位于螺线上，螺线为等距阿基米德螺线，极径与极角满足线性关系。",
      "type": "mechanism_assumption",
      "rationale": "题面明示各把手中心均位于螺线上；等距螺线即 r = a + bθ，b = p/(2π)。"
    },
    {
      "assumption_id": "A3",
      "text": "龙头前把手沿螺线以恒定速率 1 m/s 行进，弧长 s(t) = v0·t。",
      "type": "calibration",
      "rationale": "题面给定龙头前把手速度恒为 1 m/s，作为运动学的时间驱动。"
    },
    {
      "assumption_id": "A4",
      "text": "板凳之间不发生碰撞的判据为：非相邻板凳（含相邻螺线圈上的板凳）任意两点间最小距离不小于板宽 30 cm。",
      "type": "simplification",
      "rationale": "板宽是几何干涉的自然尺度；以相邻圈径向间隙是否小于板宽作为碰撞判据，忽略孔与把手的局部间隙。"
    },
    {
      "assumption_id": "A5",
      "text": "调头过程中龙头速度恒为 1 m/s，调头路径由圆弧与螺线相切拼接，运动仍由弧长匀速驱动。",
      "type": "simplification",
      "rationale": "题面给定调头区间龙头速度 1 m/s，路径拼接处切向连续即可保证速度连续。"
    }
  ],
