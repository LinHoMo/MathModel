  "equations": [
    {
      "equation_id": "E1",
      "latex": "r(\\theta) = a + \\frac{p}{2\\pi}\\theta",
      "type": "代数",
      "variables_refs": [
        "V2",
        "V1",
        "V9"
      ],
      "derivation_trace": "阿基米德螺线定义，螺距 p 对应极角每增 2π 极径增 p；初始 a 由第16圈起点确定",
      "sub_question_binding": [
        "Q1",
        "Q2",
        "Q3"
      ]
    },
    {
      "equation_id": "E2",
      "latex": "s(t) = \\int_{\\theta_0}^{\\theta(t)} \\sqrt{r^2 + (r')^2} \\, d\\theta = v_0 t",
      "type": "微分",
      "variables_refs": [
        "V3",
        "V1",
        "V2"
      ],
      "derivation_trace": "弧长公式与匀速驱动；初值 s(0)=0, θ(0)=θ_A（第16圈）",
      "sub_question_binding": [
        "Q1"
      ]
    },
    {
      "equation_id": "E3",
      "latex": "\\|P_{i+1}(\\theta_{i+1}) - P_i(\\theta_i)\\| = L_i, \\quad P_i = (r(\\theta_i)\\cos\\theta_i,\\ r(\\theta_i)\\sin\\theta_i)",
      "type": "代数",
      "variables_refs": [
        "V4",
        "V6",
        "V1",
        "V2"
      ],
      "derivation_trace": "弦长=板长约束逐节求解 θ_{i+1}（取螺线前进方向的近端解）；速度由相邻时刻位置差分得",
      "sub_question_binding": [
        "Q1",
        "Q2"
      ]
    },
    {
      "equation_id": "E4",
      "latex": "t_{end} = \\inf\\{ t : d_{min}(t) < w \\}",
      "type": "逻辑",
      "variables_refs": [
        "V8",
        "V7"
      ],
      "derivation_trace": "碰撞判据：非相邻把手（尤其相邻圈）最小距离首次小于板宽；对相邻圈近似 d_min ≈ p − 板宽投影",
      "sub_question_binding": "Q2"
    },
    {
      "equation_id": "E5",
      "latex": "s_T = R_1 \\alpha_1 + R_2 \\alpha_2, \\quad R_1 = 2 R_2",
      "type": "代数",
      "variables_refs": [
        "V10"
      ],
      "derivation_trace": "S形调头由两段圆弧构成，弧长=半径×转角；优化两半径与转角在相切约束下最小化 s_T",
      "sub_question_binding": "Q4"
    },
    {
      "equation_id": "E6",
      "latex": "\\kappa_i(t) = \\frac{\\|\\vec{v}_i(t)\\|}{v_0}, \\quad v_{head}^{max} = \\frac{2}{\\max_{i,t}\\kappa_i(t)}",
      "type": "代数",
      "variables_refs": [
        "V11",
        "V5"
      ],
      "derivation_trace": "速度放大系数定义；龙头速度上限为使最速把手恰达 2 m/s",
      "sub_question_binding": "Q5"
    }
  ],
