        "Q2",
        "Q3"
      ]
    },
    {
      "equation_id": "E2",
      "latex": "V_{k}(s) = \\max_{a\\in\\mathcal{A}(s)} \\sum_{s'} P(s'|s,a)\\left[ r(s,a) + V_{k+1}(s') \\right]",
      "type": "递推",
      "variables_refs": [
        "V5",
        "V6",
        "V7",
        "V8"
      ],
      "derivation_trace": "贝尔曼最优方程，后向迭代至截止日，边界 V_{T+1}=终点资金。",
      "sub_question_binding": [
        "Q1",
        "Q2"
      ]
    },
    {
      "equation_id": "E3",
      "latex": "Q(s,a) = \\sum_{s'} P(s'|s,a)[r(s,a)+V(s')],\\quad \\pi(s)=\\arg\\max_a Q(s,a)",
      "type": "递推",
      "variables_refs": [
        "V4",
        "V6",
        "V7"
      ],
      "derivation_trace": "行动价值定义与策略提取，天气未知时 P 由转移矩阵给出。",
      "sub_question_binding": "Q2"
    },
    {
      "equation_id": "E4",
      "latex": "q^{(k)}_{move}=2kq_0,\\quad g^{(k)}=g_0/k,\\quad p^{(k)}_{village}=4p_0",
