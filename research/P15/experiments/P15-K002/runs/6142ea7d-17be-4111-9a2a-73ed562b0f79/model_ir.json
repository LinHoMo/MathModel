  "equations": [
    {
      "equation_id": "E1",
      "latex": "r(s,a) = g_0\\mathbb{1}[挖矿] - p_{buy} b + p_{refund}\\mathbb{1}[终点退回]，且 (w',f')=(w,f)-(q_w,q_f)(s,a)",
