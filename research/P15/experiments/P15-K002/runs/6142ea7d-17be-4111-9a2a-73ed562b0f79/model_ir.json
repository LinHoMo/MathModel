  "assumptions": [
    {
      "assumption_id": "A1",
      "text": "天气构成一阶马尔可夫链，转移概率由关卡统计给出，且所有区域天气一致。",
      "type": "mechanism_assumption",
      "rationale": "题面只说明天气逐日变化且全区一致，一阶马尔可夫是对该信息结构的最小完备刻画。"
    },
    {
      "assumption_id": "A2",
      "text": "玩家策略是状态（天数、位置、资源、资金、当天天气）到行动的确定性映射。",
      "type": "mechanism",
      "rationale": "确定性策略在期望最优意义下不劣于随机策略，且便于解释与执行。"
    },
    {
      "assumption_id": "A3",
      "text": "资源与资金在递推中按箱与元离散网格化，网格步长取附件精度。",
      "type": "simplification",
      "rationale": "离散化是价值迭代的实现需要，步长足够小时近似误差可忽略。"
    },
    {
      "assumption_id": "A4",
      "text": "玩家风险中性，目标为期望终点资金最大化；中途失败取大负值。",
      "type": "simplification",
      "rationale": "风险中性使目标为期望值，符合竞赛评分口径。"
    },
    {
      "assumption_id": "A5",
      "text": "多人时玩家同时行动、行动后信息公开，策略按对称性假设收敛到同一策略。",
      "type": "simplification",
      "rationale": "对称策略减少状态空间，适合求近似均衡。"
    },
    {
      "assumption_id": "A6",
      "text": "购买与退回按天初或天末时点结算，不影响当天的移动与消耗。",
      "type": "calibration",
      "rationale": "结算时点约定消除歧义，与附件结果口径一致。"
    }
  ],
