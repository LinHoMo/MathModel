  "model_family": {
    "primary": "markov_decision_process",
    "secondary": [
      "dynamic_programming",
      "game_theory"
    ],
    "description": "以马尔可夫决策过程为核心：天气为环境状态，玩家策略为状态到行动的映射，用价值迭代与策略迭代求解，多人情形扩展为交互式随机博弈。",
    "candidates": [
      {
        "family": "markov_decision_process",
        "rationale": "天气逐日揭示、未来天气随机，决策仅依赖当天状态，正是离散时间马尔可夫决策过程的标准设定，策略与价值函数可直接求解，故选为主模型族。"
      },
      {
        "family": "dynamic_programming",
        "rationale": "天气全知时确定性递推更简单，但无法统一处理天气未知与多人交互，列为辅助实现层。"
      },
      {
        "family": "game_theory",
        "rationale": "多人共享天气与资源交互，玩家间形成随机博弈，可用马尔可夫完美均衡表述，作为多人问题的扩展框架。"
      },
      {
        "family": "optimization",
        "rationale": "单期规划可写成优化问题，但多阶段随机性使场景树规模爆炸，仅作对照。"
      }
    ]
  },
  "problem_binding": {
    "problem_id": "2020_B",
