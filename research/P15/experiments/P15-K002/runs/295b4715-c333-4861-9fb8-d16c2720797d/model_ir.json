  "assumptions": [
    {
      "assumption_id": "A1",
      "text": "系统事件时间为确定性参数（无故障情形），事件调度按最早事件优先推进。",
      "type": "mechanism",
      "rationale": "题面给全参数；事件驱动仿真以事件队列驱动，是系统演化的精确模拟机制。"
    },
    {
      "assumption_id": "A2",
      "text": "RGV 为单服务台：同一时刻至多执行一个动作（移动/上下料/清洗），动作期间不可中断。",
      "type": "mechanism",
      "rationale": "物理事实，构成仿真中资源互斥的核心规则。"
    },
    {
      "assumption_id": "A3",
      "text": "两道工序的物料必须依次在异机完成第一、二道工序，两道之间允许等待且物料不占 RGV。",
      "type": "mechanism",
      "rationale": "题面工序约束；等待缓冲假设使模型聚焦 RGV 调度而非物料周转。"
    },
    {
      "assumption_id": "A4",
      "text": "故障：单台 CNC 加工分钟故障概率 1%，排除时间均匀分布于 10~20 分钟，故障报废未完成物料，排除后立即重新入列。",
      "type": "projection",
      "rationale": "题面给出概率与区间；均匀分布为最大熵选择，故障相互独立。"
    },
    {
      "assumption_id": "A5",
      "text": "班次 8 小时（28800 秒），产量按完成全部工序并清洗完毕的物料计数；仿真时钟到达班次终点即截断。",
      "type": "simplification",
      "rationale": "题面规定班次时长与统计口径；截断规则保证与结果表一致。"
    },
    {
      "assumption_id": "A6",
      "text": "CNC 初始空闲，物料上料后立即开始加工；忽略启动预热。",
      "type": "simplification",
      "rationale": "题面未给启动过程；对长班次产量影响可忽略。"
    }
  ],
