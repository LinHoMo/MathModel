  "mechanisms": [
    {
      "mechanism_id": "M1",
      "description": "供需定价机理：完成概率随定价上升、随距离上升而下降、随竞争稀释而下降，逻辑回归刻画该单调关系，未完成归因于“定价不足以覆盖距离成本与竞争稀释”。",
      "related_equations": [
        "E1",
        "E2"
      ],
      "sub_question_binding": "Q1"
    },
    {
      "mechanism_id": "M2",
      "description": "利润权衡机理：提价提高完成率但压缩单件利润，最优定价在完成率弹性与利润率之间平衡，由一阶条件给出。",
      "related_equations": [
        "E3",
        "E4"
      ],
      "sub_question_binding": "Q2"
    },
    {
      "mechanism_id": "M3",
      "description": "打包规模经济机理：位置集中任务打包后以组为单位定价，降低单位定价支出、提高单组完成概率，用聚类识别聚集区。",
      "related_equations": [
        "E5"
      ],
      "sub_question_binding": "Q3"
    },
    {
      "mechanism_id": "M4",
      "description": "外推评价机理：附件一估计的模型外推到附件三，用模拟完成率与利润评价方案实施效果。",
      "related_equations": [
        "E6"
      ],
      "sub_question_binding": "Q4"
    }
  ],
