  "assumptions": [
    {
      "assumption_id": "A1",
      "text": "任务完成与否是二值响应，由任务定价、会员可达性（距离）、竞争程度（周边会员数与任务数）与会员属性共同决定。",
      "type": "mechanism",
      "rationale": "众包平台任务完成的供需逻辑：价格激励、地理可达、竞争稀释是三大机制，是统计模型的变量选择依据。"
    },
    {
      "assumption_id": "A2",
      "text": "会员选择任务遵循理性行为：在可及范围内优先选择性价比高（单位距离收益大）且未被抢完的任务；会员信誉决定选择优先级与配额。",
      "type": "mechanism_assumption",
      "rationale": "题面给出信誉-预订时间-配额机制，将其作为竞争与完成概率的调节变量。"
    },
    {
      "assumption_id": "A3",
      "text": "完成概率模型采用逻辑回归形式 logit(P)=βX，参数由附件一最大似然估计。",
      "type": "projection",
      "rationale": "逻辑回归在二值响应上可解释、可检验且外推稳定；非线性交互用特征工程吸收。"
    },
    {
      "assumption_id": "A4",
      "text": "附件三新项目的任务位置分布与附件一类似，可用附件一估计的参数外推定价。",
      "type": "projection",
      "rationale": "同一平台同一业务类型的任务属性相近；外推风险在 Q4 用模拟完成率评价。"
    },
    {
      "assumption_id": "A5",
      "text": "平台利润 = 完成任务的预算收益 − 定价支出；任务预算按类型固定。",
      "type": "simplification",
      "rationale": "题面未给平台收益结构，预算-支出差是自然的目标函数；灵敏度中检验预算取值影响。"
    }
  ],
