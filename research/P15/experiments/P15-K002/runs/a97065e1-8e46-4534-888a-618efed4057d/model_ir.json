  "assumptions": [
    {
      "assumption_id": "A1",
      "text": "道路网络建模为无向加权图，边权为路段行驶时间，节点为路口或平台位置。",
      "type": "mechanism",
      "rationale": "题面附图给出节点与道路，权重由路段长度除以车速得到，是图建模的标准做法。"
    },
    {
      "assumption_id": "A2",
      "text": "警车沿最短时间路径行驶，任意两节点间的出行时间由最短路算法精确计算。",
      "type": "simplification",
      "rationale": "忽略红绿灯与拥堵的随机延迟，给出可达性的基准估计。"
    },
    {
      "assumption_id": "A3",
      "text": "覆盖判定以 3 分钟为半径，节点落入某平台时间圆盘内即视为被覆盖。",
      "type": "projection",
      "rationale": "题面以 3 分钟为出警时限，时间圆盘覆盖是图覆盖的自然推广。"
    },
    {
      "assumption_id": "A4",
      "text": "嫌疑犯逃跑速度与警车相同且沿最短路径，围堵要求警车到拦截节点的最短时间不大于嫌疑犯。",
      "type": "mechanism_assumption",
      "rationale": "等速假设是最小保守情形，使围堵圈闭合条件可解析表达。"
    },
    {
      "assumption_id": "A5",
      "text": "新增平台候选位置限于现有路口节点，平台数在 2 到 5 之间。",
      "type": "simplification",
      "rationale": "选址空间受实施条件约束，限定候选节点保证方案可落地。"
    },
    {
      "assumption_id": "A6",
      "text": "各节点案发率用节点度数近似加权，度数高的路口案发概率更高。",
      "type": "calibration",
      "rationale": "缺少真实案发数据时，以网络拓扑度数作为案发率的代理变量。"
    }
  ],
