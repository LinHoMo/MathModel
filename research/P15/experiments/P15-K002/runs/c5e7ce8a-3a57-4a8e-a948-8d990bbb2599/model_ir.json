{
  "ir_version": "1.0",
  "model_id": "M-c5e7ce8a",
  "model_family": {
    "primary": "pde",
    "secondary": [
      "finite_difference",
      "heat_transfer"
    ],
    "description": "以四层介质（三层织物 + 空气空隙层）的一维非稳态热传导偏微分方程组描述温度场，配以外表面对流、内表面恒温边界，先正演温度分布，再反演校准参数。",
    "candidates": [
      {
        "family": "pde",
        "rationale": "选择：热传导的物理机理由 Fourier 定律决定，温度随空间与时间连续演化，一维热传导方程是该问题的标准控制方程，能同时支撑温度分布正演与厚度反演。"
      },
      {
        "family": "finite_difference",
        "rationale": "选择为数值方法而非独立模型族：作为 PDE 的离散化方案，Crank-Nicolson 隐式格式无条件稳定，适合长时间（90 分钟）积分；故放入 secondary。"
      },
      {
        "family": "lumped_parameter",
        "rationale": "排除：集总参数模型假设物体内部温度均匀，仅在 Biot 数远小于 1 时成立；织物厚度毫米级但导热系数低、热流强，内部梯度显著，集总模型会低估皮肤侧温升。"
      },
      {
        "family": "regression",
        "rationale": "排除：纯数据回归（如对附件 2 拟合经验曲线）无法外推不同环境温度与厚度组合，缺乏物理可解释性，不能支撑 Q2/Q3 的厚度优化。"
      }
    ]
  },
  "problem_binding": {
    "problem_id": "2018_A",
    "sub_question_id": "Q1,Q2,Q3",
    "problem_sha256": "6b4062dcd020bd6b57ea6ad3a834019c93a3f36f35fc00757b4586816936c569"
  },
  "assumptions": [
    {
      "assumption_id": "A1",
      "text": "热流沿服装厚度方向一维传播，忽略侧向（面内）热流与边缘效应。",
      "type": "simplification",
      "rationale": "服装面内尺寸远大于厚度，温度梯度主要沿厚度方向；边缘效应仅影响边界小邻域，对皮肤中心测温影响可忽略。"
    },
    {
      "assumption_id": "A2",
      "text": "各层材料物性（密度、比热、导热系数）为常数，不随温度变化；层间理想接触，界面温度与热流连续。",
      "type": "mechanism",
      "rationale": "工作温度范围 37–80°C 内物性变化小；理想接触假设使界面条件封闭，是热传导模型的机制核心。"
    },
    {
      "assumption_id": "A3",
      "text": "I 层外表面与高温环境的换热用对流边界条件描述，对流换热系数 h 为待校准常数；假人皮肤外表面恒温 37°C。",
      "type": "calibration",
      "rationale": "题面给定假人体温恒为 37°C；环境换热系数无法直接测得，需以附件 2 的皮肤外侧温度曲线反演校准。"
    },
    {
      "assumption_id": "A4",
      "text": "IV 层空气空隙以等效导热系数 k_IV 处理，忽略空隙内自然对流与辐射的显式建模。",
      "type": "simplification",
      "rationale": "空气层薄（毫米级），等效导热系数吸收了对流与辐射的综合效应；该简化由 Q1 校准吸收，误差体现在反演残差中。"
    },
    {
      "assumption_id": "A5",
      "text": "初始时刻整个服装与假人处于 37°C 均匀温度场（实验开始前热平衡）。",
      "type": "projection",
      "rationale": "题面未给出初始温度分布，恒温 37°C 是最自然的设定；若实际初始场略高，首段温度曲线会偏低估，但稳态后影响衰减。"
    },
    {
      "assumption_id": "A6",
      "text": "工作时间内环境温度恒定（75/65/80°C），皮肤温度监测以分钟为观测粒度。",
      "type": "simplification",
      "rationale": "题面给定恒定环境温度；分钟粒度与附件 2 测量频率一致，且满足“超过 44°C 的时间不超过 5 分钟”的判定粒度。"
    }
  ],
