  "model_family": {
    "primary": "clustering",
    "secondary": [
      "pca"
    ],
    "description": "以聚类分析为主线：先按类型约束聚类刻画亚类结构，再用簇原型与簇成员关系实现风化复原与未知样品归属，聚类结果作为关联分析的分组依据。",
    "candidates": [
      {
        "family": "clustering",
        "rationale": "亚类划分本质是数据驱动分组，聚类可直接产出组结构与原型，且对成分数据的尺度差异可用标准化处理。"
      },
      {
        "family": "supervised_learning",
        "rationale": "监督学习可精确拟合标签，但亚类标签未知、需要探索性分组时，无监督聚类更契合题面'选择合适成分进行亚类划分'的开放性。"
      },
      {
        "family": "pca",
        "rationale": "主成分作为聚类前的降维与可视化工具，不直接产出分组，作为辅助组件。"
      }
    ]
  },
  "problem_binding": {
    "problem_id": "2022_C",
    "sub_question_id": "Q1,Q2,Q3,Q4",
    "problem_sha256": "ec5e098f9dbe858e50280a7366faeb6cc0d2e7db1fd21e8fc7b3de7d85ad1709"
  },
  "assumptions": [
    {
      "assumption_id": "A1",
      "text": "有效数据按累加和85%至105%判定，聚类在有效样本与已检测成分上进行。",
      "type": "calibration",
      "rationale": "统一样本口径，避免异常样品形成伪簇。"
    },
    {
      "assumption_id": "A2",
      "text": "同一亚类内部的样品共享相近的配方与风化状态，簇内成分同质。",
      "type": "mechanism_assumption",
      "rationale": "亚类对应配方体系的分支，簇内同质是聚类有效性的前提，可由簇内方差检验。"
    },
    {
      "assumption_id": "A3",
      "text": "风化造成成分偏移但保留类别/亚类结构，即风化样品与同类未风化样品仍聚在一起。",
      "type": "mechanism",
      "rationale": "风化偏移幅度小于类间差异，簇结构在风化前后保持稳定，该假设支撑用簇原型做复原。"
    },
    {
      "assumption_id": "A4",
      "text": "簇数由内部指标（轮廓系数、Gap统计量）与可解释性共同决定，每簇最小样本数限制避免过碎划分。",
      "type": "simplification",
      "rationale": "数据驱动选簇数结合专家校验，避免纯指标导向的过拟合。"
    },
    {
      "assumption_id": "A5",
      "text": "缺失成分在距离计算时按成对删除处理，聚类原型由非缺失值均值构成。",
      "type": "simplification",
      "rationale": "成对删除保留可用信息，原型均值对缺失稳健。"
    }
  ],
