        "Q4"
      ]
    },
    {
      "equation_id": "E4",
      "latex": "\\frac{\\partial \\pi_j}{\\partial p_j} = \\theta_p \\pi_j(1-\\pi_j) \\\\Rightarrow 最优价格满足边际均衡",
      "type": "代数",
      "variables_refs": [
        "V1",
        "V2"
      ],
      "derivation_trace": "一阶最优性条件",
      "sub_question_binding": "Q2"
    },
    {
      "equation_id": "E5",
      "latex": "g_j = \\arg\\min_{g} \\|(x_j,y_j)-c_g\\|^2, \\; \\text{s.t. 半径} \\le r_c",
      "type": "逻辑",
      "variables_refs": [
        "V4",
        "V6"
      ],
      "derivation_trace": "位置聚类分组",
      "sub_question_binding": "Q3"
    },
    {
      "equation_id": "E6",
      "latex": "\\pi_g = \\sigma(\\theta_0+\\theta_p \\eta_g p_g + \\theta_\\rho \\rho_g^{bundle})",
