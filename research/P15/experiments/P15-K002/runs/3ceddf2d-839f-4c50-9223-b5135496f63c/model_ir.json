  },
  "assumptions": [
    {
      "assumption_id": "A1",
      "text": "完成概率为价格、距离与会员密度的光滑单调函数，以逻辑形式参数化。",
      "type": "mechanism",
      "rationale": "行为机理：价格越高越有人接、越远越少人接、会员越密越易完成；逻辑函数保证概率在[0,1]。"
    },
    {
      "assumption_id": "A2",
      "text": "平台对全部任务的总预算固定，定价优化在预算约束下进行。",
      "type": "projection",
      "rationale": "题面未给预算，按历史总酬金近似；预算约束是优化的核心可行性边界。"
    },
    {
      "assumption_id": "A3",
      "text": "会员按预订限额比例分配任务容量，任务周边可用会员数按信誉加权密度近似。",
      "type": "simplification",
      "rationale": "附件二配额机制复杂，用密度代理；误差在会员稀疏区被放大，需灵敏度检验。"
    },
    {
      "assumption_id": "A4",
      "text": "打包组以位置聚类划分，组内任务共享会员流量且价格乘以折扣。",
      "type": "mechanism_assumption",
      "rationale": "打包的机理是聚合需求与规模折扣；折扣系数为决策变量。"
    },
    {
      "assumption_id": "A5",
      "text": "附件三新项目与历史项目市场环境相同，模型可迁移。",
      "type": "calibration",
      "rationale": "迁移假设使Q4可执行，并通过敏感性分析说明不确定性。"
    },
    {
      "assumption_id": "A6",
      "text": "完成率目标以期望完成数最大化等价表述，允许小数期望。",
      "type": "simplification",
      "rationale": "期望线性化便于连续优化，任务量大时误差可忽略。"
    }
  ],
