  "equations": [
    {
      "equation_id": "E1",
      "latex": "\\pi_j = \\sigma(\\theta_0 + \\theta_p p_j + \\theta_d d_j + \\theta_\\rho \\rho_j)",
      "type": "代数",
      "variables_refs": [
        "V1",
