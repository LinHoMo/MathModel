        "Q4"
      ]
    },
    {
      "equation_id": "E2",
      "latex": "\\min_\\theta \\sum_j (y_j - \\pi_j)^2 + \\lambda \\|\\theta\\|^2",
      "type": "逻辑",
      "variables_refs": [
        "V2",
        "V3"
      ],
      "derivation_trace": "正则化最小二乘反演定价规律",
      "sub_question_binding": "Q1"
    },
    {
      "equation_id": "E3",
      "latex": "\\max_p \\sum_j \\sigma(\\theta_0+\\theta_p p_j+\\theta_d d_j+\\theta_\\rho \\rho_j)",
      "type": "逻辑",
      "variables_refs": [
        "V1",
        "V2"
      ],
      "derivation_trace": "预算约束完成率最大化",
      "sub_question_binding": [
