  "assumptions": [
    {
      "assumption_id": "A1",
      "text": "有效数据为累加和85%至105%的样品，树模型在该子集上生长。",
      "type": "calibration",
      "rationale": "统一训练口径，避免噪声样品诱导伪分裂。"
    },
    {
      "assumption_id": "A2",
      "text": "类别与亚类边界可被有限个成分阈值近似，即边界是轴对齐的分段常值结构。",
      "type": "simplification",
      "rationale": "树模型的轴对齐分裂与成分阈值的解释性天然匹配；若边界倾斜可用少量树集成补偿。"
    },
    {
      "assumption_id": "A3",
      "text": "风化偏移在同一叶节点（同类型同亚类）内近似一致，可用叶内回归常数实现复原。",
      "type": "mechanism_assumption",
      "rationale": "叶节点聚集同质样品，叶内偏移一致性高于全局，复原精度随叶纯度提升。"
    },
    {
      "assumption_id": "A4",
      "text": "树的分裂变量重要性反映成分对类别区分的贡献，即成分关联结构的直接体现。",
      "type": "mechanism",
      "rationale": "基尼/信息增益按贡献分配重要性，重要性排序即区分与关联的关键成分排序。"
    },
    {
      "assumption_id": "A5",
      "text": "为防止过拟合，树深度与叶最小样本数由交叉验证确定，重要分裂需满足最小增益阈值。",
      "type": "simplification",
      "rationale": "小样本高维数据易过拟合，剪枝与增益阈值是必要约束。"
    }
  ],
