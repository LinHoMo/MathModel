{
  "limit_tests": [
    {
      "test_id": "LT1",
      "description": "当树深度趋近0（单根节点）时，模型退化为多数类分类器与全局均值复原，验证复杂度下限行为",
      "parameter": "树深度d",
      "limit": "d -> 0",
      "expected_behavior": "判别退化为先验多数类，复原退化为全局均值"
    },
    {
      "test_id": "LT2",
      "description": "当叶最小样本数趋近1时树完全生长，验证过拟合边界下训练误差趋于0而验证误差上升",
      "parameter": "叶最小样本数n_leaf",
      "limit": "n_leaf -> 1",
      "expected_behavior": "训练误差下降，验证误差先降后升"
    },
    {
      "test_id": "LT3",
      "description": "当累加和取边界85与105时样品判定有效，边界外判定无效",
      "parameter": "累加和S",
      "limit": "S=85, S=105",
      "expected_behavior": "边界处判定连续"
    }
  ],
  "multi_seed": {
    "n_runs": 5,
    "seeds": [
      42,
      123,
      456,
      789,
      1024
    ],
    "aggregation": "mean_std",
    "description": "Bootstrap重采样重长树，报告规则一致率与错分率的均值标准差"
  },
  "sensitivity": [
    {
      "param_id": "P2",
      "range": "深度2-6",
      "method": "one_at_a_time",
      "target": "O3"
    },
    {
      "param_id": "P3",
      "range": "叶样本1-5",
      "method": "one_at_a_time",
      "target": "O2"
    },
    {
      "param_id": "P6",
      "range": "±50%",
      "method": "one_at_a_time",
      "target": "O4"
    }
  ],
  "ambiguity_handling": [
    {
      "source": "亚类划分的化学依据",
      "interpretations": [
        "按判别树叶直接划分",
        "按主导成分阈值划分",
        "按聚类划分后转规则"
      ],
      "adopted": "按判别树叶直接划分，叶路径即成分阈值规则",
      "justification": "树规则直接满足'给出具体划分方法及划分结果'，且阈值可读可复现"
    },
    {
      "source": "风化复原的训练目标",
      "interpretations": [
        "未风化点作目标",
        "同类均值作目标",
        "无目标仅描述"
      ],
      "adopted": "未风化点作回归目标，叶内均值预测",
      "justification": "未风化点最接近配方真值，叶内聚集同质样品使均值稳健"
    },
    {
      "source": "缺失成分处理",
      "interpretations": [
        "置零",
        "均值填充",
        "作为类别特征"
      ],
      "adopted": "以缺失标志作为附加特征参与分裂",
      "justification": "低于检出限本身携带判别信息，树可自动利用该信息"
    }
  ],
