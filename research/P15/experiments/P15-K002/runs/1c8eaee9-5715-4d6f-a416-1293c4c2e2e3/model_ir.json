  "assumptions": [
    {
      "assumption_id": "A1",
      "text": "乘客到达乘车区的过程近似为泊松过程，到达率在小时段内恒定。",
      "type": "mechanism_assumption",
      "rationale": "航班到达的聚集效应使乘客到达具有时段平稳性，泊松假设使排队模型可解析，偏差主要体现在高峰转换期。"
    },
    {
      "assumption_id": "A2",
      "text": "乘车区服务时间服从指数分布，服务率与上车点数量成正比。",
      "type": "simplification",
      "rationale": "指数服务时间与泊松到达构成 M/M/c 系统，是求解队长与等待时间的标准框架；实际服务时间变异系数接近1。"
    },
    {
      "assumption_id": "A3",
      "text": "蓄车池车辆到达率由放空返回与送客后回流两部分组成，短期内保持稳定。",
      "type": "projection",
      "rationale": "车辆回流受航班波次驱动，小时级均值稳定，可支持稳态排队分析。"
    },
    {
      "assumption_id": "A4",
      "text": "司机按期望净收益最大化选择行动，收益由载客里程与时间成本构成。",
      "type": "mechanism",
      "rationale": "题面要求综合考虑收益，期望收益最大化是司机经验的理性化表达。"
    },
    {
      "assumption_id": "A5",
      "text": "短途界定采用起步里程阈值，优先权仅作用于蓄车池放行顺序。",
      "type": "calibration",
      "rationale": "以当地运价起步里程为阈值，便于管理执行，且只改变顺序不改变总量。"
    }
  ],
