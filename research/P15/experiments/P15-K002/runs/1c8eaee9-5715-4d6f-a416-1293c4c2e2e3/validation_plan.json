{
  "limit_tests": [
    {
      "test_id": "LT1",
      "description": "乘客到达率趋近于零时，乘车区应无排队、等待时间趋近于零",
      "parameter": "lambda",
      "limit": "0",
      "expected_behavior": "W_q -> 0, L_q -> 0, 效率趋于单台服务率"
    },
    {
      "test_id": "LT2",
      "description": "乘客到达率趋近服务能力 c*mu 时，排队系统进入饱和，等待时间应发散",
      "parameter": "rho",
      "limit": "1",
      "expected_behavior": "W_q -> +inf，效率趋于 0"
    },
    {
      "test_id": "LT3",
      "description": "空载里程趋近于零时，放空返回行动的机会成本消失，司机应偏向放空",
      "parameter": "d_0",
      "limit": "0",
      "expected_behavior": "pi_c 上升，行动阈值 T_w* 上移"
    },
    {
      "test_id": "LT4",
      "description": "短途比例趋近于零时，优先方案应退化为先来先服务",
      "parameter": "delta 比例",
      "limit": "0",
      "expected_behavior": "G 与无优先情形一致"
    }
  ],
  "multi_seed": {
    "n_runs": 5,
    "seeds": [
      42,
      123,
      456,
      789,
      1024
    ],
    "aggregation": "mean_std",
    "description": "排队仿真器与重排序算法以多组随机数初值重复运行，报告效率与收益离差的均值及标准差，标准差小于均值的10%视为稳定"
  },
  "sensitivity": [
