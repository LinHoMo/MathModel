  "equations": [
    {
      "equation_id": "E1",
      "latex": "t_{ij} = \\min_{\\text{path } i\\to j} \\frac{\\sum l_e}{v_p} \\;\\text{（Floyd-Warshall 全源）}",
      "type": "递推",
      "variables_refs": [
        "V3",
        "V2",
        "P1",
        "P6"
      ],
      "derivation_trace": "全源最短路径：Floyd-Warshall 递推 d_{ij}=min(d_{ij},d_{ik}+d_{kj})；边权为行驶时间。",
      "sub_question_binding": [
        "Q1",
        "Q2",
        "Q3",
        "Q4",
        "Q5"
      ]
    },
    {
      "equation_id": "E2",
      "latex": "x_{kj} = \\mathbb{1}[k = \\arg\\min_{k'} t_{k'j}], \\;\\sum_k x_{kj}=1",
      "type": "逻辑",
      "variables_refs": [
        "V5",
        "V3"
      ],
      "derivation_trace": "管辖分配：每个节点分配给最近平台（就近覆盖），时间超限节点标记为覆盖缺口。",
      "sub_question_binding": "Q1"
    },
    {
      "equation_id": "E3",
      "latex": "\\min_{y} \\; \\max_{k,l} y_{kl} t_{kl}, \\;\\text{s.t. } \\sum_k y_{kl}=1,\\; \\sum_l y_{kl}\\le 1",
      "type": "代数",
      "variables_refs": [
        "V6",
        "V3",
        "V7"
      ],
      "derivation_trace": "封锁调度的瓶颈最小化（min-max 指派）：13 要道全部封锁且平台一对一。",
      "sub_question_binding": "Q2"
    },
    {
      "equation_id": "E4",
      "latex": "\\min_{z} \\; \\max_j \\min_{k \\in P \\cup z} t_{kj}, \\quad 2\\le|z|\\le5",
      "type": "代数",
      "variables_refs": [
        "V8",
        "V3",
        "V7",
        "P5"
      ],
      "derivation_trace": "新增平台选址：最小化全局最大响应时间，候选集取未覆盖节点及高工作量区域。",
      "sub_question_binding": "Q3"
    },
    {
      "equation_id": "E5",
      "latex": "\\mathcal{R}(t) = \\{v: \\; t_{P,v} \\le t\\} \\;\\text{（嫌疑车可达域，}\\;t_{P,v}\\le v_s\\cdot t\\text{）}",
      "type": "递推",
      "variables_refs": [
        "V10",
        "V3",
        "P7",
        "P8"
      ],
      "derivation_trace": "案发点 P 出发的时变可达域：以嫌疑车速扩张的闭球截断于路网。",
      "sub_question_binding": "Q5"
    },
    {
      "equation_id": "E6",
      "latex": "\\text{封锁节点集 } S \\supseteq \\text{exit}(\\mathcal{R}(t)), \\;\\min_y \\max_{k\\in S} t_{k,\\text{exit}}",
      "type": "代数",
      "variables_refs": [
        "V6",
        "V10",
        "V3"
      ],
      "derivation_trace": "围堵：封锁可达域全部出口节点，指派平台使最晚封锁时刻最小。",
      "sub_question_binding": "Q5"
    }
