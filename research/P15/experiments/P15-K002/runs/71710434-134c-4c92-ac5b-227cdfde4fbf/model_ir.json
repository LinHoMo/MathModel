  "assumptions": [
    {
      "assumption_id": "A1",
      "text": "路网建模为无向带权图：节点为交叉路口，边为道路，边权 = 道路长度 / 警车速度（60 km/h）。",
      "type": "mechanism",
      "rationale": "题面给附图与数据表；警车时速 60km/h 固定，行驶时间由最短路径给出。"
    },
    {
      "assumption_id": "A2",
      "text": "警车以最短路径匀速行驶，不考虑红绿灯、拥堵与转向延迟；3 分钟覆盖判定以最短行驶时间 ≤3min 为准。",
      "type": "simplification",
      "rationale": "题面“尽量在 3 分钟内有交巡警到达”以行驶时间度量；忽略信号延误使模型聚焦拓扑可达性。"
    },
    {
      "assumption_id": "A3",
      "text": "一个平台的警力最多封锁一个路口；重大事件时全区 20 个平台全部投入。",
      "type": "mechanism",
      "rationale": "题面明确；封锁任务是一对一指派。"
    },
    {
      "assumption_id": "A4",
      "text": "Q5 嫌疑车辆以已知速度沿最短路径逃跑，警力从各平台同时出动，围堵要求在嫌疑车到达前封锁其可能经过的节点。",
      "type": "mechanism_assumption",
      "rationale": "题面给案发 3 分钟后报警；围堵方案需覆盖嫌疑车可达域的所有出口。"
    },
    {
      "assumption_id": "A5",
      "text": "工作量以平台管辖节点数/出警距离衡量；平台设置合理性以响应时间与工作量均衡度评估。",
      "type": "projection",
      "rationale": "题面提出“工作量不均衡和出警时间过长”，两者是合理性评估的代理指标。"
    }
  ],
