{
  "ir_version": "1.0",
  "model_id": "M-a2bc372f",
  "model_family": {
    "primary": "pde",
    "secondary": [
      "finite_difference",
      "numerical_optimization"
    ],
    "description": "以四层结构的一维非稳态热传导偏微分方程描述服装温度场，外边界对流换热、皮肤侧定温，离散后求解并作厚度反演优化。",
    "candidates": [
      {
        "family": "pde",
        "rationale": "热传导的物理本质是傅里叶定律与能量守恒，一维非稳态抛物型方程精确刻画层间温度演化；作为主结构。"
      },
      {
        "family": "finite_difference",
        "rationale": "解析解仅对均匀单层存在，多层界面需数值离散；隐式格式作为PDE的求解工具，不是独立模型族。"
      },
      {
        "family": "numerical_optimization",
        "rationale": "Q2/Q3的厚度寻优是在PDE仿真上的外层优化循环；作为求解策略而非物理机理。"
      },
      {
        "family": "inverse_problem",
        "rationale": "附件2的实测温度可用于反演材料参数，但题面要求正向计算与设计，反演仅作参数校核的辅助手段。"
      },
      {
        "family": "heat_transfer",
        "rationale": "属于传热学领域标签，与pde重叠；受控词表中pde更精确地指向数学模型结构，故主标签选pde。"
      }
    ]
  },
