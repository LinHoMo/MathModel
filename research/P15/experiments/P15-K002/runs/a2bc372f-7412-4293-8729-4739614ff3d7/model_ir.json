  "assumptions": [
    {
      "assumption_id": "A1",
      "text": "热流沿厚度方向一维传播，忽略织物平面方向的热扩散与边缘效应。",
      "type": "simplification",
      "rationale": "服装面积远大于厚度，侧面绝热；一维假设误差在边缘小区域，主体温度场准确。"
    },
    {
      "assumption_id": "A2",
      "text": "各层材料热物性（导热系数、比热、密度）为常数，不随温度变化。",
      "type": "mechanism_assumption",
      "rationale": "织物在37-80°C温区内物性变化小，常物性假设引入误差小于工程测量误差。"
    },
    {
      "assumption_id": "A3",
      "text": "层间理想接触，界面温度连续、热流连续，无接触热阻。",
      "type": "mechanism",
      "rationale": "服装层间贴合紧密；忽略接触热阻使皮肤侧温度预测略偏高，属保守方向。"
    },
    {
      "assumption_id": "A4",
      "text": "I层外表面与高温环境为对流换热边界，皮肤侧温度恒为37°C。",
      "type": "calibration",
      "rationale": "假人恒温控制是题面设定；外表面换热系数由附件实测温度反演校准。"
    },
    {
      "assumption_id": "A5",
      "text": "初始时刻服装各层温度均匀等于环境温度（或给定初温）。",
      "type": "projection",
      "rationale": "题面未给初始条件，采用均匀初温假设；初温影响在90分钟长时段后衰减。"
    },
    {
      "assumption_id": "A6",
      "text": "IV层为静止空气层，按纯导热处理，忽略自然对流与辐射。",
      "type": "simplification",
      "rationale": "空气隙厚度仅数毫米，努塞尔数小，纯导热近似合理；辐射在低温差下贡献有限。"
    }
  ],
