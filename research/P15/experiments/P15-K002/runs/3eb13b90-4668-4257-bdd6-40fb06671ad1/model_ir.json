{
  "ir_version": "1.0",
  "model_id": "M-3eb13b90",
  "model_family": {
    "primary": "dynamic_programming",
    "secondary": [
      "optimization",
      "graph_algorithm"
    ],
    "description": "以“天-位置-水量-食物量-资金”为状态、以天气与行动为转移的有限阶段动态规划为骨架，对多玩家情形在 DP 外层叠加博弈均衡求解。",
    "candidates": [
      {
        "family": "dynamic_programming",
        "rationale": "选择：穿越沙漠是典型有限阶段序贯决策问题，状态转移只依赖当前状态与当前行动（无后效性），DP 可精确给出六关规模下的全局最优策略；Q2 的随机天气可用期望递推直接扩展。"
      },
      {
        "family": "markov_decision_process",
        "rationale": "排除：MDP 的价值在于随机转移与策略迭代框架，但 Q1 天气全知下转移完全确定，MDP 退化为确定性 DP 且引入不必要的策略-评估循环；仅 Q2 局部需要其随机转移表示，用随机 DP 的期望递推即可覆盖。"
      },
      {
        "family": "integer_programming",
        "rationale": "排除：IP 适合一次性全局规划，但 Q2/Q3（2）要求逐日信息更新与天气随机性，解在信息到达前无法预先固定；且多人情形需要反应函数与均衡迭代，IP 难以刻画。"
      }
    ]
  },
  "problem_binding": {
    "problem_id": "2020_B",
    "sub_question_id": "Q1,Q2,Q3",
    "problem_sha256": "a2d0867169b94c592caafb438f608dfa12fc91c7e5df0aab5acaa5a9408ed4f2"
  },
  "assumptions": [
    {
      "assumption_id": "A1",
      "text": "资源以箱为最小单位离散计量，一天内的消耗、购买均以整箱计，且当天消耗发生在当天行动结束后。",
      "type": "simplification",
      "rationale": "题面规定最小计量单位为箱；离散化使状态空间可枚举，误差不超过 1 箱，对最优策略影响可忽略。"
    },
    {
      "assumption_id": "A2",
      "text": "玩家在一天内至多执行一种资源操作（行走/停留/挖矿/购买），且行动在天气确定后作出。",
      "type": "mechanism_assumption",
      "rationale": "题面以天为基本时间单位给出消耗规则；单日单操作与规则表述一致，避免同日复合操作的歧义。"
    },
    {
      "assumption_id": "A3",
      "text": "Q2 中未来天气的概率结构由历史同季同时段频率估计（晴朗/高温/沙暴的经验频率或一阶转移矩阵），并假设其不随时间漂移。",
      "type": "projection",
      "rationale": "玩家仅知当天天气，对未来天气的预期只能来自经验；该投影将不确定性转化为可计算的期望递推，频率漂移带来的偏差属于二阶小量。"
    },
    {
      "assumption_id": "A4",
      "text": "挖矿仅在矿山节点停留当天可执行，到达矿山当天不挖矿；沙暴日允许挖矿且必须停留。",
      "type": "mechanism",
      "rationale": "题面第（7）条明确到达矿山当天不能挖矿、沙暴日也可挖矿；这是收益更新的核心机制约束。"
    },
    {
      "assumption_id": "A5",
      "text": "Q3（1）中 n 名玩家在第 0 天同时、独立地确定全程方案，之后不可更改，视为同时行动的静态博弈，均衡取纯策略纳什均衡。",
      "type": "mechanism_assumption",
      "rationale": "题面规定方案第 0 天确定且此后不能更改，等价于一次性同时决策；纯策略均衡是这一设定下最自然的解概念，混合策略在确定性天气下无增益。"
    },
    {
      "assumption_id": "A6",
      "text": "Q3（2）中玩家在第 t 天行动结束后才获得其余玩家当日行动与剩余资源信息，信息结构为完美但不完全的序贯信息；玩家以自身剩余资金最大化为唯一目标，不合作不结盟。",
      "type": "mechanism_assumption",
      "rationale": "题面给出逐日信息更新规则；各玩家目标独立使模型成为动态博弈，可用扩展式博弈或近似 MDP 求解。"
    }
  ],
