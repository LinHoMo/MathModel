  "assumptions": [
    {
      "assumption_id": "A1",
      "text": "盘入与盘出路径均为等距阿基米德螺线，极径随极角线性变化，盘出螺线与盘入螺线关于中心中心对称。",
      "type": "mechanism",
      "rationale": "题面明示螺线类型与对称关系，几何结构完全由螺距与初始圈数确定。"
    },
    {
      "assumption_id": "A2",
      "text": "相邻把手距离等于板长，把手沿螺线按'弦长=板长'的几何条件落位。",
      "type": "mechanism_assumption",
      "rationale": "板凳刚性铰接，几何上即相邻点弦长固定。"
    },
    {
      "assumption_id": "A3",
      "text": "板凳为宽度 w=0.3 m 的矩形刚片，碰撞即几何干涉，干涉判据为相邻圈板凳的径向投影间隙小于板宽。",
      "type": "simplification",
      "rationale": "矩形刚片在相邻圈的投影宽度即板宽，忽略孔洞与把手的局部形状。"
    },
    {
      "assumption_id": "A4",
      "text": "调头路径为两段相切圆弧，前段半径是后段的 2 倍，两圆弧分别与盘入、盘出螺线相切。",
      "type": "mechanism",
      "rationale": "题面给定 S 形结构与半径比，缩短问题在此几何族内优化。"
    },
    {
      "assumption_id": "A5",
      "text": "龙头沿路径匀速行进，把手速度由路径曲率与链式几何传递决定，速度方向沿路径切向。",
      "type": "projection",
      "rationale": "匀速弧长驱动使时间参数化退化为弧长参数化，几何曲线完全决定运动学。"
    }
  ],
