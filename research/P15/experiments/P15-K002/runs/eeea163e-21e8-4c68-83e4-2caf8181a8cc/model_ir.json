    "candidates": [
      {
        "family": "pure_geometric_spiral",
        "rationale": "问题1-3的核心约束（螺线、圈间距、调头圆）全部是几何条件，几何路线能直接给出最小螺距与相切拼接的闭式关系。"
      },
      {
        "family": "kinematics",
        "rationale": "运动学提供时间-位置映射，但最小螺距与调头缩短问题本质是几何可行域，运动学作为时间驱动的补充。"
      },
      {
        "family": "numerical_optimization",
        "rationale": "数值优化可搜索可行域，但几何闭式解更利于敏感性分析，优化作为验证手段。"
      }
