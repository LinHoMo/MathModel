      ]
    },
    {
      "equation_id": "E2",
      "latex": "s_j(t+\\tau) = \\mathrm{idle} \\text{ when } \\tau = t_{p1} \\text{ (or } t_{a1}, t_{a2}) \\text{ elapses}",
      "type": "递推",
      "variables_refs": [
        "V4"
      ],
      "derivation_trace": "CNC 状态按加工时间确定性转移",
      "sub_question_binding": [
