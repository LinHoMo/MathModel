  },
  "assumptions": [
    {
      "assumption_id": "A1",
      "text": "任务完成与否主要由定价、任务位置与会员密度决定，会员信誉与预订限额按附件二配额比例进入可用会员数。",
      "type": "mechanism",
      "rationale": "题面描述任务分配按预订限额比例配发；用可用会员密度作为供给代理，抓住主效应。"
    },
    {
      "assumption_id": "A2",
      "text": "会员在任务发布后按距离与信誉理性选择任务，任务被完成的概率随价格上升、随距离与竞争上升而单调变化。",
      "type": "projection",
      "rationale": "行为假设支撑逻辑回归的单调性设定；个体异质性由随机项吸收。"
    },
    {
      "assumption_id": "A3",
      "text": "地理距离按经纬度欧氏距离近似，城市尺度下误差可接受。",
      "type": "simplification",
      "rationale": "附件给出坐标；未考虑道路网络，误差在1-3km量级，对定价规律方向性判断影响小。"
    },
    {
      "assumption_id": "A4",
      "text": "同一打包组内任务共享会员流量，打包价等于组内单价之和乘以折扣系数。",
      "type": "mechanism_assumption",
      "rationale": "打包的机制是聚合吸引力与规模折扣；折扣系数需校准，作为Q3模型修改的核心。"
    },
    {
      "assumption_id": "A5",
      "text": "附件三新项目与附件一项目处于相同市场环境，定价模型可直接迁移。",
      "type": "calibration",
      "rationale": "题面未给新市场数据；迁移假设使Q4可评估，同时以敏感性分析说明迁移风险。"
    }
  ],
