  "model_family": {
    "primary": "statistical_modeling",
    "secondary": [
      "optimization",
      "clustering"
    ],
    "description": "先从历史任务数据回归出定价与位置、会员密度的关系并解释未完成原因，再以完成率预测为目标构造新定价方案，打包场景叠加聚类。",
    "candidates": [
      {
        "family": "statistical_modeling",
        "rationale": "定价规律与未完成原因本质是数据驱动的回归与分类问题，历史数据完整可校准；作为主结构。"
      },
      {
        "family": "optimization",
        "rationale": "新定价方案需在预算约束下最大化完成率，回归模型作为目标函数的代理后进入优化；作为第二层。"
      },
      {
        "family": "clustering",
        "rationale": "任务打包以位置集中为前提，聚类是打包分组的工具；仅用于Q3。"
      },
      {
        "family": "decision_analysis",
        "rationale": "评价方案实施效果涉及多准则，但无交互式偏好结构；作为辅助视角排除为主结构。"
      }
    ]
  },
  "problem_binding": {
    "problem_id": "2017_B",
    "sub_question_id": "Q1,Q2,Q3,Q4",
