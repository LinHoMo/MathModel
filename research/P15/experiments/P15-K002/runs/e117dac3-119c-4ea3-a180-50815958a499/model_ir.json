  "assumptions": [
    {
      "assumption_id": "A1",
      "text": "板凳链为刚性铰接链，位形由链端位置与板长约束唯一确定，运动学状态可由一维链端弧长参数化。",
      "type": "mechanism",
      "rationale": "刚链自由度与链端位置一一对应，优化变量可压缩到低维。"
    },
    {
      "assumption_id": "A2",
      "text": "无碰撞约束以离散采样点上的板凳间距下限表达，采样充分密以保证约束代表性。",
      "type": "simplification",
      "rationale": "连续干涉约束离散化为有限不等式组，采样密度由收敛性检验确定。"
    },
    {
      "assumption_id": "A3",
      "text": "优化目标与约束对决策变量（螺距、圆弧半径、龙头速度）连续可微，可用梯度类算法。",
      "type": "simplification",
      "rationale": "几何量与弧长对参数连续，数值微分可用。"
    },
    {
      "assumption_id": "A4",
      "text": "调头曲线族限定为两段相切圆弧（R1=2R2），与两端螺线相切，切点为自由变量。",
      "type": "mechanism",
      "rationale": "题面限定曲线族，自由变量为半径与切点位置。"
    },
    {
      "assumption_id": "A5",
      "text": "全局最优通过多起点初始化与可行域网格扫描保障，避免局部最优陷阱。",
      "type": "simplification",
      "rationale": "非凸约束优化需多起点策略，网格扫描提供全局视角。"
    }
  ],
