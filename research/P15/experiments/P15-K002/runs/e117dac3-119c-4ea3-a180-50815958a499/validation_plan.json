{
  "limit_tests": [
    {
      "test_id": "LT1",
      "description": "板宽趋于0时无碰撞约束退化为空，p_min应趋于0且t_end趋于无穷",
      "parameter": "板宽w",
      "limit": "w -> 0",
      "expected_behavior": "p_min -> 0，终止时刻 -> ∞"
    },
    {
      "test_id": "LT2",
      "description": "调头圆半径趋于无穷时龙头永远无法到达边界，p_min问题无可行解",
      "parameter": "调头圆半径R_T",
      "limit": "R_T -> ∞",
      "expected_behavior": "可行域为空，优化报告不可行"
    },
    {
      "test_id": "LT3",
      "description": "速度上限趋于无穷时v_head^max应趋于无穷且无约束激活",
      "parameter": "速度上限v_max",
      "limit": "v_max -> ∞",
      "expected_behavior": "v_head^max -> ∞，无约束激活"
    }
  ],
  "multi_seed": {
    "n_runs": 5,
    "seeds": [
      42,
      123,
      456,
      789,
      1024
    ],
    "aggregation": "mean_std",
    "description": "多起点初始化与数值微分步长在不同配置下重复优化，报告最优值均值与标准差"
