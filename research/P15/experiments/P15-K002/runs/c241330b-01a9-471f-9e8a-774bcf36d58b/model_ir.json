      "sub_question_binding": "Q3"
    }
  ],
  "equations": [
    {
      "equation_id": "E1",
      "latex": "s_{t+1} = \\Phi(s_t, a_t): \\begin{cases} w_{t+1}=w_t-\\delta_t\\eta^w+b^w_t \\\\ f_{t+1}=f_t-\\delta_t\\eta^f+b^f_t \\\\ m_{t+1}=m_t - p_{loc}\\cdot b_t + r_{mine}\\mathbb 1_{\\text{挖矿}} \\end{cases}",
      "type": "递推",
      "variables_refs": [
        "V2",
        "V3",
        "V5",
        "V6"
      ],
      "derivation_trace": "状态转移函数由题面规则逐条转录（消耗倍率/价格倍率/挖矿收益）。",
      "sub_question_binding": "Q1"
    },
    {
      "equation_id": "E2",
      "latex": "V_t(s) = \\max_{a\\in A(s_t^w)} \\Big[ r(s,a) + \\gamma \\sum_{s'} P_s(s'|s_t^w) V_{t+1}(s') \\Big]",
      "type": "递推",
      "variables_refs": [
        "V1",
        "V2",
        "V3",
        "V8"
      ],
      "derivation_trace": "贝尔曼最优方程；行动集 A 受当日天气限制（沙暴仅停留）；γ=1（无折现，时限由截止日强制）。",
      "sub_question_binding": "Q2"
    },
    {
      "equation_id": "E3",
      "latex": "\\delta_t^{eff} = \\delta_t \\cdot \\mathbb 1_{k=1} + \\begin{cases} 2k & \\text{同行} \\\\ 3 & \\text{同矿} \\end{cases},\\quad r_{mine}^{eff}=\\frac{r_{mine}}{k},\\quad p^{eff}=\\begin{cases}4p_0&\\text{同购}\\\\p_{loc}&\\text{否则}\\end{cases}",
      "type": "代数",
      "variables_refs": [
        "V4",
        "V7"
      ],
      "derivation_trace": "拥挤规则转录为有效消耗/收益/价格，替换 E1 中的对应项。",
      "sub_question_binding": "Q3"
    }
  ],
