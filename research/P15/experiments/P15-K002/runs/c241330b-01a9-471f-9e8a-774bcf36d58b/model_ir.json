  "model_family": {
    "primary": "markov_decision_process",
    "secondary": [
      "dynamic_programming",
      "optimization"
    ],
    "description": "把穿越沙漠全程建模为带随机天气的马尔可夫决策过程，策略以天为步、以资源-位置-资金为状态，在线信息下滚动执行，全知情形为确定性特例。",
    "candidates": [
      {
        "family": "markov_decision_process",
        "rationale": "Q2/Q3-2 的信息结构（仅知当天天气、按天行动）与随机天气转移正是 MDP 的标准设定，策略映射 s→a 可直接落地，故选为主模型族。"
      },
      {
        "family": "dynamic_programming",
        "rationale": "全知天气（Q1、Q3-1）是 MDP 的确定性退化，倒推 DP 给出精确解，作为 MDP 的求解内核。"
      },
      {
        "family": "optimization",
        "rationale": "购买量与路径可写成规划，但状态递推已覆盖全部约束，规划仅作校验。"
      },
      {
        "family": "game_theory",
        "rationale": "多玩家拥挤产生策略耦合，需博弈修正；但单玩家核仍是 MDP，故为扩展层。"
      },
      {
        "family": "graph_algorithm",
        "rationale": "地图移动本身是图问题，但资源与资金约束超出图结构，故排除。"
      }
    ]
  },
  "problem_binding": {
    "problem_id": "2020_B",
    "sub_question_id": "Q1,Q2,Q3",
    "problem_sha256": "a2d0867169b94c592caafb438f608dfa12fc91c7e5df0aab5acaa5a9408ed4f2"
  },
  "assumptions": [
    {
      "assumption_id": "A1",
      "text": "天气过程满足一阶马尔可夫性：次日天气只依赖当日天气。",
      "type": "mechanism",
      "rationale": "题面未给天气生成机制，一阶马尔可夫为最小假设；转移概率由历史天气数据校准。"
    },
    {
      "assumption_id": "A2",
      "text": "玩家按期望资金最大化决策，风险中性。",
      "type": "mechanism",
      "rationale": "题面目标为保留尽可能多资金，期望口径标准。"
    },
    {
      "assumption_id": "A3",
      "text": "资源与资金状态在每天结束时更新，购买在消耗后发生。",
      "type": "calibration",
      "rationale": "与题面注 2 口径一致，保证状态更新与统计对齐。"
    },
    {
      "assumption_id": "A4",
      "text": "沙暴日强制停留，其余天气下可自由行动。",
      "type": "mechanism",
      "rationale": "题面规则(4) 直接转录。"
    },
    {
      "assumption_id": "A5",
      "text": "多玩家情形中，拥挤系数 k 在当天行动前可预测（Q3-1 已知全盘，Q3-2 由昨日信息推断）。",
      "type": "mechanism_assumption",
      "rationale": "题面信息结构决定 k 的可知性，模型据此分两种模式求解。"
    }
  ],
