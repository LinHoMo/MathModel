  "assumptions": [
    {
      "assumption_id": "A1",
      "text": "司机决策时已知当前航班到达数、蓄车池车辆数与乘车区排队人数，并按历史统计估计未来乘客到达率。",
      "type": "projection",
      "rationale": "题面说明这些信息可观测；以点估计代替完整分布，误差随时段聚合而减小。"
    },
    {
      "assumption_id": "A2",
      "text": "乘客到达乘车区服从时变泊松过程，出租车载客服务时间服从指数分布（排队近似）。",
      "type": "mechanism_assumption",
      "rationale": "经典排队近似，便于解析等待时间；高峰时段非平稳性通过分段平稳处理。"
    },
    {
      "assumption_id": "A3",
      "text": "空返方案的期望收益由空载里程成本与潜在载客概率决定，司机按历史平均载客率估计。",
      "type": "calibration",
      "rationale": "空返收益无法直接观测，用城市出租车平均实载率折算，属于数据校准锚。"
    },
    {
      "assumption_id": "A4",
      "text": "载客收益与行驶里程近似线性正比，短途单次收益低但周转快。",
      "type": "simplification",
      "rationale": "计价规则分段但可线性近似；用于短途优先权设计的收益均衡分析，误差在短途段可控。"
    },
    {
      "assumption_id": "A5",
      "text": "乘车区两条车道为并行单列排队，上车点设置不改变总服务率而改变乘客走行与车辆周转时间。",
      "type": "simplification",
      "rationale": "将复杂车道交互简化为双服务台模型，聚焦上车点数量与位置的效率影响。"
    },
    {
      "assumption_id": "A6",
      "text": "管理部门按批次放行车辆，批次大小与放行间隔为可控决策。",
      "type": "mechanism",
      "rationale": "题面明确分批定量放行；批次策略是Q3优化的核心自由度。"
    }
  ],
