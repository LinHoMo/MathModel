    "candidates": [
      {
        "family": "decision_analysis",
        "rationale": "司机在可观测信息下权衡等待成本与潜在收益，本质是单主体期望效用决策；决策树与阈值规则直观可操作，作为主结构。"
      },
      {
        "family": "queueing_theory",
        "rationale": "蓄车池与乘客队列的排队动力学是等待时间的关键来源，作为等待时间估计的子模块而非整体框架。"
      },
      {
        "family": "optimization",
        "rationale": "上车点布局与分批放行需要系统优化，用于乘车区效率问题，覆盖Q3；不承担Q1的个体决策机理。"
      },
      {
        "family": "game_theory",
        "rationale": "司机间存在排队博弈，但题面强调个体经验决策与宏观调度，均衡分析复杂且难落地；排除作为主结构。"
      }
    ]
  },
