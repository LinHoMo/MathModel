  },
  "assumptions": [
    {
      "assumption_id": "A1",
      "text": "有效数据定义为成分累加和落在85%至105%之间，建模时以有效样品为样本总体。",
      "type": "calibration",
      "rationale": "题面直接给定有效区间，作为样本筛选的统一口径。"
    },
    {
      "assumption_id": "A2",
      "text": "风化前成分含量可由风化点成分、风化程度与玻璃类型经回归函数映射得到，且映射在类别内近似同质。",
      "type": "mechanism_assumption",
      "rationale": "风化是系统性的元素迁移，回归映射可捕捉迁移的方向与幅度；类别内同质假设使样本量足够估计。"
    },
    {
      "assumption_id": "A3",
      "text": "未风化点成分作为风化前成分的观测代理，其与真实配方之间的差异为独立同分布噪声。",
      "type": "projection",
      "rationale": "未风化区域元素交换极少，代理误差远小于风化造成的偏移，量级约1-2个百分点。"
    },
    {
      "assumption_id": "A4",
      "text": "类别归属概率与判别成分满足逻辑斯蒂形式，即类别边界在成分空间中是光滑超平面。",
      "type": "simplification",
      "rationale": "逻辑回归对线性可分边界拟合稳健，且输出概率便于敏感性分析。"
    },
    {
      "assumption_id": "A5",
      "text": "成分缺失源于低于检出限，回归中采用类别内成分均值插补，并对插补引入的不确定性做区间传播。",
      "type": "simplification",
      "rationale": "均值插补保持样本规模，区间传播避免高估回归精度。"
    }
  ],
