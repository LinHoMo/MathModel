  "model_family": {
    "primary": "dynamic_programming",
    "secondary": [
      "optimization",
      "simulation"
    ],
    "description": "把 RGV 调度视为滚动时域动态规划：以系统状态（RGV 位置、各 CNC 加工剩余时间、队列）定义阶段收益，递推求最优决策，并用仿真验证策略。",
    "candidates": [
      {
        "family": "dynamic_programming（滚动时域 DP）",
        "rationale": "状态-动作结构清晰，可逐阶段递推最优策略并支持故障随机性，选为最终模型。"
      },
      {
        "family": "optimization（静态 MILP）",
        "rationale": "全时间窗整数规划在 8 台 CNC × 28800s 下变量爆炸，仅可解小规模，排除为主方法。"
      },
      {
        "family": "simulation（无策略仿真）",
        "rationale": "仿真只能评估给定策略，不能生成策略，作为验证层使用。"
      },
      {
        "family": "markov_decision_process",
        "rationale": "故障使系统具马尔可夫性，但状态空间巨大，用 DP 滚动时域近似其策略。"
      }
    ]
  },
  "problem_binding": {
    "problem_id": "2018_B",
    "sub_question_id": "Q1,Q2,Q3,Q4",
    "problem_sha256": "f00ef29490cc2ef0ca87d7bf17b598ecae98021e8049addfa222649bee410152"
  },
  "assumptions": [
    {
      "assumption_id": "A1",
      "text": "系统状态可由 RGV 位置、各 CNC 剩余加工时间与待服务标志完全描述（马尔可夫性）。",
      "type": "mechanism",
      "rationale": "加工时间确定、服务时间恒定，状态转移仅依赖当前状态与动作。"
    },
    {
      "assumption_id": "A2",
      "text": "滚动时域内对未来服务请求用当前信息外推（简化投影）。",
      "type": "projection",
      "rationale": "完整未来信息不可得时，用短视估计近似，误差随滚动窗口增大而减小。"
    },
    {
      "assumption_id": "A3",
      "text": "两道工序 CNC 固定分组（1–4 第一道、5–8 第二道）。",
      "type": "calibration",
      "rationale": "分工固定使阶段转移清晰，差异在 Q4 检验。"
    },
    {
      "assumption_id": "A4",
      "text": "故障为 Bernoulli(0.01)、修复 U(600,1200)s，独立于调度。",
      "type": "projection",
      "rationale": "按题面统计建模。"
    },
    {
      "assumption_id": "A5",
      "text": "忽略传送带缺料与 RGV 机械故障以外的异常。",
      "type": "simplification",
      "rationale": "聚焦题目指定场景。"
    }
  ],
