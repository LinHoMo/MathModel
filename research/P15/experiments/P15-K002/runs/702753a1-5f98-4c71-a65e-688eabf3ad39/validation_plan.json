      "param_id": "P8",
      "range": "0–3%",
      "method": "one_at_a_time",
      "target": "O3"
    },
    {
      "param_id": "P10",
      "range": "H in {3,5,8}",
      "method": "one_at_a_time",
      "target": "O1"
    },
    {
      "param_id": "P6",
      "range": "±20%",
      "method": "one_at_a_time",
      "target": "O4"
    }
  ],
  "ambiguity_handling": [
