{
  "limit_tests": [
    {
      "test_id": "LT1",
      "description": "RGV 移动时间趋于 0 时系统退化为 8 台独立加工站，班产应趋于纯加工上限",
      "parameter": "t_m",
      "limit": "t_m -> 0",
      "expected_behavior": "N_shift 单调上升至 sum_j floor(T_shift/(t_p+t_load)) 上界"
    },
    {
      "test_id": "LT2",
      "description": "故障概率趋于 0 时随机模型应退化到确定性调度结果",
      "parameter": "p_f",
      "limit": "p_f -> 0",
      "expected_behavior": "期望班产收敛到无故障班产，方差趋于 0"
    }
  ],
  "multi_seed": {
    "n_runs": 5,
    "seeds": [
      42,
      123,
      456,
      789,
      1024
    ],
    "aggregation": "mean_std",
    "description": "故障与修复时间随机性用多种子蒙特卡洛评估，产量取均值±标准差，CV<3% 判稳"
  },
  "sensitivity": [
