{
  "ir_version": "1.0",
  "model_id": "M-14822f53",
  "model_family": {
    "primary": "statistical_classification",
    "secondary": [
      "regression_analysis"
    ],
    "description": "以统计分类为主线：先对风化状态做类别化描述统计，再用回归复原风化前成分，最后以判别型统计分类完成亚类划分与未知样品鉴别。",
    "candidates": [
      {
        "family": "statistical_classification",
        "rationale": "题面要求分析风化与类型/纹饰/颜色的关系、对两类玻璃做亚类划分并鉴别未知样品，本质是类别间的统计比较与判别，统计分类直接对应各子问题产出。"
      },
      {
        "family": "clustering",
        "rationale": "聚类可用于亚类划分，但亚类划分需以已知两大类型为约束且要求可解释的化学成分阈值，纯无监督聚类难以保证类别语义，故作为辅助而非主线。"
      },
      {
        "family": "decision_tree",
        "rationale": "决策树可产出可读判别规则，但成分数据为连续比例且样本量有限，树模型易过拟合，故不选为主线。"
      }
    ]
  },
  "problem_binding": {
    "problem_id": "2022_C",
    "sub_question_id": "Q1,Q2,Q3,Q4",
    "problem_sha256": "ec5e098f9dbe858e50280a7366faeb6cc0d2e7db1fd21e8fc7b3de7d85ad1709"
  },
  "assumptions": [
    {
      "assumption_id": "A1",
      "text": "成分比例累加和介于85%到105%之间的样品视为有效数据，其余样品在涉及比例结构的分析中剔除或单独标记。",
      "type": "calibration",
      "rationale": "题面明确定义有效数据区间，检测误差导致的偏离以该区间为界；剔除可避免异常累加和对统计规律的干扰。"
    },
    {
      "assumption_id": "A2",
      "text": "同一件文物上未风化点的成分含量可视为该文物风化前成分的无偏近似，可作为风化复原回归的训练目标。",
      "type": "mechanism_assumption",
      "rationale": "未风化区域未经历大规模元素交换，保留原始配方信息；以同一文物的成对风化点与未风化点建立映射，误差主要来自风化程度差异。"
    },
    {
      "assumption_id": "A3",
      "text": "风化对各类成分的影响是类型依赖的线性偏移，即风化前后成分差值与风化程度指标呈线性关系。",
      "type": "simplification",
      "rationale": "样本量有限，线性偏移是最简可估结构；对强风化样品残差较大，误差量级约在几个百分点内，可接受。"
    },
    {
      "assumption_id": "A4",
      "text": "高钾玻璃与铅钡玻璃在成分空间上存在可分离的判别边界，判别边界由代表性成分（K2O、PbO、BaO）主导。",
      "type": "mechanism",
      "rationale": "两类玻璃助熔剂来源不同，铅钡玻璃富PbO/BaO，钾玻璃富K2O，机理上保证类别可分。"
    },
    {
      "assumption_id": "A5",
      "text": "各成分检测缺失（空白）表示低于检出限，在统计时按缺失处理而非零值，仅在特定成分分析中做插补。",
      "type": "simplification",
      "rationale": "低于检出限不等于含量为零，直接置零会扭曲相关性；按缺失处理更符合检测原理。"
    }
  ],
