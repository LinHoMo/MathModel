  "assumptions": [
    {
      "assumption_id": "A1",
      "text": "系统按离散事件推进：事件为加工完成、上下料完成、清洗完成、故障发生与排除。",
      "type": "mechanism",
      "rationale": "所有时间参数为固定值或区间分布，事件驱动是精确复现系统演化的标准方式。"
    },
    {
      "assumption_id": "A2",
      "text": "物料在传送带与清洗槽之间无额外等待，RGV 串行执行移动-上下料-清洗。",
      "type": "simplification",
      "rationale": "题面未给出传送带节拍，假设其不成为瓶颈。"
    },
    {
      "assumption_id": "A3",
      "text": "故障概率 1% 作用于每次加工开始，排除时间在 10~20 分钟均匀分布。",
      "type": "projection",
      "rationale": "题面给出概率与区间，均匀分布为最大熵选择。"
    },
    {
      "assumption_id": "A4",
      "text": "班次 8 小时从空载状态开始，结束时未完工物料不计入产量。",
      "type": "calibration",
      "rationale": "题面规定班次时长，空载起始统一结果口径。"
    },
    {
      "assumption_id": "A5",
      "text": "两道工序中，第二道可在任意尚未加工第一道的空闲 CNC 上进行，但同机不得连续承担同一物料两道工序。",
      "type": "mechanism",
      "rationale": "题面要求两道工序由两台不同 CNC 完成。"
    },
    {
      "assumption_id": "A6",
      "text": "RGV 策略由优先级规则决定：目标选择按（服务请求、距离、奇偶负载）打分，分数最高者优先。",
      "type": "mechanism_assumption",
      "rationale": "仿真需要显式决策规则，优先级打分是覆盖多种启发式的统一形式。"
    }
  ],
