  "assumptions": [
    {
      "assumption_id": "A1",
      "text": "天气序列为马尔可夫链：次日天气只依赖当日天气，转移概率由历史季节数据估计。",
      "type": "mechanism_assumption",
      "rationale": "题面未给天气生成机制；马尔可夫假设使在线场景可作有限状态推理，误差随转移概率校准精度下降。"
    },
    {
      "assumption_id": "A2",
      "text": "全知场景下天气转移概率退化为确定序列，MDP退化为确定性MDP。",
      "type": "projection",
      "rationale": "Q1与Q3.1题面给定全知；统一框架下以确定性转移表达。"
    },
    {
      "assumption_id": "A3",
      "text": "资源以箱为单位，购买、消耗与退回均取整数；负重按每箱质量线性约束。",
      "type": "simplification",
      "rationale": "题面规定最小计量单位；整数状态使值迭代可枚举，精度损失为单箱尺度。"
    },
    {
      "assumption_id": "A4",
      "text": "多人耦合仅经消耗倍数、挖矿收益分配与村庄价格体现，玩家状态互不影响。",
      "type": "mechanism",
      "rationale": "题面规则3给出唯一耦合机制；耦合MDP以其他玩家行动为外部参数。"
    },
    {
      "assumption_id": "A5",
      "text": "在线多人场景中玩家次日行动基于昨日全量信息更新，形成同步学习的迭代过程。",
      "type": "projection",
      "rationale": "题面Q3.2明确信息时滞；同步更新假设使迭代均衡可计算。"
    },
    {
      "assumption_id": "A6",
      "text": "到达矿山当天不能挖矿，沙暴日可挖矿，行动集合随位置与天气过滤。",
      "type": "calibration",
      "rationale": "题面规则7；作为行动可行性过滤进入MDP转移。"
    }
  ],
