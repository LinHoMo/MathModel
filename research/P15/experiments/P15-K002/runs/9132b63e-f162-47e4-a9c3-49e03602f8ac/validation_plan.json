{
  "limit_tests": [
    {
      "test_id": "LT1",
      "description": "II 层厚度趋于 0 时皮肤温度应趋于无 II 层防护情形（上限），验证模型退化行为",
      "parameter": "d_2",
      "limit": "d_2 -> 0",
      "expected_behavior": "T_s(t) 单调上升至无 II 层时的更高温度曲线"
    },
    {
      "test_id": "LT2",
      "description": "工作时间趋于无穷时温度场应趋于稳态线性分布",
      "parameter": "t",
      "limit": "t -> infinity",
      "expected_behavior": "T(x) 收敛到各层线性稳态解，T_s 趋近稳态值"
    }
  ],
  "multi_seed": {
    "n_runs": 5,
