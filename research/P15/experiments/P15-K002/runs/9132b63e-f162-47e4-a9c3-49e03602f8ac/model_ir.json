  "assumptions": [
    {
      "assumption_id": "A1",
      "text": "一维厚度方向传热，面内温度均匀。",
      "type": "simplification",
      "rationale": "服装面积远大于厚度，侧向梯度可忽略。"
    },
    {
      "assumption_id": "A2",
      "text": "空气间隙 IV 层采用等效导热系数，包含辐射与自然对流贡献。",
      "type": "calibration",
      "rationale": "间隙内复合换热等效为导热，由附件 2 反演标定。"
    },
    {
      "assumption_id": "A3",
      "text": "皮肤侧为对流边界，体内恒温 37°C。",
      "type": "mechanism",
      "rationale": "假人体温恒定，皮肤血流换热以对流系数表征。"
    },
    {
      "assumption_id": "A4",
      "text": "层间接触热阻为零。",
      "type": "simplification",
      "rationale": "织物层压紧，接触热阻相对织物热阻可忽略。"
    },
    {
      "assumption_id": "A5",
      "text": "初始温度取环境温度 75°C 与室温 25°C 两种情形对比检验。",
      "type": "projection",
      "rationale": "着装初始状态未知，双初始设定可量化其影响。"
    }
  ],
