      "variables_refs": [
        "V1",
        "V2",
        "V3"
      ],
      "derivation_trace": "FTCS 显式格式离散抛物型方程，稳定性条件 Fo<=0.5",
      "sub_question_binding": [
        "Q1",
        "Q2",
        "Q3"
      ]
    },
    {
      "equation_id": "E2",
      "latex": "k_{i+1/2} = 2 k_i k_{i+1}/(k_i + k_{i+1})",
      "type": "代数",
      "variables_refs": [
        "V1"
      ],
      "derivation_trace": "层界面调和平均导热系数，保证界面热流连续",
