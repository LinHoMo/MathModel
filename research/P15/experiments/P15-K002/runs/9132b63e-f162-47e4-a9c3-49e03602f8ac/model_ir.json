        "Q2",
        "Q3"
      ]
    },
    {
      "equation_id": "E3",
      "latex": "-k_1 (T_1^n - T_0^n)/\\Delta x = h_1 (T_{env} - T_0^n);\\quad -k_3 (T_N^n - T_{N-1}^n)/\\Delta x = h_2 (T_N^n - T_b)",
      "type": "差分",
      "variables_refs": [
        "V1",
        "V4"
      ],
      "derivation_trace": "边界节点的一阶差分形式的第三类边界条件",
