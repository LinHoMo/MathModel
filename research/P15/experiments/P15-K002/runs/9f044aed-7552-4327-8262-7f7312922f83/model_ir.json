  "assumptions": [
    {
      "assumption_id": "A1",
      "text": "龙头前把手的运动路径为分段光滑平面曲线：螺线段（阿基米德螺线）与调头段（相切圆弧拼接），弧长参数化。",
      "type": "mechanism",
      "rationale": "题面给定路径类型，分段光滑曲线的弧长参数化是微分几何的标准描述。"
    },
    {
      "assumption_id": "A2",
      "text": "把手链沿曲线按'相邻把手弦长=板长'落位，弦向即板凳纵轴方向。",
      "type": "mechanism_assumption",
      "rationale": "刚链几何：相邻点弦长固定，板凳方向沿弦。"
    },
    {
      "assumption_id": "A3",
      "text": "曲线曲率连续（调头拼接处切向连续），速度场由弧长匀速驱动与链式传递产生，把手速率与局部曲率相关。",
      "type": "simplification",
      "rationale": "切向连续保证速度连续；曲率影响链式速度放大。"
    },
    {
      "assumption_id": "A4",
      "text": "干涉判据为相邻圈曲线的法向间距小于板宽，可由曲线法向几何计算。",
      "type": "simplification",
      "rationale": "螺线相邻圈的法向间距即螺距的径向分量，法向几何给出解析判据。"
    },
    {
      "assumption_id": "A5",
      "text": "调头最短化在'两圆弧相切且与两端螺线相切'的曲线族内进行，目标为总弧长。",
      "type": "simplification",
      "rationale": "题面限定曲线族，最短化仅在该族内，保持几何可行性。"
    }
  ],
