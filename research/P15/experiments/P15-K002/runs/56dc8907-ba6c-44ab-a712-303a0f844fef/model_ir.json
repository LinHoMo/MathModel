      {
        "family": "statistical_modeling（logistic 回归 + 核密度）",
        "rationale": "附件一提供任务-完成二元标签，logistic 回归天然匹配，可解释定价规律，选为最终模型。"
      },
      {
        "family": "optimization（整数规划定价）",
        "rationale": "可保证预算下完成率最优，但需将非线性完成率线性化，作为 Q2 的优化层。"
      },
      {
        "family": "decision_analysis（效用函数定价）",
        "rationale": "需会员效用先验，数据不足，排除。"
      },
      {
        "family": "clustering（密度分层定价）",
        "rationale": "只按密度分层忽略价格弹性，无法解释 Q1 未完成原因，排除。"
      }
    ]
  },
