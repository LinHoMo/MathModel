  "assumptions": [
    {
      "assumption_id": "A1",
      "text": "接单概率随任务-会员距离衰减，超过阈值半径 r_0 不接单。",
      "type": "mechanism",
      "rationale": "众包接单的典型空间行为。"
    },
    {
      "assumption_id": "A2",
      "text": "任务完成概率 = 1-(1-q)^n，n 为半径内加权活跃会员数。",
      "type": "mechanism",
      "rationale": "独立接单的泊松近似。"
    },
    {
      "assumption_id": "A3",
      "text": "接单率与价格呈 logistic 关系。",
      "type": "calibration",
      "rationale": "经济行为 S 型假设，由附件一拟合。"
    },
    {
      "assumption_id": "A4",
      "text": "信誉只影响选择顺序与配额，不影响单位接单意愿。",
      "type": "simplification",
      "rationale": "题面规则如此。"
    },
    {
      "assumption_id": "A5",
      "text": "打包任务按成员价格之和乘折扣系数发布，一次领取。",
      "type": "projection",
      "rationale": "打包机制的简化抽象。"
    }
  ],
