  "equations": [
    {
      "equation_id": "E1",
      "latex": "q_i(p_i) = \\frac{1}{1+\\exp(-(\\beta_0 + \\beta_1 p_i - \\beta_2 d_i^{min}))}",
      "type": "代数",
      "variables_refs": [
        "V5",
        "V1",
        "V4"
      ],
      "derivation_trace": "logistic 回归拟合附件一",
      "sub_question_binding": [
        "Q1",
        "Q2",
        "Q3",
        "Q4"
      ]
    },
    {
      "equation_id": "E2",
      "latex": "P_i = 1 - (1-q_i)^{n_i}, \\quad n_i = \\lfloor \\sum_{j: d_{ij} \\le r_0} w_j L_j \\rfloor",
      "type": "代数",
      "variables_refs": [
        "V5",
        "V6",
        "V3"
      ],
      "derivation_trace": "半径内独立会员的完成概率",
      "sub_question_binding": [
        "Q2",
        "Q3",
        "Q4"
      ]
    },
    {
      "equation_id": "E3",
      "latex": "p_{G_k} = \\gamma \\sum_{i \\in G_k} p_i^{new}",
      "type": "代数",
      "variables_refs": [
        "V7",
        "V1"
      ],
      "derivation_trace": "打包定价：成员价格之和乘折扣",
      "sub_question_binding": "Q3"
    },
    {
      "equation_id": "E4",
      "latex": "p_i^{new} = p_0 + \\alpha \\ln(\\bar{\\rho}/\\rho_i) - \\beta_2 d_i^{min} + \\delta_i",
