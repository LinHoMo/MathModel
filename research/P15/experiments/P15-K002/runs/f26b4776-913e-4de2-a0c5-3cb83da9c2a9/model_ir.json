  "equations": [
    {
      "equation_id": "E1",
      "latex": "c_{i,k} = c_{i,k-1} + t_{proc} + t_{wash} + t_{load} + \\text{（等待/移动补偿）}",
      "type": "代数",
      "variables_refs": [
