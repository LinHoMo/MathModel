      ],
      "derivation_trace": "单机调度 MILP 表述；求解规模经剪枝控制在可解范围。",
      "sub_question_binding": "Q1"
    },
    {
      "equation_id": "E3",
      "latex": "\\mathbb E[N_{prod}] = \\sum_{\\xi} Pr(\\xi) N_{prod}(y^*|\\xi),\\quad Pr(\\xi_{i,k}=1)=0.01",
      "type": "代数",
      "variables_refs": [
        "V4",
        "V6"
      ],
      "derivation_trace": "故障事件概率加权；仿真估计期望。",
