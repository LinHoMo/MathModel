    {
      "equation_id": "E2",
      "latex": "\\min_y \\sum_i \\omega W_i \\quad \\text{s.t.}\\quad c_{i,k} - c_{j,l} \\ge t_{move} + t_{serve}\\ \\text{（序列约束）}",
      "type": "代数",
      "variables_refs": [
