  "model_family": {
    "primary": "markov_decision_process",
    "secondary": [
      "optimization",
      "game_theory"
    ],
    "description": "以马尔可夫决策过程为统一框架：单玩家情形用 MDP 的策略迭代求最优策略，多人情形将拥挤耦合作为状态相关的转移与奖励修正，在 MDP 框架内做均衡迭代。",
    "candidates": [
      {
        "family": "markov_decision_process",
        "rationale": "选择：天气过程具有马尔可夫性（当日天气已知，未来以经验转移概率演化），行动-奖励-状态转移结构天然构成 MDP；Q2 与 Q3（2）的信息结构正好对应 MDP 的观测-策略-值函数范式。"
      },
      {
        "family": "dynamic_programming",
        "rationale": "排除：确定性 DP 能求解 Q1 但难以统一表达 Q2 的策略评估与 Q3（2）的逐日信息更新；MDP 的策略迭代/值迭代框架更契合不确定性占主导的设定。"
      },
      {
        "family": "simulation",
        "rationale": "排除：纯仿真只能给出特定策略下的表现，无法系统寻优；仿真保留为 MDP 策略的验证工具而非主模型。"
      }
    ]
  },
  "problem_binding": {
    "problem_id": "2020_B",
    "sub_question_id": "Q1,Q2,Q3",
    "problem_sha256": "a2d0867169b94c592caafb438f608dfa12fc91c7e5df0aab5acaa5a9408ed4f2"
  },
  "assumptions": [
    {
      "assumption_id": "A1",
      "text": "天气过程建模为一阶马尔可夫链：给定当天天气，次日天气的条件分布与更早历史无关。",
      "type": "mechanism_assumption",
      "rationale": "题面未给天气生成机制，一阶马尔可夫假设是 MDP 的机制核心，也是经验上对天气过程最常用的近似；高阶依赖的遗漏误差体现在转移矩阵校准残差中。"
    },
    {
      "assumption_id": "A2",
      "text": "资源消耗在当天行动结束后结算，状态转移以天为步长同步更新。",
      "type": "simplification",
      "rationale": "与题面按天计时的规则一致，避免日内连续时间的复杂性；误差不超过一天的消耗量级。"
    },
    {
      "assumption_id": "A3",
      "text": "Q2 中玩家对天气的信念来自同季节同时段的历史频率（晴朗/高温/沙暴的经验分布），并以此作为 MDP 转移核。",
      "type": "projection",
      "rationale": "玩家仅知当天天气，其对未来的预期只能来自经验频率；该投影给出可计算的转移核，是 Q2 策略评估的基础。"
    },
    {
      "assumption_id": "A4",
      "text": "Q3（1）多人方案第 0 天固定，玩家同时行动且目标独立，采用纯策略纳什均衡；MDP 中每个玩家的转移与奖励依赖他人策略，构成随机博弈的静态特例。",
      "type": "mechanism_assumption",
      "rationale": "题面规定方案不可更改，等价于一次性同时博弈；纯策略均衡在确定性天气下自然成立。"
    },
    {
      "assumption_id": "A5",
      "text": "Q3（2）中第 t 天行动结束后公开他人行动与剩余资源，玩家据此更新信息集并以期望终局资金为目标。",
      "type": "mechanism_assumption",
      "rationale": "题面给出逐日信息更新规则；信息集随日扩张，使模型成为具有完美回忆的随机博弈。"
    },
    {
      "assumption_id": "A6",
      "text": "玩家风险中性：以期望终局资金最大化作为唯一效用，不考虑方差或破产厌恶。",
      "type": "projection",
      "rationale": "题面以“保留尽可能多的资金”为目标，期望最大化是直接对应；风险偏好差异属于个体层面的二阶修正。"
    }
  ],
