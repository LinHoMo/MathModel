  "mechanisms": [
    {
      "mechanism_id": "M1",
      "description": "MDP 状态（位置、水、食物、资金、天气）与行动集的贝尔曼最优性方程给出 Q1/Q2 统一求解框架：全知天气退化为确定性转移，随机天气用转移矩阵取期望。",
      "related_equations": [
        "E1",
        "E2"
      ],
      "sub_question_binding": [
        "Q1",
        "Q2"
      ]
    },
    {
      "mechanism_id": "M2",
      "description": "多人拥挤使每个玩家的转移概率与即时奖励依赖他人策略，模型化为随机博弈；Q3（1）静态化后为矩阵博弈型均衡，Q3（2）为带完美回忆的序贯均衡。",
      "related_equations": [
        "E3",
        "E4",
        "E5"
      ],
      "sub_question_binding": "Q3"
    },
    {
      "mechanism_id": "M3",
      "description": "策略以阈值/查找表形式存储（“高温日不移动”“沙暴日必停留”等规则），保证策略在部分可观测天气信息下可执行。",
      "related_equations": [
        "E1",
        "E6"
      ],
      "sub_question_binding": "Q2"
    }
  ],
  "equations": [
    {
      "equation_id": "E1",
      "latex": "v_t(s) = \\max_{a \\in A(s)} \\Big[ r_t(s,a) + \\sum_{s'} P(s' | s,a)\\, v_{t+1}(s') \\Big]",
      "type": "递推",
      "variables_refs": [
        "V10",
        "V7",
        "V2",
        "V3",
        "V4",
        "V5"
      ],
      "derivation_trace": "贝尔曼最优性方程：即时奖励 r_t 包含挖矿收益减购买支出，转移核 P 由天气矩阵与行动规则诱导；终端 v_T(e)=M_T, v_T(\\neq e)=-\\infty。",
      "sub_question_binding": [
        "Q1",
        "Q2"
      ]
    },
    {
      "equation_id": "E2",
      "latex": "r_t(s,a) = g_0 y_t - p_w q^w_t - p_f q^f_t + \\alpha p \\cdot \\text{refund}_t",
      "type": "代数",
      "variables_refs": [
        "V5",
        "P2",
        "P3",
        "P9",
        "P13"
      ],
      "derivation_trace": "即时奖励分解：挖矿收益、购买支出与（仅终点）退款；多人情形按 P14 修正。",
      "sub_question_binding": [
        "Q1",
        "Q2",
        "Q3"
      ]
    },
    {
      "equation_id": "E3",
      "latex": "P(s' | s,a) = \\sum_{\\theta'} \\mathbb{1}[\\text{规则可行}]\\, p(\\theta') ",
      "type": "代数",
      "variables_refs": [
        "V6",
        "V2",
        "P11"
      ],
      "derivation_trace": "转移核由天气转移矩阵与行动规则（沙暴停留、邻接移动）共同诱导；确定性天气时 p 退化为单位质量。",
      "sub_question_binding": [
        "Q1",
        "Q2"
      ]
    },
    {
      "equation_id": "E4",
      "latex": "\\pi^{(j)*} \\in \\arg\\max_{\\pi^{(j)}} v^{(j)}_0(\\pi^{(j)}, \\pi^{(-j)*})",
      "type": "逻辑",
      "variables_refs": [
        "V9",
        "V10",
        "V8",
        "V11"
      ],
      "derivation_trace": "Q3（1）随机博弈的静态纳什均衡：每名玩家策略是对他人均衡策略的最优反应；k_t 由策略剖面诱导。",
      "sub_question_binding": "Q3"
    },
    {
      "equation_id": "E5",
      "latex": "\\mathcal{I}_t = \\bigcup_j \\{a^{(j)}_t, W^{(j)}_t, F^{(j)}_t\\}, \\quad v^{(j)}_t(\\mathcal{I}_t) = \\max_{a^{(j)}_{t+1}} \\mathbb{E}[v^{(j)}_{t+1}(\\mathcal{I}_{t+1})|\\mathcal{I}_t]",
      "type": "递推",
      "variables_refs": [
        "V8",
        "V3",
        "V4",
        "V7",
        "V10"
      ],
      "derivation_trace": "Q3（2）序贯信息更新下的值函数递推，等价于完美回忆随机博弈的子博弈精炼均衡。",
      "sub_question_binding": "Q3"
    },
    {
      "equation_id": "E6",
      "latex": "\\pi_t(s,\\theta) = \\begin{cases} \\text{stay}, & \\theta=\\text{沙暴} \\\\ \\text{argmax}_{a} \\tilde{v}_t(s,a,\\theta), & \\text{otherwise} \\end{cases}",
      "type": "逻辑",
