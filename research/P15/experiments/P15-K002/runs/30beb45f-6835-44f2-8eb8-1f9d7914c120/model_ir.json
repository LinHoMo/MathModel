  "mechanisms": [
    {
      "mechanism_id": "M1",
      "description": "供需比定价机制：任务聚集而会员稀疏处供给不足，需要更高价格吸引会员；用局部任务密度与会员密度之比 r_i 刻画供需失衡方向。",
      "related_equations": [
        "E1"
      ],
      "sub_question_binding": "Q1"
    },
    {
      "mechanism_id": "M2",
      "description": "完成概率的效用机制：会员按净收益（价格减去距离成本与竞争成本）决定是否领取，净收益的线性指数化引出逻辑回归形式。",
      "related_equations": [
        "E2"
      ],
      "sub_question_binding": "Q1"
    },
    {
      "mechanism_id": "M3",
      "description": "预算内边际优化机制：新增单位预算应投放到完成概率提升最大的任务上，构成背包式的边际排序求解。",
      "related_equations": [
        "E3",
        "E4"
      ],
      "sub_question_binding": "Q2"
    },
    {
      "mechanism_id": "M4",
      "description": "打包去内耗机制：位置集中的任务互相竞争压低各自完成率，聚类打包后会员一次领取一组，竞争转为一组一单，提升完成概率。",
      "related_equations": [
        "E5"
      ],
      "sub_question_binding": "Q3"
    },
    {
      "mechanism_id": "M5",
      "description": "外推预测机制：假设会员行为跨项目稳定，将附件一估计的系数直接用于附件三新任务，实现定价方案外推与效果评价。",
      "related_equations": [
        "E6"
      ],
      "sub_question_binding": "Q4"
    }
  ],
  "equations": [
    {
      "equation_id": "E1",
      "latex": "r_i = \\frac{\\rho_t(u_i)}{\\rho_m(u_i)}",
      "type": "代数",
      "variables_refs": [
        "V6",
        "V7",
        "V14"
      ],
      "derivation_trace": "由核密度估计的局部任务数除以局部会员数，刻画局部供需比；带宽 h 控制平滑尺度。",
      "sub_question_binding": "Q1"
    },
    {
      "equation_id": "E2",
      "latex": "\\ln\\frac{\\pi_i}{1-\\pi_i} = \\beta_0 + \\beta_1 p_i + \\beta_2 d_i + \\beta_3 n_i^{cmp}",
      "type": "代数",
      "variables_refs": [
        "V1",
        "V3",
        "V8",
        "V9"
      ],
      "derivation_trace": "会员净效用 u=\\alpha_1 p-\\alpha_2 d-\\alpha_3 n^{cmp}+\\varepsilon，\\varepsilon 服从逻辑分布时选择概率即逻辑函数；极大似然估计系数。",
      "sub_question_binding": "Q1"
    },
    {
      "equation_id": "E3",
      "latex": "R(p') = \\frac{1}{N}\\sum_{i=1}^{N} \\pi_i(p_i')",
      "type": "代数",
      "variables_refs": [
        "V3",
        "V13"
      ],
      "derivation_trace": "完成率为各任务预测完成概率的算术平均，作为方案比较的标量指标。",
      "sub_question_binding": "Q2"
    },
    {
      "equation_id": "E4",
      "latex": "\\max_{p'} R(p') \\quad \\text{s.t.} \\quad \\sum_i p_i' \\le B,\\ p_{\\min}\\le p_i'\\le p_{\\max}",
      "type": "代数",
      "variables_refs": [
        "V1",
        "V13"
      ],
      "derivation_trace": "将定价再设计写为预算约束下的完成率最大化问题；采用边际收益排序近似最优。",
      "sub_question_binding": "Q2"
    },
    {
      "equation_id": "E5",
      "latex": "\\pi_k = \\sigma(\\gamma_0 + \\gamma_1 q_k + \\gamma_2 n_k^{mem})",
      "type": "代数",
      "variables_refs": [
        "V3",
        "V11"
      ],
      "derivation_trace": "打包组被视为单个复合任务，完成概率取决于组价与组周边会员数 n_k^{mem}；系数由打包后历史类比校准。",
      "sub_question_binding": "Q3"
    },
    {
      "equation_id": "E6",
      "latex": "w_j = \\mathrm{clip}(\\beta_1^{-1}(\\log\\frac{\\bar{\\pi}}{1-\\bar{\\pi}} - \\beta_0 - \\beta_2 d_j - \\beta_3 n_j^{cmp}),\\ p_{\\min}, p_{\\max})",
      "type": "代数",
      "variables_refs": [
        "V8",
        "V9",
        "V12"
      ],
      "derivation_trace": "给定目标完成率 \\bar{\\pi}，由 E2 反解所需定价，再投影到可行区间；对附件三每个新任务求建议价。",
      "sub_question_binding": "Q4"
    }
  ],
