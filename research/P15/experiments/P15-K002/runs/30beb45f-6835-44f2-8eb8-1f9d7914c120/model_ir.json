{
  "ir_version": "1.0",
  "model_id": "M-30beb45f",
  "model_family": {
    "primary": "statistical_modeling",
    "secondary": [
      "optimization",
      "clustering"
    ],
    "description": "以统计建模刻画任务定价与完成概率之间的定量关系，再叠加优化决策与空间聚类形成闭环定价方案。",
    "candidates": [
      {
        "family": "statistical_modeling",
        "rationale": "定价规律与任务是否完成属于观测数据驱动的回归/分类问题，多元回归与逻辑回归可直接拟合且系数可解释，能同时回答定价规律与未完成原因两类推断性问题，故选为主模型族。"
      },
      {
        "family": "optimization",
        "rationale": "新定价方案本质是在预算与供需约束下最大化完成率的决策问题，适合作为定价再设计的优化层；但单独使用缺乏对未完成原因的机制解释，故作为次要结构。"
      },
      {
        "family": "clustering",
        "rationale": "任务打包需要依据位置集中度识别空间簇，聚类可提供打包单元；但聚类只解决分组不解决定价水平，故作为辅助结构。"
      },
      {
        "family": "decision_analysis",
        "rationale": "会员是否接单可用效用函数刻画，但参数依赖主观设定，缺乏数据支撑时不如统计拟合直接，故排除为主模型。"
      }
    ]
  },
  "problem_binding": {
    "problem_id": "2017_B",
    "sub_question_id": "Q1,Q2,Q3,Q4",
    "problem_sha256": "1ee25170116df366bccb7d3b391dc0f93d5970541c7012ca69a2c5f3a11a9a38"
  },
  "assumptions": [
    {
      "assumption_id": "A1",
      "text": "会员是否完成某任务仅由任务定价、任务与会员的距离、周边任务竞争程度决定，会员行为可加总为完成概率。",
      "type": "mechanism_assumption",
      "rationale": "题面强调位置、定价与完成情况三个维度，逻辑回归以概率形式加总个体选择，误差主要来自未观测的会员偏好异质性，量级约为残差方差。"
    },
    {
      "assumption_id": "A2",
      "text": "任务完成状态相互独立，给定特征后各任务完成与否服从伯努利分布。",
      "type": "simplification",
      "rationale": "忽略同一会员领取多任务的相依性；当任务数量大、会员多时相关性稀释，偏差有限。"
    },
    {
      "assumption_id": "A3",
      "text": "会员密度与任务密度通过核密度估计在连续空间上光滑变化。",
      "type": "projection",
      "rationale": "附件仅给离散坐标，核密度把离散点投影为连续场，带宽选择影响平滑度但不改变供需对比方向。"
    },
    {
      "assumption_id": "A4",
      "text": "新方案的总预算与原方案预算基本持平，平台不追加额外投入。",
      "type": "calibration",
      "rationale": "比较新旧方案需在相同资源约束下进行，预算锚定原方案总价，偏差可通过对预算的灵敏度分析覆盖。"
    },
    {
      "assumption_id": "A5",
      "text": "打包任务组内的任务同时发布，会员一次领取一组，组内不再产生竞争内耗。",
      "type": "mechanism",
      "rationale": "题面指出位置集中导致争相选择，打包正是消除内耗的机制；忽略打包后组内任务的二次挑选，影响为打包收益的高估上界。"
    }
  ],
