  "assumptions": [
    {
      "assumption_id": "A1",
      "text": "警车在道路网络上按最短路径行驶，速度恒为 60 km/h，不考虑红绿灯与拥堵。",
      "type": "simplification",
      "rationale": "题面给定时速 60km/h，最短路径假设给出可达性的乐观估计，误差约 10%~20%。"
    },
    {
      "assumption_id": "A2",
      "text": "平台工作量用其管辖范围内的节点数与案件权重之和度量，案件在节点上等概率发生。",
      "type": "projection",
      "rationale": "缺乏案件分布数据时以节点权重近似，是衡量工作量均衡的合理代理。"
    },
    {
      "assumption_id": "A3",
      "text": "一个平台的警力最多封锁一个路口，封锁任务不可拆分。",
      "type": "mechanism",
      "rationale": "题面明确给出该限制，作为指派问题的硬约束。"
    },
    {
      "assumption_id": "A4",
      "text": "围堵嫌疑犯时，嫌疑车辆沿最短路径逃跑，速度与警车相同，围堵要求警车先于嫌疑犯到达关键节点。",
      "type": "mechanism_assumption",
      "rationale": "在无进一步信息时，等速最短路径逃跑是最小保守假设。"
    },
    {
      "assumption_id": "A5",
      "text": "新增平台设置在与现有平台相同的候选节点集合上，且不改变道路网络结构。",
      "type": "simplification",
      "rationale": "平台只能设在路口节点，选址搜索限定在现有节点集，符合实际可实施性。"
    },
    {
      "assumption_id": "A6",
      "text": "六区方案合理性用平台密度、平均出警时间与覆盖率的统计指标评价。",
      "type": "calibration",
      "rationale": "合理性是多维概念，用可计算的统计指标量化便于比较与改进。"
    }
  ],
