    {
      "equation_id": "E4",
      "latex": "L_q = \\frac{(m\\rho)^m \\rho}{m!(1-\\rho)^2} P_0, \\quad P_0 = \\left[\\sum_{k=0}^{m-1}\\frac{(m\\rho)^k}{k!} + \\frac{(m\\rho)^m}{m!(1-\\rho)}\\right]^{-1}, \\quad \\rho = \\frac{\\lambda_p}{m\\mu_s}",
