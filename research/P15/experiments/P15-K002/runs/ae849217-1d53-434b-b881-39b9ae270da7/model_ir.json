  "assumptions": [
    {
      "assumption_id": "A1",
      "text": "司机是风险中性的，只比较排队等待载客与放空返回两种行动的期望净收益。",
      "type": "simplification",
      "rationale": "个体风险偏好异质性难以观测，期望值比较是行业通行做法；对多数司机而言误差量级低于单趟收益的5%。"
    },
    {
      "assumption_id": "A2",
      "text": "单位时段内抵达乘客数与抵达航班数近似满足线性关系，比例系数随季节与时段变化。",
      "type": "projection",
      "rationale": "航班载客率与打车比例的乘积在短时段内相对稳定，线性投影足以刻画小时级变化规律。"
    },
    {
      "assumption_id": "A3",
      "text": "蓄车池排队近似为确定性的先来先服务队列，等待时间等于排队车辆数除以放行率。",
      "type": "mechanism_assumption",
      "rationale": "放行过程由管理人员分批定量控制，随机波动远小于均值，确定性近似误差在分钟量级。"
    },
    {
      "assumption_id": "A4",
      "text": "乘车区服务一位乘客的时间近似恒定，且与上车点数量、车道布局无关。",
      "type": "simplification",
      "rationale": "乘客携带行李、上下车动作时间差异有限，常数服务时间使排队模型可解析求解。"
    },
    {
      "assumption_id": "A5",
      "text": "短途载客采用固定里程阈值界定，低于阈值的行程视为短途。",
      "type": "calibration",
      "rationale": "阈值根据城市出租车运价结构中的起步里程确定，可由当地计费规则校准。"
    },
    {
      "assumption_id": "A6",
      "text": "司机不能拒载，目的地远近服从机场到市区的距离分布，可统计得到里程分布密度。",
      "type": "mechanism",
      "rationale": "题面明确司机不能选择乘客，故收益不确定性完全由里程分布刻画。"
    }
  ],
