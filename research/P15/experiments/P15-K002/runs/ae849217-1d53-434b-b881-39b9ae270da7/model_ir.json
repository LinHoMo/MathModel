    "candidates": [
      {
        "family": "decision_analysis",
        "rationale": "问题1的本质是司机在排队等待载客与放空返回两个离散行动之间的选择，期望收益比较可直接给出阈值型选择策略，机理清晰、可解释性强，故选为主模型族。"
      },
      {
        "family": "queueing_theory",
        "rationale": "能够精确刻画蓄车池与乘车区的随机排队过程，是等待时间与队长估计的强有力工具，但作为主框架难以覆盖问题4的收益均衡调度，故列为辅助模型族。"
      },
      {
        "family": "simulation",
        "rationale": "可以刻画航班波动、乘客到达随机性等复杂因素，但需要大量分布假设且难以给出解析形式的策略，仅用于验证环节，不选为主模型族。"
      }
    ]
  },
