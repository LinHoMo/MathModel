  "equations": [
    {
      "equation_id": "E1",
      "latex": "U_q = \\bar r_d - c_w W - \\gamma \\sigma_d,\\quad U_e = \\bar r_d^{city} - c_e l_e - \\gamma \\sigma_e",
      "type": "代数",
      "variables_refs": [
