  },
  "assumptions": [
    {
      "assumption_id": "A1",
      "text": "司机是期望效用最大化者，效用由收入、等待时间与空驶风险构成，风险厌恶用凹效用函数刻画。",
      "type": "mechanism",
      "rationale": "题面强调‘司机的决策与其个人经验判断有关’，期望效用比期望收益更贴合经验判断的保守性。"
    },
    {
      "assumption_id": "A2",
      "text": "航班到达时段可观测，司机对等待时间的预期基于当前队长与历史经验形成。",
      "type": "projection",
      "rationale": "题面明确航班数与蓄车池车辆数是可观测确定信息，经验判断投影为对等待时间的点估计。"
    },
    {
      "assumption_id": "A3",
      "text": "乘客与出租车到达在小时段内近似泊松。",
      "type": "simplification",
      "rationale": "分段平稳使等待时间可计算，偏离程度由时段粒度控制。"
    },
    {
      "assumption_id": "A4",
      "text": "Q4 中短途优先权不改变司机的载客里程分布，只改变排队顺序。",
      "type": "mechanism_assumption",
      "rationale": "优先权设计目标是收益均衡而非改变需求结构，此假设使收益均衡问题可解。"
    },
    {
      "assumption_id": "A5",
      "text": "机场管理方可无成本地观测并执行优先权排队（电子叫号系统）。",
      "type": "simplification",
      "rationale": "现代机场具备电子调度能力，执行成本可忽略。"
    }
  ],
