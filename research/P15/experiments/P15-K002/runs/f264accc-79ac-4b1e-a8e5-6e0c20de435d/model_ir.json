  "equations": [
    {
      "equation_id": "E1",
      "latex": "\\text{服务循环}_j = \\tau_m(\\text{当前位}, j) + \\tau_l(j) + \\tau_p^{(1)} + \\tau_l(j) + \\tau_c",
      "type": "代数",
      "variables_refs": [
        "V5",
        "V6",
        "V7",
        "V8"
      ],
      "derivation_trace": "单台 CNC 的一趟完整服务周期，用于估算理论产量上界。",
      "sub_question_binding": "Q1"
    },
    {
      "equation_id": "E2",
      "latex": "N_{ub} = \\left\\lfloor \\frac{T_s}{\\min_j (\\text{服务循环}_j / 8 \\text{的负载均衡})} \\right\\rfloor",
      "type": "代数",
      "variables_refs": [
        "V4",
        "V5",
        "V6",
        "V7",
        "V8"
      ],
      "derivation_trace": "产量上界由 8 台并行机的平均服务节拍给出，用于判定策略优劣。",
      "sub_question_binding": "Q1"
    },
    {
      "equation_id": "E3",
      "latex": "\\text{完成时间}_i = \\text{第一道完成}_i + \\tau_m + \\tau_l + \\tau_p^{(2a)} + \\tau_l + \\tau_c",
      "type": "代数",
      "variables_refs": [
        "V6",
        "V7",
        "V8"
      ],
      "derivation_trace": "两道工序物料完工时间 = 第一道完工 + 搬运 + 第二道加工 + 上下料 + 清洗。",
      "sub_question_binding": "Q2"
    },
    {
      "equation_id": "E4",
      "latex": "\\xi_j \\sim \\text{Bernoulli}(\\pi_f) \\text{ 每次加工}，\\ \\tau_r \\sim U(10,20)\\text{ min}",
      "type": "逻辑",
      "variables_refs": [
        "V9",
        "V10"
      ],
      "derivation_trace": "故障发生与排除时间的随机模型，注入调度推进过程。",
      "sub_question_binding": "Q3"
    },
    {
      "equation_id": "E5",
      "latex": "\\eta_j = \\frac{\\text{第 j 台加工总时长}}{T_s}, \\quad N = \\sum_j n_j",
