  "model_family": {
    "primary": "optimization",
    "secondary": [
      "simulation",
      "dynamic_programming"
    ],
    "description": "以调度优化为核心的建模框架：将 RGV 上下料与 CNC 加工表述为单服务资源-并行机器的调度问题，用贪心-优先级策略求近优解，仿真用于策略评估。",
    "candidates": [
      {
        "family": "optimization",
        "rationale": "系统效率由 RGV 服务序列与 CNC 加工节奏共同决定，目标（产量最大、完工时间最小）与约束（单 RGV、工序顺序、清洗）构成典型调度优化问题，故选为主模型族。"
      },
      {
        "family": "simulation",
        "rationale": "故障随机性与动态事件适合仿真刻画，但仿真本身不生成策略，作为策略评估层列为辅助。"
      },
      {
        "family": "dynamic_programming",
        "rationale": "小规模问题可用递推求最优服务序，但状态含各 CNC 剩余加工时间，维度随班次增长爆炸，仅适用于简化情形。"
      },
      {
        "family": "markov_decision_process",
        "rationale": "故障可建模为马尔可夫状态，但确定性班次优化目标更直接，不选为主。"
      }
    ]
  },
