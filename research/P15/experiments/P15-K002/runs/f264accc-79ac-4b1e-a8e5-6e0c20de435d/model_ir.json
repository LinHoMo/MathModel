  "assumptions": [
    {
      "assumption_id": "A1",
      "text": "物料连续到达，上料传送带不构成瓶颈；RGV 一次搬运一个物料。",
      "type": "simplification",
      "rationale": "题面未给出传送带节拍，假设其不约束系统，误差体现在极端高负荷下的乐观估计。"
    },
    {
      "assumption_id": "A2",
      "text": "RGV 移动、上下料、清洗时间由表 1 给定且固定，不随班次变化。",
      "type": "mechanism",
      "rationale": "表 1 给出三组确定性参数，作为调度模型的输入常量。"
    },
    {
      "assumption_id": "A3",
      "text": "一道工序物料可在任意一台空闲 CNC 加工；两道工序物料先由一台 CNC 完成第一道再转另一台完成第二道。",
      "type": "mechanism",
      "rationale": "题面描述的两道工序约束，作为工序指派限制。"
    },
    {
      "assumption_id": "A4",
      "text": "CNC 故障按 1% 概率逐次加工独立发生，排除时间在 10~20 分钟均匀分布，故障物料报废。",
      "type": "projection",
      "rationale": "题面给出故障概率与排除时间区间，均匀分布是最大熵假设。"
    },
    {
      "assumption_id": "A5",
      "text": "每班次连续作业 8 小时，班次开始时系统空载。",
      "type": "calibration",
      "rationale": "题面规定班次时长，空载起始便于结果口径统一。"
    },
    {
      "assumption_id": "A6",
      "text": "清洗作业在上下料时顺带完成，不计额外等待；RGV 在空闲时停在最后服务位置。",
      "type": "simplification",
      "rationale": "清洗与上下料时间叠加处理，简化事件流；停靠位置影响下一趟移动时间，纳入策略考量。"
    }
  ],
