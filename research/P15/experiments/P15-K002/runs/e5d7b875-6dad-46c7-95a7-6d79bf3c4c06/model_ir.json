  "mechanisms": [
    {
      "mechanism_id": "M1",
      "description": "排队网络机理：乘客到达（M/M/c）驱动乘车区服务，车辆服务完成进入市区循环，蓄车池队长是司机决策的可观测信号，排队稳态关系连接供需。",
      "related_equations": [
        "E1",
        "E2",
        "E3"
      ],
      "sub_question_binding": [
        "Q1",
        "Q2"
      ]
    },
    {
      "mechanism_id": "M2",
      "description": "多服务台机理：双车道乘车区 = c=2 并行服务台，服务台数与服务率共同决定系统容量与队长，上车点优化即服务台配置优化。",
      "related_equations": [
        "E4"
      ],
      "sub_question_binding": "Q3"
    },
    {
      "mechanism_id": "M3",
      "description": "优先级排队机理：短途返场司机进入高优先级队列，其期望等待 W_pri < W_ord，从而补偿短途低收益，降低整体收益离散度。",
      "related_equations": [
        "E5",
        "E6"
      ],
      "sub_question_binding": "Q4"
    },
    {
      "mechanism_id": "M4",
      "description": "收益比较机理：司机在排队净收益与返回净收益间选择，排队净收益 = 平均载客收入 − 等待机会成本。",
      "related_equations": [
        "E3"
      ],
      "sub_question_binding": [
        "Q1",
        "Q2"
      ]
    }
  ],
