  "assumptions": [
    {
      "assumption_id": "A1",
      "text": "分时段平稳：航班到达为泊松过程（时段内速率恒定），乘客打车率恒定，蓄车池与乘车区构成稳态排队系统。",
      "type": "projection",
      "rationale": "题面提示分时段可观测信息；泊松到达是排队论标准假设，时段内非平稳并入分段参数。"
    },
    {
      "assumption_id": "A2",
      "text": "蓄车池队列为 FCFS 单队列，乘客按先后顺序乘车；乘车区双车道为 c 个并行服务台。",
      "type": "mechanism",
      "rationale": "题面“先来后到排队进场载客”“按先后顺序乘车”与“两条并行车道”。"
    },
    {
      "assumption_id": "A3",
      "text": "服务时间（上车+发车）分布由上车点设置决定，均值为 1/μ_s；司机载客返回市区后以固定概率（由里程分布）再次排队。",
      "type": "mechanism_assumption",
      "rationale": "闭合循环需要返回概率；由载客里程与短途比例校准。"
    },
    {
      "assumption_id": "A4",
      "text": "Q4 短途优先权以两级优先级排队实现：短途返场司机进入高优先级队列，采用抢占式或非抢占式优先服务。",
      "type": "mechanism_assumption",
      "rationale": "题面“给予一定优先权”；两级优先级是可控可实现机制，优先级度以阈值参数调节。"
    },
    {
      "assumption_id": "A5",
      "text": "司机风险中性，决策由期望净收益比较驱动；等待时间取排队稳态均值。",
      "type": "projection",
      "rationale": "决策分析标准假设，风险偏好为二阶修正。"
    }
  ],
