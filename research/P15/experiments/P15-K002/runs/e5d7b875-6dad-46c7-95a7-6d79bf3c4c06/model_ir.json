    "candidates": [
      {
        "family": "queueing_theory",
        "rationale": "选择：系统核心是车辆与乘客的排队-服务-再排队循环，等待时间与队长是全部决策与效率指标的基础，排队论给出稳态解析关系。"
      },
      {
        "family": "optimization",
