  },
  "assumptions": [
    {
      "assumption_id": "A1",
      "text": "RGV 每次只处理一台 CNC 的一个动作（上下料/清洗），动作不可中断。",
      "type": "mechanism",
      "rationale": "题面 RGV 单机械手设定，串行服务。"
    },
    {
      "assumption_id": "A2",
      "text": "CNC 完成加工后进入等待清洗状态，RGV 到场才清洗；清洗完成后立刻可装新料。",
      "type": "mechanism",
      "rationale": "题面工序流程：加工→清洗→上下料→再加工。"
    },
    {
      "assumption_id": "A3",
      "text": "无故障情形（Q1）下系统确定性运行；故障（Q2）以 1% 概率独立发生。",
      "type": "calibration",
      "rationale": "题面给定故障概率 1%，作为随机事件参数。"
    },
    {
      "assumption_id": "A4",
      "text": "RGV 在轨道上匀速往返，移动时间按单位距离线性；交换加工件时 CNC 换刀时间已含在节拍中。",
      "type": "simplification",
      "rationale": "题面给出各移动距离对应时间表，线性关系成立。"
    },
    {
      "assumption_id": "A5",
      "text": "故障修复后系统恢复运行，修复时长不计入考核产量时间窗。",
      "type": "mechanism_assumption",
      "rationale": "题面未给修复时长，假设修复立即完成，作为保守偏乐观处理。"
    }
  ],
