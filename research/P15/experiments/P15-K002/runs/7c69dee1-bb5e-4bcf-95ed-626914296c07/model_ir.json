    {
      "equation_id": "E3",
      "latex": "V_k(s) = \\max_a \\mathbb E_{\\xi}\\big[ N_{prod}(a) + V_{k+1}(\\Phi(s,a,\\xi)) \\big],\\quad Pr(\\xi)=0.01",
      "type": "递推",
      "variables_refs": [
        "V4",
        "V5",
        "V7"
      ],
      "derivation_trace": "故障随机性进入期望；故障发生后状态修正并继续递推。",
      "sub_question_binding": "Q2"
    },
    {
      "equation_id": "E4",
      "latex": "T_{cycle} = \\max\\big(T_1, T_2\\big),\\quad T_j = \\frac{8}{4} t_{proc,j} + t_{wash,j} + t_{load} + \\frac{t_{move}}{4} \\ \\text{（理想节拍）}",
      "type": "代数",
      "variables_refs": [
