    ],
    "description": "把 RGV 调度表达为按事件推进的动态规划：RGV 位置与各 CNC 状态构成系统状态，动作决策最小化等待与空驶，故障情形扩展为带随机事件的马尔可夫决策过程。",
    "candidates": [
      {
        "family": "dynamic_programming",
        "rationale": "系统按离散事件推进，RGV 每次决策产生状态转移，价值递推可在事件序列上给出最优动作序列，故选为主模型族。"
      },
      {
        "family": "optimization",
        "rationale": "静态班次计划可写成整数规划，但加工完成时刻随机、需在线调整，规划仅用于初始调度。"
      },
      {
        "family": "markov_decision_process",
        "rationale": "故障（RGV/CNC 各 1%）是随机事件，在线调度本质为 MDP，作为 Q2 的扩展层。"
      },
      {
        "family": "simulation",
        "rationale": "离散事件仿真用于验证调度策略的统计表现（产量分布），作为验证手段。"
      }
    ]
  },
  "problem_binding": {
    "problem_id": "2018_B",
    "sub_question_id": "Q1,Q2,Q3,Q4",
