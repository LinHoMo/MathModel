    {
      "equation_id": "E2",
      "latex": "V_k(s) = \\max_{a} \\big[ N_{prod}(a) + V_{k+1}(\\Phi(s,a)) \\big],\\quad a \\in \\text{候选服务集}",
      "type": "递推",
      "variables_refs": [
