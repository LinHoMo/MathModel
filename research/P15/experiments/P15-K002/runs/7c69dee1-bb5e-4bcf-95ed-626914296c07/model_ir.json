      "sub_question_binding": "Q1"
    },
    {
      "mechanism_id": "M2",
      "description": "服务资格机制：CNC 只有在‘等待清洗’或‘空闲待上料’时才需要 RGV；RGV 空闲时选择下一个服务对象，形成排队调度。",
      "related_equations": [
        "E2"
      ],
      "sub_question_binding": "Q1"
    },
    {
      "mechanism_id": "M3",
      "description": "期望折现机制：故障事件以 1% 概率发生，策略按期望产量最优，故障后立即重调度。",
      "related_equations": [
        "E3"
      ],
      "sub_question_binding": "Q2"
    },
    {
      "mechanism_id": "M4",
      "description": "产线串行机制：两道工序时工序 1 产量约束工序 2 的原料供给，瓶颈工序决定整线节拍。",
      "related_equations": [
        "E4"
      ],
      "sub_question_binding": "Q4"
    }
  ],
  "equations": [
    {
      "equation_id": "E1",
      "latex": "s_{k+1} = \\Phi(s_k, a_k, e_k),\\quad e_k \\in \\{\\text{加工完成, 移动完成, 故障}\\}",
      "type": "递推",
