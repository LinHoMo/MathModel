  "mechanisms": [
    {
      "mechanism_id": "M1",
      "description": "傅里叶导热机制：高温环境通过外层织物向皮肤逐层导热，热扩散率 α=k/(ρc) 决定温度波前推进速度。",
      "related_equations": [
        "E1"
      ],
      "sub_question_binding": "Q1"
    },
    {
      "mechanism_id": "M2",
      "description": "表面对流换热机制：外表面与环境间以对流换热交换热量，换热系数决定进入服装的热流强度。",
      "related_equations": [
        "E2"
      ],
      "sub_question_binding": "Q1"
    },
    {
      "mechanism_id": "M3",
      "description": "层间连续机制：各层界面温度连续、热流连续（无接触热阻或等效处理），IV 空气层按等效导热参与。",
      "related_equations": [
        "E3"
      ],
      "sub_question_binding": "Q1"
    },
    {
      "mechanism_id": "M4",
      "description": "厚度-热阻机制：增加 II 层厚度提高热阻、延缓皮肤升温，但边际递减；Q2/Q3 在约束下找最小可行厚度。",
      "related_equations": [
        "E4"
      ],
      "sub_question_binding": "Q2"
    },
    {
      "mechanism_id": "M5",
      "description": "空气层隔热机制：IV 层厚度增大提高总热阻但存在自然对流增强的临界厚度，Q3 需联合优化 II 与 IV。",
      "related_equations": [
        "E4"
      ],
      "sub_question_binding": "Q3"
    }
  ],
  "equations": [
    {
      "equation_id": "E1",
      "latex": "\\rho_i c_i \\frac{\\partial T}{\\partial t} = \\frac{\\partial}{\\partial x}\\Big(k_i \\frac{\\partial T}{\\partial x}\\Big),\\quad x\\in (x_{i-1},x_i)",
      "type": "微分",
      "variables_refs": [
        "V1",
        "V2",
        "V3"
      ],
      "derivation_trace": "能量守恒 + 傅里叶定律；每层材料物性不同，分片常数。",
      "sub_question_binding": "Q1"
    },
    {
      "equation_id": "E2",
      "latex": "-k_1 \\frac{\\partial T}{\\partial x}\\Big|_{x=0} = h_{conv}(T_{amb}-T(0,t))",
      "type": "微分",
      "variables_refs": [
        "V1"
      ],
      "derivation_trace": "外表面第三类边界条件；h_conv 由附件 2 测量温度反演校准。",
      "sub_question_binding": "Q1"
    },
    {
      "equation_id": "E3",
      "latex": "T(x_i^-,t)=T(x_i^+,t),\\quad k_i\\partial_x T|_{x_i^-}=k_{i+1}\\partial_x T|_{x_i^+}",
      "type": "代数",
      "variables_refs": [
        "V1"
      ],
      "derivation_trace": "层界面温度与热流连续；内边界 T(L,t) 即皮肤外侧温度输出 T_s(t)。",
      "sub_question_binding": "Q1"
    },
    {
      "equation_id": "E4",
      "latex": "R_{tot} = \\sum_i \\frac{d_i}{k_i} + \\frac{1}{h_{conv}},\\quad \\text{稳态近似 } T_s \\approx T_{skin} + (T_{amb}-T_{skin})\\frac{R_{inner}}{R_{tot}}",
      "type": "代数",
      "variables_refs": [
        "V5",
        "V6"
      ],
      "derivation_trace": "热阻网络近似给出厚度-温度单调关系，作为优化初值与机理解释；精确值由瞬态 PDE 求解。",
      "sub_question_binding": "Q2"
    }
  ],
