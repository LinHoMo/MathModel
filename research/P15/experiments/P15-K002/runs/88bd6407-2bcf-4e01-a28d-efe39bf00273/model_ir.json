{
  "ir_version": "1.0",
  "model_id": "M-88bd6407",
  "model_family": {
    "primary": "heat_transfer",
    "secondary": [
      "pde",
      "numerical_optimization"
    ],
    "description": "以多层一维热传导与表面对流换热刻画服装温度场，用隐式时间推进求解温度分布，变厚度设计由数值优化给出。",
    "candidates": [
      {
        "family": "heat_transfer",
        "rationale": "题面对象是高温环境下多层织物内的温度变化，能量守恒与傅里叶导热是物理内核，热传导方程直接对应，故选为主模型族。"
      },
      {
        "family": "pde",
        "rationale": "温度分布由抛物型偏微分方程控制，作为数学表述层与 heat_transfer 互补。"
      },
      {
        "family": "numerical_optimization",
        "rationale": "Q2/Q3 的厚度设计是约束优化问题，需在传热模型之上嵌套优化求解器。"
      },
      {
        "family": "inverse_problem",
        "rationale": "若需从附件 2 反推材料参数可用反问题方法，但题面附件 1 已给参数，正问题即可，故不选为主模型。"
      },
      {
        "family": "finite_difference",
        "rationale": "差分是求解手段而非模型本身，作为求解器而非模型族。"
      }
    ]
  },
  "problem_binding": {
    "problem_id": "2018_A",
    "sub_question_id": "Q1,Q2,Q3",
    "problem_sha256": "6b4062dcd020bd6b57ea6ad3a834019c93a3f36f35fc00757b4586816936c569"
  },
  "assumptions": [
    {
      "assumption_id": "A1",
      "text": "热流沿厚度一维传播，侧向（面内）温度均匀，织物平行于皮肤。",
      "type": "simplification",
      "rationale": "服装厚度远小于面内尺度，一维假设误差在边界附近，量级小于 1℃。"
    },
    {
      "assumption_id": "A2",
      "text": "各层材料各向同性、热物性（导热系数/比热/密度）不随温度变化。",
      "type": "mechanism",
      "rationale": "附件 1 给恒定参数，温度范围 37~80℃ 内物性变化小。"
    },
    {
      "assumption_id": "A3",
      "text": "外表面与环境之间为对流换热（第三类边界），皮肤侧近似恒温 37℃。",
      "type": "mechanism",
      "rationale": "假人体内恒温 37℃，皮肤外侧作为温度输出端；外表面自然对流换热系数由校准确定。"
    },
    {
      "assumption_id": "A4",
      "text": "IV 空气层按静止空气处理，等效导热系数计辐射修正。",
      "type": "mechanism_assumption",
      "rationale": "空气层厚度小（毫米级），自然对流弱，等效导热是常用近似。"
    },
    {
      "assumption_id": "A5",
      "text": "初始时刻整个服装温度均匀为 37℃（与皮肤同温）。",
      "type": "calibration",
      "rationale": "实验开始时服装处于室温设定，取 37℃ 作为初始条件，误差随时间衰减。"
    }
  ],
