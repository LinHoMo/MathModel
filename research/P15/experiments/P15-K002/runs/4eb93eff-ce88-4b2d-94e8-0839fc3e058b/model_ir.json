{
  "ir_version": "1.0",
  "model_id": "M-4eb93eff",
  "model_family": {
    "primary": "markov_decision_process",
    "secondary": [
      "optimization"
    ],
    "description": "以RGV位置与CNC状态的组合为状态、服务决策为行动构造马尔可夫决策过程，故障以随机转移进入模型，值迭代求最优调度策略。",
    "candidates": [
      {
        "family": "markov_decision_process",
        "rationale": "CNC加工含随机故障（概率1%、排除时长随机），系统在决策时刻的状态转移具有马尔可夫性，MDP统一表达确定与随机工况；作为主结构。"
      },
      {
        "family": "optimization",
        "rationale": "确定性工况可退化为整数规划，但故障随机性使静态优化失配；MIP作为MDP的确定性对照。"
      },
      {
        "family": "simulation",
        "rationale": "离散事件仿真可评估策略但不可寻优；作为MDP策略的验证工具。"
      },
      {
        "family": "dynamic_programming",
        "rationale": "MDP在确定性转移下退化为动态规划；作为MDP求解算法的一部分。"
      }
    ]
  },
  "problem_binding": {
    "problem_id": "2018_B",
    "sub_question_id": "Q1,Q2,Q3,Q4",
    "problem_sha256": "f00ef29490cc2ef0ca87d7bf17b598ecae98021e8049addfa222649bee410152"
  },
  "assumptions": [
    {
      "assumption_id": "A1",
      "text": "决策时刻取离散事件点：任一CNC完成加工或RGV完成作业后进入下一决策时刻，系统状态满足马尔可夫性。",
      "type": "mechanism",
      "rationale": "事件驱动的状态转移使MDP状态空间有限，且决策只依赖当前状态。"
    },
    {
      "assumption_id": "A2",
      "text": "CNC加工故障以每次加工1%概率独立发生，排除时间在10-20分钟均匀分布，故障后未完成物料报废。",
      "type": "projection",
      "rationale": "题面给定；独立同分布假设使转移概率可解析表达。"
    },
    {
      "assumption_id": "A3",
      "text": "RGV单任务执行，移动时间按单位数固定，上下料时间按CNC奇偶区分，清洗时间固定。",
      "type": "calibration",
      "rationale": "题面表1给出参数；确定性耗时进入转移时间。"
    },
    {
      "assumption_id": "A4",
      "text": "两道工序物料需经两台不同CNC依次完成，半成品数量作为状态分量。",
      "type": "mechanism_assumption",
      "rationale": "题面要求；半成品状态使两工序流转可追踪。"
    },
    {
      "assumption_id": "A5",
      "text": "班次时长28800秒，初始全空闲、无在制；到达班次末未完成物料不计入产量。",
      "type": "simplification",
      "rationale": "题面规定班次；初始条件与截断口径使目标可计算。"
    },
    {
      "assumption_id": "A6",
      "text": "故障排除后CNC即刻可加入作业序列，无额外检修时间。",
      "type": "simplification",
      "rationale": "题面说明排除后即刻加入；忽略检修间隔的误差在分钟级。"
    }
  ],
