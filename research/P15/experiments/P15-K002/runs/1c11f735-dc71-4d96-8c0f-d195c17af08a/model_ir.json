  "assumptions": [
    {
      "assumption_id": "A1",
      "text": "司机到达蓄车池为泊松流，乘客到达乘车区为时变泊松流，载客服务时间指数分布。",
      "type": "mechanism_assumption",
      "rationale": "排队论的经典假设，使M/M/c公式可解析；高峰非平稳用分段平稳处理。"
    },
    {
      "assumption_id": "A2",
      "text": "放行策略为批量控制：蓄车池车辆以批次进入乘车区，批次间间隔可调。",
      "type": "mechanism",
      "rationale": "题面明确分批定量放行；批次参数是Q3优化的自由度。"
    },
    {
      "assumption_id": "A3",
      "text": "司机按可观测队列长度与预期等待做排队/空返选择，排队成本线性于等待时间。",
      "type": "projection",
      "rationale": "个体决策以排队等待为核心变量；线性成本使阈值解析可解。"
    },
    {
      "assumption_id": "A4",
      "text": "两条并行车道可视为双服务台排队网络，车道间不相互干扰。",
      "type": "simplification",
      "rationale": "将空间结构简化为服务台数，聚焦效率指标；安全约束在优化中单独施加。"
    },
    {
      "assumption_id": "A5",
      "text": "短途优先通过重排队列顺序实现，不改变服务率，只改变各司机等待时间分布。",
      "type": "mechanism_assumption",
      "rationale": "优先权本质是排队纪律（priority queue）的调整，与服务速率解耦。"
    },
    {
      "assumption_id": "A6",
      "text": "收益与行驶里程线性正比，短途阈值按城市计价规则校准。",
      "type": "calibration",
      "rationale": "用于收益均衡度量；分段计价以线性近似，误差在短途段有限。"
    }
  ],
