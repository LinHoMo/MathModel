      ]
    },
    {
      "equation_id": "E2",
      "latex": "W^* = c_f r_e / c_t;\\quad d = \\text{queue} \\iff W_q \\le W^*",
      "type": "代数",
      "variables_refs": [
        "V2",
        "V3"
      ],
      "derivation_trace": "排队/空返阈值决策",
      "sub_question_binding": [
