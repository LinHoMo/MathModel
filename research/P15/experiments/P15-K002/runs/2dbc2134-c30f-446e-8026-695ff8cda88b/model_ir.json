        "Q2"
      ]
    },
    {
      "equation_id": "E3",
      "latex": "\\eta = \\min(\\lambda_c, n_p \\mu)\\mathbb{1}[\\text{stable}], \\quad n_p \\le \\lfloor D_{lane}/l_s \\rfloor",
      "type": "代数",
      "variables_refs": [
        "V5",
        "V6"
      ],
      "derivation_trace": "乘车区吞吐量与容量约束",
      "sub_question_binding": "Q3"
    },
    {
      "equation_id": "E4",
      "latex": "I = \\frac{u_{long}}{u_{long}+u_{short}};\\quad \\mu_{short} = \\mu/(1-\\rho)",
