      "equation_id": "E1",
      "latex": "W_q = \\frac{C(c, \\rho_c)}{\\mu c - \\lambda_c}, \\quad \\rho_c = \\lambda_c/(\\mu c)",
      "type": "代数",
      "variables_refs": [
