    },
    {
      "assumption_id": "A4",
      "text": "玩家风险中性，最大化期望终局资金。",
      "type": "projection",
      "rationale": "标准假设，便于递推。"
    },
    {
      "assumption_id": "A5",
      "text": "Q2 天气先验取关卡历史分布，滚动时域用期望外推。",
      "type": "projection",
      "rationale": "仅知当天天气时用先验近似未来。"
    }
