    {
      "assumption_id": "A1",
      "text": "警车沿路网最短路行驶，车速恒为60km/h，即1分钟行驶1km。",
      "type": "simplification",
      "rationale": "题面给定车速；忽略红绿灯与拥堵，3分钟对应3km半径，误差偏乐观但量级一致。"
    },
    {
      "assumption_id": "A2",
      "text": "平台警力在执行任务期间不可拆分，一个平台警力最多封锁一个路口。",
      "type": "mechanism",
      "rationale": "题面明确；构成指派问题的核心约束。"
    },
    {
      "assumption_id": "A3",
      "text": "各节点发案概率近似均匀，平台工作量以管辖节点数与管辖区域权重之和度量。",
      "type": "projection",
      "rationale": "无案发率数据，用管辖负载作为工作量代理；该假设影响Q3均衡评价的方向性判断。"
    },
    {
      "assumption_id": "A4",
      "text": "嫌疑犯车速与警车相同且沿最短路逃窜，围堵要求警力先于嫌疑犯到达其必经路口。",
      "type": "mechanism_assumption",
      "rationale": "等速假设使围堵可转化为最短路到达时间比较；是Q5方案可行性的基础。"
    },
    {
      "assumption_id": "A5",
      "text": "新增平台与现有平台功能相同，可在任意非平台节点设置。",
      "type": "simplification",
      "rationale": "题面未限制候选点；在路口节点中择优，覆盖连续选址的离散近似。"
    },
    {
      "assumption_id": "A6",
      "text": "跨区道路（红色连线）与区内道路等权参与最短路计算。",
      "type": "calibration",
      "rationale": "附件数据给出全区路网；等权假设简化跨区协调，误差在长距离场景放大，需在Q4合理性讨论中修正。"
    }
