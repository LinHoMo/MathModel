{
  "ir_version": "1.0",
  "model_id": "M-ece66fa2",
  "model_family": {
    "primary": "finite_difference",
    "secondary": [
      "heat_transfer",
      "numerical_optimization"
    ],
    "description": "把多层热传导偏微分方程离散为显式/隐式差分格式，以 Crank-Nicolson 为核心的数值格式求解温度场，厚度设计问题在差分求解器上做约束搜索。",
    "candidates": [
      {
        "family": "finite_difference",
        "rationale": "偏微分方程在非均匀层状介质上需数值离散，差分格式的稳定性与精度可直接控制，故选为建模与求解的主载体。"
      },
      {
        "family": "heat_transfer",
        "rationale": "差分格式离散的对象正是传热控制方程，提供物理方程与边界条件。"
      },
      {
        "family": "numerical_optimization",
        "rationale": "Q2/Q3 厚度设计为约束优化，在差分求解器外层做搜索。"
      },
      {
        "family": "pde",
        "rationale": "方程本身是抛物型 PDE，作为问题表述层，不承担数值求解。"
      },
      {
        "family": "inverse_problem",
        "rationale": "换热系数校准可用反演，但主体是正问题求解，故不选。"
      }
    ]
  },
  "problem_binding": {
    "problem_id": "2018_A",
    "sub_question_id": "Q1,Q2,Q3",
    "problem_sha256": "6b4062dcd020bd6b57ea6ad3a834019c93a3f36f35fc00757b4586816936c569"
  },
  "assumptions": [
    {
      "assumption_id": "A1",
      "text": "一维厚度方向传热，各层材料均匀各向同性，热物性恒定。",
      "type": "simplification",
      "rationale": "附件 1 参数恒定；一维误差远小于测量误差。"
    },
    {
      "assumption_id": "A2",
      "text": "外表面为对流换热边界，皮肤侧为恒温边界（37℃）。",
      "type": "mechanism",
      "rationale": "题面实验装置为假人恒温 37℃，外表面受环境热流。"
    },
    {
      "assumption_id": "A3",
      "text": "差分格式满足稳定性条件：隐式格式无条件稳定，显式格式满足 CFL 条件。",
      "type": "mechanism",
      "rationale": "数值格式的基本要求，保证解不振荡发散。"
    },
    {
      "assumption_id": "A4",
      "text": "IV 空气层按静止空气等效导热系数处理。",
      "type": "mechanism_assumption",
      "rationale": "毫米级空气层自然对流可忽略，等效导热为常用近似。"
    },
    {
      "assumption_id": "A5",
      "text": "初始全场温度均匀为 37℃。",
      "type": "calibration",
      "rationale": "实验启动时刻服装与假人同温，初始瞬态随 t 增大衰减。"
    }
  ],
