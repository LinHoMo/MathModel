  "mechanisms": [
    {
      "mechanism_id": "M1",
      "description": "显式差分推进机制：以中心差分近似二阶空间导数、前向差分近似时间导数，按层内热扩散率逐节点更新。",
      "related_equations": [
        "E2"
      ],
      "sub_question_binding": "Q1"
    },
    {
      "mechanism_id": "M2",
      "description": "隐式加权机制：Crank-Nicolson 在 n 与 n+1 层间取时间平均，二阶精度且无条件稳定，界面与边界用单侧差分。",
      "related_equations": [
        "E3"
      ],
      "sub_question_binding": "Q1"
    },
    {
      "mechanism_id": "M3",
      "description": "界面离散机制：层界面处以能量守恒构造交界面方程（等效导热加权），保证热流连续。",
      "related_equations": [
        "E4"
      ],
      "sub_question_binding": "Q1"
    },
    {
      "mechanism_id": "M4",
      "description": "热阻扫描机制：厚度增加等效热阻增大、皮肤升温减缓，差分求解器在约束边界上搜索最小厚度。",
      "related_equations": [
        "E5"
      ],
      "sub_question_binding": "Q2"
    },
    {
      "mechanism_id": "M5",
      "description": "双变量可行域机制：II 与 IV 厚度联合决定温度响应，网格搜索后在约束边界取帕累托解。",
      "related_equations": [
        "E5"
      ],
      "sub_question_binding": "Q3"
    }
  ],
  "equations": [
    {
      "equation_id": "E1",
      "latex": "\\rho_i c_i \\partial_t T = \\partial_x(k_i \\partial_x T),\\quad i=1..4",
      "type": "微分",
      "variables_refs": [
        "V1"
      ],
      "derivation_trace": "控制方程，分片常数物性。",
      "sub_question_binding": "Q1"
    },
    {
      "equation_id": "E2",
      "latex": "T_i^{n+1} = T_i^n + r_i (T_{i-1}^n - 2T_i^n + T_{i+1}^n),\\quad r_i=\\frac{\\alpha_i\\Delta t}{\\Delta x_i^2}",
      "type": "代数",
      "variables_refs": [
        "V1",
        "V2",
        "V3"
      ],
      "derivation_trace": "显式格式 FTCS；稳定性要求 r_i≤0.5。",
      "sub_question_binding": "Q1"
    },
    {
      "equation_id": "E3",
      "latex": "-\\frac{r_i}{2}T_{i-1}^{n+1} + (1+r_i)T_i^{n+1} - \\frac{r_i}{2}T_{i+1}^{n+1} = \\frac{r_i}{2}T_{i-1}^{n} + (1-r_i)T_i^{n} + \\frac{r_i}{2}T_{i+1}^{n}",
      "type": "代数",
      "variables_refs": [
        "V1",
        "V2",
        "V3"
      ],
      "derivation_trace": "Crank-Nicolson 格式，三对角方程组 Thomas 算法求解。",
      "sub_question_binding": "Q1"
    },
    {
      "equation_id": "E4",
      "latex": "T_{i}^{n} = \\frac{k^- T_{i-1}^n + k^+ T_{i+1}^n}{k^-+k^+} \\ \\text{（界面等效）},\\quad k^\\pm=\\frac{2k_{a}k_{b}}{k_a+k_b}",
      "type": "代数",
      "variables_refs": [
        "V1"
      ],
      "derivation_trace": "界面热流连续 → 调和平均导热系数；避免虚假界面反射。",
      "sub_question_binding": "Q1"
    },
    {
      "equation_id": "E5",
      "latex": "T_s^{\\infty} \\approx T_{skin} + \\frac{T_{amb}-T_{skin}}{1+h_{conv}\\sum_i d_i/k_i} \\ \\text{（稳态近似）}",
      "type": "代数",
      "variables_refs": [
        "V4",
        "V5",
        "V6"
      ],
      "derivation_trace": "热阻网络稳态解，用于确定搜索初值与单调方向。",
      "sub_question_binding": "Q2"
    }
  ],
