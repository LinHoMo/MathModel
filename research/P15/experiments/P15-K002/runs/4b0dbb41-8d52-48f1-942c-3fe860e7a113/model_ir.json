    "candidates": [
      {
        "family": "game_theory（均衡框架）",
        "rationale": "Q3 多玩家交互的本质是博弈，均衡框架统一 Q3(1) 同时决策与 Q3(2) 序贯决策，选为最终模型。"
      },
      {
        "family": "dynamic_programming（单智能体最优控制）",
        "rationale": "Q1/Q2 单人决策退化为单智能体 DP/MDP，作为博弈框架的退化情形。"
      },
      {
        "family": "optimization（资源配置优化）",
        "rationale": "单人情形可用优化表达，但无法刻画玩家间策略互动，仅辅助。"
      },
      {
        "family": "markov_decision_process",
        "rationale": "在线天气信息下的单人决策可写为 MDP，作为 Q2 求解内核。"
      }
    ]
