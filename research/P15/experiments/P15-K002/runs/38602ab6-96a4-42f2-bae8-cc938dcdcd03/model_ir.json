    {
      "equation_id": "E2",
      "latex": "\\Pi(p) = \\sum_i \\pi_i(p_i)(B - p_i)",
      "type": "代数",
      "variables_refs": [
        "V11",
        "V5",
        "V3",
        "P3"
      ],
      "derivation_trace": "平台利润：完成任务的预算收益减去定价支出，仅完成的任务产生收支。",
      "sub_question_binding": [
