  "assumptions": [
    {
      "assumption_id": "A1",
      "text": "完成概率由逻辑回归代理：π_i = σ(β₀+β_p p_i+β_d d_i+β_ρ ρ_i+β_λ λ_i)，参数由附件一校准。",
      "type": "projection",
      "rationale": "代理模型需解析可导以支持优化；逻辑回归在完成率预测与可解释性间取得平衡。"
    },
    {
      "assumption_id": "A2",
      "text": "平台目标为利润最大化：总利润 = 完成任务的预算收益 − 定价支出；预算按任务类型固定。",
      "type": "simplification",
      "rationale": "题面未给收益结构，预算-支出差是自然目标；预算值在灵敏度中检验。"
    },
    {
      "assumption_id": "A3",
      "text": "会员可达性以最近距离与邻域会员密度刻画，会员信誉通过配额调节任务的可选人数。",
      "type": "mechanism_assumption",
      "rationale": "题面给出信誉-配额机制；将其投影为竞争强度的调节变量。"
    },
    {
      "assumption_id": "A4",
      "text": "打包：位置相近（两两距离阈值内）的任务可打包为一组，组内统一标价，组规模有上限。",
      "type": "mechanism",
      "rationale": "题面描述“位置比较集中…联合打包发布”；距离阈值与规模上限是打包的机制参数。"
    },
    {
      "assumption_id": "A5",
      "text": "附件三与附件一的任务-会员环境同分布，可外推使用附件一校准的模型。",
      "type": "projection",
      "rationale": "同平台同业务；外推风险以模拟完成率与区间报告。"
    }
  ],
