    {
      "mechanism_id": "M2",
      "description": "边际收益平衡机理：最优定价满足“提价导致的边际利润损失 = 提价带来的完成率边际收益”，由一阶条件显式给出。",
      "related_equations": [
        "E3",
        "E4"
      ],
      "sub_question_binding": "Q2"
    },
    {
      "mechanism_id": "M3",
      "description": "组合打包机理：聚类生成候选组，组级利润最大化为组定价，未打包任务保持单发，形成混合整数规划的松弛求解。",
      "related_equations": [
        "E5"
      ],
      "sub_question_binding": "Q3"
    },
    {
      "mechanism_id": "M4",
      "description": "外推-模拟机理：新项目特征代入优化器得到定价，再用蒙特卡洛抽样模拟完成情况，给出区间评价。",
      "related_equations": [
        "E6"
      ],
      "sub_question_binding": "Q4"
    }
  ],
  "equations": [
