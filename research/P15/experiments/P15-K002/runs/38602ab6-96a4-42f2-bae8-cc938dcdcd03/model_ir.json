      ]
    },
    {
      "equation_id": "E3",
      "latex": "\\frac{\\partial \\Pi_i}{\\partial p_i} = \\sigma'(\\cdot)\\beta_p (B-p_i) - \\pi_i = 0",
      "type": "代数",
      "variables_refs": [
        "V11",
        "V3",
        "V5",
        "P1",
        "P3"
      ],
      "derivation_trace": "一阶最优性条件：定价弹性与利润率平衡；解析形式 σ'=π(1-π)。",
      "sub_question_binding": "Q2"
    },
    {
      "equation_id": "E4",
      "latex": "p_i^* = \\mathrm{clip}\\Big(\\frac{1}{\\beta_p}\\ln\\frac{B-p_i^*}{p_i^*} - \\frac{\\beta_d d_i + \\beta_\\rho \\rho_i + \\beta_\\lambda \\lambda_i + \\beta_0}{\\beta_p},\\; p_{\\min}, p_{\\max}\\Big)",
      "type": "代数",
      "variables_refs": [
        "V3",
        "V6",
        "V7",
        "V8",
        "P4"
      ],
      "derivation_trace": "一阶条件反解 + 边界截断，迭代求解到不动点。",
      "sub_question_binding": "Q2"
    },
    {
      "equation_id": "E5",
      "latex": "\\Pi_g(P_g) = \\sigma(\\beta_0+\\beta_p P_g+\\beta_d\\bar d_g+\\beta_\\rho\\bar\\rho_g+\\beta_\\lambda\\bar\\lambda_g)\\,(B_g - P_g), \\quad |g|\\le K_{\\max}",
      "type": "代数",
      "variables_refs": [
        "V10",
        "V5",
        "V9",
        "P6"
      ],
      "derivation_trace": "打包组以平均特征与组定价进入利润函数，组规模约束限制组合爆炸。",
      "sub_question_binding": "Q3"
    },
    {
      "equation_id": "E6",
      "latex": "\\hat{\\Pi} = \\frac{1}{S}\\sum_{s=1}^{S}\\sum_i \\mathbb{1}[u_{i,s} \\le \\pi_i(p_i^*)]\\,(B-p_i^*), \\; u_{i,s}\\sim U[0,1]",
      "type": "代数",
      "variables_refs": [
