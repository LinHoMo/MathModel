    {
      "equation_id": "E2",
      "latex": "\\max_p \\; \\frac{1}{M}\\sum_i \\left[1-(1-q_i(p_i))^{n_i}\\right] \\quad \\text{s.t. } \\sum_i p_i \\le C_0",
      "type": "代数",
      "variables_refs": [
        "V1",
        "V4",
        "V5",
        "V6"
      ],
      "derivation_trace": "预算约束下完成率最大化规划",
      "sub_question_binding": "Q2"
    },
    {
      "equation_id": "E3",
      "latex": "R_{bundle} = \\frac{1}{|\\mathcal{G}|}\\sum_{G_k} \\left[1-(1-q_{G_k})^{n_{G_k}}\\right], \\quad q_{G_k} = \\mathrm{logit}^{-1}(\\beta_0 + \\beta_1 p_{G_k} - \\beta_2 d_{G_k}^{min})",
      "type": "代数",
      "variables_refs": [
        "V5",
        "V7",
        "V4"
      ],
      "derivation_trace": "簇级完成率聚合",
      "sub_question_binding": "Q3"
    },
    {
      "equation_id": "E4",
      "latex": "p_i^{new} = p_0 + \\alpha \\ln(\\bar{\\rho}/\\rho_i) - \\beta_2 d_i^{min}",
      "type": "代数",
      "variables_refs": [
        "V1",
        "V8"
      ],
      "derivation_trace": "空间外推定价规则",
      "sub_question_binding": "Q4"
    }
  ],
