  "assumptions": [
    {
      "assumption_id": "A1",
      "text": "龙头前把手以恒定速率1 m/s沿螺线运动，时间以固定步长离散，位置由弧长积分逐秒推进。",
      "type": "calibration",
      "rationale": "题面给定速率，固定步长满足逐秒输出要求。"
    },
    {
      "assumption_id": "A2",
      "text": "每节板凳为刚性杆，相邻把手距离恒等于板长，把手链在每步重新满足弦长约束。",
      "type": "mechanism",
      "rationale": "刚性铰链约束是位形递推的基础。"
    },
    {
      "assumption_id": "A3",
      "text": "把手速度由相邻时刻位置的中心差分估计，速度方向沿运动轨迹切向。",
      "type": "simplification",
      "rationale": "中心差分二阶精度，步长1s下速度误差可接受；切向方向由差分向量归一化。"
    },
    {
      "assumption_id": "A4",
      "text": "碰撞判据为任意非相邻板凳间距小于板宽，在离散时间点上检测并在检测到后细化。",
      "type": "simplification",
      "rationale": "离散检测配合二分细化定位终止时刻。"
    },
    {
      "assumption_id": "A5",
      "text": "调头路径两段圆弧相切且与螺线相切，龙头在圆弧段仍按弧长匀速1 m/s运动。",
      "type": "mechanism",
      "rationale": "题面限定路径与速度，运动学结构不变。"
    }
  ],
