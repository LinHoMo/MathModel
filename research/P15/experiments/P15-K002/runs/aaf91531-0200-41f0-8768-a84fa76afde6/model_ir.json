  "equations": [
    {
      "equation_id": "E1",
      "latex": "r_k = a + \\frac{p}{2\\pi}\\theta_k, \\quad \\Delta s_k = v_0 \\Delta t",
      "type": "差分",
      "variables_refs": [
        "V3",
        "V2",
        "V1"
      ],
      "derivation_trace": "螺线方程与弧长推进；θ由弧长积分反解",
      "sub_question_binding": [
        "Q1",
        "Q2"
      ]
    },
    {
      "equation_id": "E2",
      "latex": "\\|P_{i+1,k} - P_{i,k}\\| = L_i \\ \\Rightarrow \\ P_{i+1,k} = P_{i,k} + L_i \\frac{P_{i+1,k}-P_{i,k}}{\\|\\cdot\\|}",
      "type": "代数",
      "variables_refs": [
        "V4"
      ],
      "derivation_trace": "每步对每节求解弦长方程（取螺线前进方向解）",
      "sub_question_binding": [
        "Q1",
        "Q2"
      ]
    },
    {
      "equation_id": "E3",
      "latex": "v_{i,k} = \\frac{\\|P_{i,k+1} - P_{i,k-1}\\|}{2\\Delta t}",
      "type": "差分",
      "variables_refs": [
        "V5",
        "V4",
        "V1"
      ],
      "derivation_trace": "中心差分速度估计，边界步用单侧差分",
      "sub_question_binding": [
        "Q1",
        "Q4",
        "Q5"
      ]
    },
    {
      "equation_id": "E4",
      "latex": "t_{end} = \\inf\\{t: d_{min}(t) < w\\}, \\quad d_{min,k} = \\min_{i<j} \\|P_{i,k}-P_{j,k}\\|",
      "type": "逻辑",
      "variables_refs": [
        "V8",
        "V7",
        "V4"
      ],
      "derivation_trace": "离散检测+二分细分定位终止时刻",
      "sub_question_binding": "Q2"
    },
    {
      "equation_id": "E5",
      "latex": "v_{i,k} \\approx v_0 \\eta_{i,k} \\frac{r_i}{r_1}, \\quad \\eta_{i,k} = \\frac{\\dot{\\theta}_{i,k}}{\\dot{\\theta}_{1,k}}",
      "type": "代数",
      "variables_refs": [
        "V6",
        "V5"
      ],
      "derivation_trace": "极角速率比链式法则：极径越小、极角速率比越大，速度放大越强",
      "sub_question_binding": "Q5"
    },
    {
      "equation_id": "E6",
      "latex": "s_T = R_1\\alpha_1 + R_2\\alpha_2, \\quad R_1 = 2R_2",
      "type": "代数",
      "variables_refs": [
        "V9"
      ],
      "derivation_trace": "调头弧长=两段圆弧弧长和",
      "sub_question_binding": "Q4"
    }
