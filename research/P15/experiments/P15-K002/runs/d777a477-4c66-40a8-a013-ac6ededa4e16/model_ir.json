  "assumptions": [
    {
      "assumption_id": "A1",
      "text": "无故障情形下系统参数完全确定，RGV 与 CNC 无随机扰动，RGV 每次只服务一台 CNC 且服务不可中断。",
      "type": "mechanism",
      "rationale": "题面给出全部作业参数与确定性规则；RGV 单机是物理事实，是调度模型的核心机制。"
    },
    {
      "assumption_id": "A2",
      "text": "一道工序物料可在任意 CNC 完成；两道工序物料第一道与第二道必须在不同 CNC 上完成。",
      "type": "mechanism",
      "rationale": "题面第 1、2 条明确；两道工序不能同机完成是工序约束的核心。"
    },
    {
      "assumption_id": "A3",
      "text": "RGV 完成上下料后立即开始清洗作业，清洗完成后即可移动至下一目标；物料在 CNC 加工完成后等待 RGV 上下料期间占用 CNC。",
      "type": "mechanism_assumption",
      "rationale": "题面描述 RGV 自带清洗槽且完成上下料及清洗作业；占用假设使 CNC 空闲时间显式进入模型。"
    },
    {
      "assumption_id": "A4",
      "text": "Q3 故障发生概率约为 1%（按单台 CNC 加工分钟计），故障排除时间在 10~20 分钟间均匀分布，故障导致未完成物料报废。",
      "type": "projection",
      "rationale": "题面给出概率与时间范围；均匀分布是无更多信息下的最大熵选择，用于仿真抽样。"
    },
    {
      "assumption_id": "A5",
      "text": "班次连续作业 8 小时，产量统计以完成全部工序并清洗完毕的物料数计；RGV 在 8 小时末停止新任务。",
      "type": "simplification",
      "rationale": "题面规定每班次 8 小时；以完工清洗物料数为产量口径，与结果表要求一致。"
    },
    {
      "assumption_id": "A6",
      "text": "CNC 初始为空闲状态，班次开始后由 RGV 依次上料，不考虑预热等启动过程。",
      "type": "simplification",
      "rationale": "题面未给启动过程；忽略预热使模型聚焦调度规律，误差集中在班次开头数分钟。"
    }
  ],
