  "mechanisms": [
    {
      "mechanism_id": "M1",
      "description": "等待时间-收益权衡机制：排队期望收益 = 载客收入 − 等待时间成本，空驶期望收益 = 市区收入 − 空驶成本；司机选择期望收益大者，构成阈值决策。",
      "related_equations": [
        "E1",
        "E2"
      ],
      "sub_question_binding": "Q1"
    },
    {
      "mechanism_id": "M2",
      "description": "排队队长演化机制：蓄车池为 M/M/1 队列，队长与等待时间由到达率与服务率决定，航班到达高峰推高队长进而推高等待时间。",
      "related_equations": [
        "E1"
      ],
      "sub_question_binding": "Q2"
    },
    {
      "mechanism_id": "M3",
      "description": "双车道并行服务机制：乘车区双车道等价 M/M/2，上车点数量决定并行服务能力，效率与等待时间的权衡决定最优设置。",
      "related_equations": [
        "E3",
        "E4"
      ],
      "sub_question_binding": "Q3"
    },
    {
      "mechanism_id": "M4",
      "description": "短途优先权均衡机制：短途司机收益低且周转快，给予插队优先权可压缩其等待时间，使累计收益分布更均衡。",
      "related_equations": [
        "E5"
      ],
      "sub_question_binding": "Q4"
    }
  ],
  "equations": [
    {
      "equation_id": "E1",
      "latex": "W_q^t = \\frac{\\rho_t}{\\mu_t(1-\\rho_t)},\\quad \\rho_t=\\frac{\\lambda_t}{\\mu_t}",
      "type": "代数",
      "variables_refs": [
        "V4",
        "V13"
      ],
      "derivation_trace": "M/M/1 队列的平均等待时间公式，由 Pollaczek–Khinchine 公式在指数服务下退化得到。",
      "sub_question_binding": "Q1"
    },
    {
      "equation_id": "E2",
      "latex": "D^*(t)=1 \\iff r_d - c_w W_q^t(t) \\ge r_d^{city} - c_e l_e",
      "type": "逻辑",
      "variables_refs": [
        "V6",
        "V7",
        "V8"
      ],
      "derivation_trace": "排队与空驶期望收益比较；r_d^{city} 为返回市区后接单的预期收入。",
      "sub_question_binding": "Q1"
    },
    {
      "equation_id": "E3",
      "latex": "W_q^p = \\frac{C(c,\\rho_p)}{c\\mu_p - \\lambda_p},\\quad \\rho_p=\\frac{\\lambda_p}{c\\mu_p}",
      "type": "代数",
      "variables_refs": [
        "V5",
        "V9",
        "V13"
      ],
      "derivation_trace": "M/M/c 队列等待时间公式，C(c,ρ) 为 Erlang-C 概率；c=2 对应双车道。",
      "sub_question_binding": "Q3"
    },
    {
      "equation_id": "E4",
      "latex": "\\Theta(c) = \\min(\\lambda_p, c\\mu_p) = \\lambda_p(1-P_{block}(c))",
      "type": "代数",
      "variables_refs": [
        "V2",
        "V9",
        "V10"
      ],
      "derivation_trace": "系统吞吐率 = 到达率中实际被服务部分，阻塞概率由 Erlang-B/C 给出。",
      "sub_question_binding": "Q3"
    },
    {
      "equation_id": "E5",
      "latex": "G_i = \\sum_t \\left[ r_{d,t} - c_w W_{i,t} \\right],\\quad W_{i,t} = \\frac{W_q^t}{1+\\alpha\\phi_i}",
      "type": "递推",
      "variables_refs": [
        "V4",
        "V11",
        "V12"
      ],
      "derivation_trace": "司机累计收益按天累加，优先权 φ 按比例缩短有效等待时间；α 为优先权强度，由收益均衡校准。",
      "sub_question_binding": "Q4"
    }
  ],
