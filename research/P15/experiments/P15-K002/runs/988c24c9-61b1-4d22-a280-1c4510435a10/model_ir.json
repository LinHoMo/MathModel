  "assumptions": [
    {
      "assumption_id": "A1",
      "text": "出租车到达蓄车池与乘客到达乘车区的过程分别服从泊松过程，服务时间服从指数分布。",
      "type": "mechanism",
      "rationale": "到达随机性与服务随机性在小时尺度上近似无记忆，M/M 假设使等待时间有闭式解；偏离真实到达模式时可用 PH 分布扩展。"
    },
    {
      "assumption_id": "A2",
      "text": "司机的收益比较只包含等待时间成本、空驶成本与预期载客收入，忽略个人风险偏好差异。",
      "type": "simplification",
      "rationale": "题面要求综合考虑收益与乘客数量变化，期望值框架足够；个体偏好异质性作为随机项处理。"
    },
    {
      "assumption_id": "A3",
      "text": "乘客到达率随航班时刻表波动，但在一小时内近似稳定（分段平稳）。",
      "type": "projection",
      "rationale": "航班到达具有时段性，按小时分段使排队模型在每段内可解；分段边界误差可忽略。"
    },
    {
      "assumption_id": "A4",
      "text": "Q3 乘车区两条车道对称，上车点设置等价于双服务台并行服务。",
      "type": "simplification",
      "rationale": "题面给出两条并行车道，对称假设使 M/M/2 模型适用；非对称情形可退化为两独立队列。"
    },
    {
      "assumption_id": "A5",
      "text": "短途返回优先权体现为排队中的插队权限，不改变乘客需求总量。",
      "type": "mechanism_assumption",
      "rationale": "优先权只重排服务顺序不改变到达率，收益均衡通过缩短短途司机的等待时间实现。"
    }
  ],
