  "assumptions": [
    {
      "assumption_id": "A1",
      "text": "问题归结为一维半无限与有限区间混合的层状热传导定解问题，侧向热流忽略。",
      "type": "simplification",
      "rationale": "服装面内尺度远大于厚度，一维假设误差在 1% 量级。"
    },
    {
      "assumption_id": "A2",
      "text": "各层物性参数分段常数，不随温度变化。",
      "type": "mechanism",
      "rationale": "附件按常数给出物性，温度依赖效应在 20~80°C 范围内有限。"
    },
    {
      "assumption_id": "A3",
      "text": "皮肤侧为第一类（等温）边界 37°C，外表面为第三类（对流）边界。",
      "type": "mechanism",
      "rationale": "题面设定假人体温恒定，对流边界刻画环境换热，系数反演确定。"
    },
    {
      "assumption_id": "A4",
      "text": "层间理想接触，温度与热流在界面连续。",
      "type": "mechanism",
      "rationale": "接触热阻并入反演参数吸收，避免额外自由度。"
    },
    {
      "assumption_id": "A5",
      "text": "初始温度场均匀等于环境温度。",
      "type": "projection",
      "rationale": "实验前充分热平衡，初始条件为常数。"
    },
    {
      "assumption_id": "A6",
      "text": "空气层（IV 层）按纯导热处理，忽略自然对流与辐射。",
      "type": "simplification",
      "rationale": "空气层较薄时自然对流弱，等效导热系数吸收对流贡献。"
    }
  ],
