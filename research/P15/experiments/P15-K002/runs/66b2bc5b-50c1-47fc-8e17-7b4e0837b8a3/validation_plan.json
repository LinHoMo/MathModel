{
  "limit_tests": [
    {
      "test_id": "LT1",
      "description": "总热阻趋近于零时皮肤温度应逼近环境温度",
      "parameter": "R_th",
      "limit": "0",
      "expected_behavior": "u_s(t) 快速上升到接近 T_a，峰值逼近环境温度"
    },
    {
      "test_id": "LT2",
      "description": "总热阻趋近无穷时皮肤温度应保持 37°C",
      "parameter": "R_th",
      "limit": "inf",
      "expected_behavior": "u_s(t) 恒为 37°C，温升为零"
    },
    {
      "test_id": "LT3",
      "description": "环境温度等于 37°C 时系统应无热流",
      "parameter": "T_a",
      "limit": "37",
      "expected_behavior": "u(x,t) 恒为 37°C，无温升"
    },
    {
      "test_id": "LT4",
      "description": "IV 层厚度趋近零时问题退化为三层服装",
      "parameter": "d_4",
      "limit": "0",
      "expected_behavior": "皮肤温升曲线与三层模型一致"
    }
  ],
  "multi_seed": {
    "n_runs": 5,
    "seeds": [
      42,
      123,
      456,
      789,
      1024
    ],
    "aggregation": "mean_std",
    "description": "反演初值与搜索初值以多组随机数设定重复运行，报告校准参数与最优厚度的均值标准差，判定收敛到同一区域"
  },
