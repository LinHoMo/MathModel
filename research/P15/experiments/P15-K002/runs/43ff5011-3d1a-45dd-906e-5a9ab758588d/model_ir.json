  "model_family": {
    "primary": "pca",
    "secondary": [
      "clustering",
      "statistical_classification"
    ],
    "description": "以主成分分析为核心：用主成分空间统一刻画风化偏移方向、亚类结构、判别边界与成分关联载荷，降维后的得分向量作为下游分析输入。",
    "candidates": [
      {
        "family": "pca",
        "rationale": "成分数据高相关且维度较多，主成分可提取少数正交综合变量，同时揭示成分共变结构，适合同时服务四个子问题。"
      },
      {
        "family": "clustering",
        "rationale": "聚类可在主成分得分空间划分亚类，但单独使用无监督聚类无法结合风化复原与鉴别的监督信息，作为主成分下游组件。"
      },
      {
        "family": "decision_tree",
        "rationale": "决策树可解释性强但难以利用成分共变结构，且对比例数据的小扰动敏感，作为备选而非主线。"
      }
    ]
  },
  "problem_binding": {
    "problem_id": "2022_C",
    "sub_question_id": "Q1,Q2,Q3,Q4",
    "problem_sha256": "ec5e098f9dbe858e50280a7366faeb6cc0d2e7db1fd21e8fc7b3de7d85ad1709"
  },
  "assumptions": [
    {
      "assumption_id": "A1",
      "text": "成分数据的有效样品满足累加和85%至105%，主成分分析在有效样品上进行。",
      "type": "calibration",
      "rationale": "统一数据口径，避免异常累加和扭曲协方差结构。"
    },
    {
      "assumption_id": "A2",
      "text": "风化造成的成分变化主要沿少数主成分方向，即风化偏移位于低维子空间内。",
      "type": "mechanism_assumption",
      "rationale": "元素交换受配方体系约束，漂移方向由配方主导，低维性可由方差占比检验。"
    },
    {
      "assumption_id": "A3",
      "text": "主成分得分在类别内近似服从椭球分布，可用马氏距离刻画类别成员关系。",
      "type": "projection",
      "rationale": "得分分布由线性变换得到，中心极限效应使其近似椭球，马氏距离自然结合协方差结构。"
    },
    {
      "assumption_id": "A4",
      "text": "亚类在主成分得分空间中表现为紧致簇，簇数由方差解释与稳定性共同决定。",
      "type": "simplification",
      "rationale": "亚类划分以数据驱动为主，辅以成分阈值可解释性校验。"
    },
    {
      "assumption_id": "A5",
      "text": "未知样品与已知类别在主成分空间的相对位置决定其归属，载荷的正负号反映成分关联方向。",
      "type": "mechanism",
      "rationale": "载荷矩阵直接给出成分间关联与类别区分方向，是关联分析Q4的载体。"
    }
  ],
