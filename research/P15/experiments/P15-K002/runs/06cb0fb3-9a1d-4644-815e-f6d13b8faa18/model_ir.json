  },
  "assumptions": [
    {
      "assumption_id": "A1",
      "text": "每天资源消耗发生在当天行动之后，购买与卖水发生在消耗结算前（注2口径）。",
      "type": "mechanism_assumption",
      "rationale": "题面注2明确剩余资金与资源指当日消耗完毕后、购买完成后的口径；消除结算顺序歧义。"
    },
    {
      "assumption_id": "A2",
      "text": "天气全知场景下未来天气序列完全已知且确定，无随机性。",
      "type": "projection",
      "rationale": "Q1与Q3.1题面给定；确定性假设使动态规划可精确求解。"
    },
    {
      "assumption_id": "A3",
      "text": "在线场景下玩家在每天开始时仅知当日天气，未来天气按历史季节规律以先验分布估计。",
      "type": "projection",
      "rationale": "Q2题面设定；先验分布用于滚动规划中近似未来消耗，误差随关卡时长缩短而减小。"
    },
    {
      "assumption_id": "A4",
      "text": "资源按箱整数购买与消耗，水与食物的质量分别为3kg/箱与2kg/箱，负重上限1200kg。",
      "type": "simplification",
      "rationale": "题面规定最小计量单位为箱；质量参数采用附件参数表常用设定，使整数规划与动态规划状态可枚举。"
    },
    {
      "assumption_id": "A5",
      "text": "多玩家场景下同区域行为耦合仅体现在题面给出的消耗倍数与价格倍数，玩家之间无其他外部性。",
      "type": "mechanism",
      "rationale": "题面规则3为唯一耦合机制；该假设使多人问题可分解为耦合约束下的独立递推。"
    },
    {
      "assumption_id": "A6",
      "text": "到达终点即结束游戏，剩余水与食物按半价退回，退回所得计入最终资金。",
      "type": "calibration",
      "rationale": "题面规则6；终点结算规则直接进入目标函数。"
    }
  ],
