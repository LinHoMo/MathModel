{
  "ir_version": "1.0",
  "model_id": "M-06cb0fb3",
  "model_family": {
    "primary": "dynamic_programming",
    "secondary": [
      "optimization"
    ],
    "description": "以天为阶段、以位置-水-食物-资金为状态构造动态规划，递推得到不同信息结构下的最优行动策略。",
    "candidates": [
      {
        "family": "dynamic_programming",
        "rationale": "游戏按天推进、状态与决策均离散，满足无后效性（天气已知时当天决策只依赖当前状态），递推可给出全局最优策略；作为主结构。"
      },
      {
        "family": "optimization",
        "rationale": "可将全程行动一次性编码为混合整数规划，但天气与资源联动的分支数极大，且在线场景无法静态建模；仅在离线全知场景作对照。"
      },
      {
        "family": "markov_decision_process",
        "rationale": "随机天气在线场景天然适配，但本题在线决策中玩家在当天开始时已知当日天气，仍具确定性转移；MDP作为Q2的扩展视图。"
      },
      {
        "family": "game_theory",
        "rationale": "多玩家相互影响消耗与价格，理论上需纳什均衡刻画；但本题以策略构造为主，均衡作为多玩家部分的分析工具而非主结构。"
      }
    ]
  },
  "problem_binding": {
    "problem_id": "2020_B",
