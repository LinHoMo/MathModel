  "equations": [
    {
      "equation_id": "EQ1",
      "latex": "\\rho_i c_i \\frac{\\partial T}{\\partial t} = k_i \\frac{\\partial^2 T}{\\partial x^2}, \\quad x\\in\\Omega_i,\\; i=1,2,3,4",
      "type": "pde",
      "variables_refs": [
        "v_T",
        "v_x",
        "v_t"
      ],
      "derivation_trace": "由Fourier定律与能量守恒导出，i遍历I-IV层",
      "sub_question_binding": [
        "Q1"
      ]
    },
    {
      "equation_id": "EQ2",
      "latex": "-k\\frac{\\partial T}{\\partial x}\\bigg|_{x=L} = h(T(L,t)-T_{body})",
      "type": "boundary_condition",
      "variables_refs": [
        "v_Ts",
        "v_x"
      ],
      "derivation_trace": "皮肤侧对流边界（Newton冷却定律）",
      "sub_question_binding": [
        "Q1"
      ]
    }
