    {
      "mechanism_id": "M1",
      "name": "Logistic回归",
      "description": "任务完成概率由Logistic函数建模：P=1/(1+exp(-(β0+β1*price+β2*distance+β3*density)))",
      "equations_refs": [
        "EQ1"
      ],
      "sub_question_binding": [
        "Q1"
      ]
    }
  ],
  "equations": [
    {
      "equation_id": "EQ1",
      "latex": "P(y=1|x) = \\frac{1}{1+\\exp(-(\\beta_0+\\beta_1 x_{price}+\\beta_2 x_{dist}+\\beta_3 x_{dens}))}",
      "type": "logistic",
      "variables_refs": [
        "v_c",
        "v_p",
        "v_d",
        "v_m"
      ],
      "derivation_trace": "广义线性模型，连接函数为logit，假设误差服从二项分布",
      "sub_question_binding": [
        "Q1"
      ]
    },
    {
      "equation_id": "EQ2",
      "latex": "\\pi(p) = p \\cdot P_{complete}(p), \\quad p^* = \\arg\\max_{p} \\pi(p)",
      "type": "optimization",
      "variables_refs": [
        "v_prof",
        "v_popt",
        "v_c"
      ],
      "derivation_trace": "期望利润=定价×完成概率，在价格网格上搜索最优",
      "sub_question_binding": [
        "Q2"
      ]
    }
