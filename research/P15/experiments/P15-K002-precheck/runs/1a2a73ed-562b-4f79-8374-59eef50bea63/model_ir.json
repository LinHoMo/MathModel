  "solvers": [
    {"solver_id": "SOL1", "method": "逻辑回归极大似然拟合（L2 正则，5 折交叉验证选参）", "implementation_ref": "research/P15/experiments/P15-K002-precheck/code/price_logistic.py", "sub_question_binding": ["Q1", "Q4"]},
    {"solver_id": "SOL2", "method": "预算约束定价优化：拉格朗日乘子 + 网格搜索组合", "implementation_ref": "research/P15/experiments/P15-K002-precheck/code/price_optimizer.py", "sub_question_binding": ["Q2"]},
    {"solver_id": "SOL3", "method": "空间聚类打包：K-means/DBSCAN 按 r_c 聚类，包内定价合并", "implementation_ref": "research/P15/experiments/P15-K002-precheck/code/price_bundling.py", "sub_question_binding": ["Q3"]},
    {"solver_id": "SOL4", "method": "蒙特卡洛仿真：对完成概率抽样，评估完成情况分布", "implementation_ref": "research/P15/experiments/P15-K002-precheck/code/price_mc.py", "sub_question_binding": ["Q3", "Q4"]}
  ],
  "experiments": [
    {"experiment_id": "EXP1", "type": "calibration", "inputs": "附件一任务数据（位置、定价、完成标签）与附件二会员数据", "expected_outputs": "logistic 参数估计、原方案完成率与未完成原因归因", "sub_question_binding": ["Q1"]},
