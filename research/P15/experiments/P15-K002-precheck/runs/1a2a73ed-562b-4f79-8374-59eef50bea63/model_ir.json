    {"dependency_id": "DEP9", "from": "SOL1", "to": "EQ4", "type": "solver", "description": "逻辑回归求解器校准 EQ4"},
    {"dependency_id": "DEP10", "from": "SOL2", "to": "EQ7", "type": "solver", "description": "定价优化求解器执行 KKT 条件"},
