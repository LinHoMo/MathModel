  },
  "assumptions": [
    {
      "assumption_id": "A1",
      "text": "城市路网抽象为无向加权图 G=(V,E)，节点为路口，边为道路，边权为道路长度；警车以匀速 60 km/h 沿最短路行驶。",
      "type": "simplification",
      "rationale": "题目给出道路与节点数据及警车时速，图模型是响应时间计算的标准抽象。"
    },
    {
      "assumption_id": "A2",
      "text": "各平台警力配置相同，一个平台的警力最多封锁一个路口；每平台一次性出警一辆警车。",
      "type": "mechanism",
      "rationale": "题意明确平台职能与警力配备基本相同、一平台最多封锁一路口。"
    },
    {
      "assumption_id": "A3",
      "text": "节点需求权重 r_j 以案发率或节点重要性度量，题面未给出精确案发率时以节点度/出入城属性近似。",
      "type": "calibration",
      "rationale": "工作量均衡评估需要节点权重，题目数据不足处用可达结构特征近似。"
    },
    {
      "assumption_id": "A4",
      "text": "嫌疑犯车速假设与警车相同（60 km/h），接警延迟 3 分钟，逃跑沿最短路/近似最短路径。",
      "type": "projection",
      "rationale": "题目未给嫌疑犯车速，以相同速度假设给出保守围堵方案，并做速度敏感性验证。"
    },
    {
      "assumption_id": "A5",
      "text": "重大突发事件全封锁与围堵只考虑静态最短路调度，不考虑路网拥堵与信号灯延误。",
      "type": "simplification",
      "rationale": "题目数据无动态交通信息，静态最短路是可行口径。"
    },
    {
      "assumption_id": "A6",
      "text": "平台增设候选点限于现有路网节点，新增平台数在 2 至 5 之间。",
      "type": "mechanism",
      "rationale": "题意限定增 2~5 个平台，候选位置取路网节点是自然离散化。"
    }
  ],
  "variables": [
    {"variable_id": "v_edge_len", "name": "道路长度", "symbol": "L_ab", "definition": "道路 (a,b) 的长度（边权）", "unit": "km", "type": "observation", "sub_question_binding": ["Q1", "Q4", "Q5"]},
    {"variable_id": "v_time", "name": "最短出行时间", "symbol": "t_ij", "definition": "节点 i 到节点 j 的最短出行时间", "unit": "min", "type": "state", "sub_question_binding": ["Q1", "Q2", "Q4", "Q5"]},
    {"variable_id": "v_assign", "name": "管辖分配", "symbol": "x_ij", "definition": "节点 j 是否分配给平台 i（1 是 / 0 否）", "unit": "无", "type": "decision", "sub_question_binding": ["Q1", "Q3"]},
    {"variable_id": "v_assign_exit", "name": "封锁指派", "symbol": "y_ik", "definition": "平台 i 是否封锁要道出口 k（1 是 / 0 否）", "unit": "无", "type": "decision", "sub_question_binding": ["Q2"]},
    {"variable_id": "v_new_platform", "name": "增设平台指示", "symbol": "z_i", "definition": "节点 i 是否增设平台（1 是 / 0 否）", "unit": "无", "type": "decision", "sub_question_binding": ["Q3"]},
    {"variable_id": "v_workload", "name": "平台工作量", "symbol": "W_i", "definition": "平台 i 管辖节点需求权重之和", "unit": "权重单位", "type": "observation", "sub_question_binding": ["Q1", "Q3", "Q4"]},
    {"variable_id": "v_resp_j", "name": "节点响应时间", "symbol": "t_j^resp", "definition": "节点 j 被其所属平台到达的最短时间", "unit": "min", "type": "observation", "sub_question_binding": ["Q1"]},
    {"variable_id": "v_resp_max", "name": "最大响应时间", "symbol": "T_max", "definition": "全部节点响应时间的最大值", "unit": "min", "type": "observation", "sub_question_binding": ["Q1", "Q3", "Q4"]},
    {"variable_id": "v_block_max", "name": "全封锁最晚时间", "symbol": "T_block", "definition": "13 条要道全部封锁完成的最晚时刻", "unit": "min", "type": "observation", "sub_question_binding": ["Q2"]},
    {"variable_id": "v_balance", "name": "工作量均衡度", "symbol": "G", "definition": "平台工作量最大值与均值之比（失衡指标）", "unit": "无", "type": "observation", "sub_question_binding": ["Q3", "Q4"]},
    {"variable_id": "v_coverage", "name": "覆盖率", "symbol": "C", "definition": "3 分钟内可达节点数占全部节点比例", "unit": "无", "type": "observation", "sub_question_binding": ["Q1", "Q4"]},
    {"variable_id": "v_intercept", "name": "围堵完成时间", "symbol": "T_int", "definition": "围堵方案中最晚到达包围圈节点的时刻", "unit": "min", "type": "observation", "sub_question_binding": ["Q5"]},
    {"variable_id": "v_sus_time", "name": "嫌疑犯到达时间", "symbol": "t_s(e)", "definition": "嫌疑犯从案发点 32 到达出口 e 的时刻", "unit": "min", "type": "observation", "sub_question_binding": ["Q5"]},
    {"variable_id": "v_demand", "name": "节点需求权重", "symbol": "r_j", "definition": "节点 j 的需求/案发权重", "unit": "权重单位", "type": "observation", "sub_question_binding": ["Q1", "Q3", "Q4"]},
    {"variable_id": "v_speed_s", "name": "嫌疑犯车速", "symbol": "v_s", "definition": "嫌疑犯车辆行驶速度", "unit": "km/h", "type": "parameter", "sub_question_binding": ["Q5"]},
    {"variable_id": "v_n_platform", "name": "平台数量", "symbol": "n_p", "definition": "当前区域交巡警平台总数", "unit": "个", "type": "constant", "sub_question_binding": ["Q1", "Q2", "Q3", "Q4"]}
  ],
  "parameters": [
    {"parameter_id": "p_vpolice", "name": "警车时速", "symbol": "v_p", "value": 60, "source": "题目"},
    {"parameter_id": "p_rmax", "name": "响应时限", "symbol": "R_max", "value": 3, "source": "题目"},
    {"parameter_id": "p_vsus", "name": "嫌疑犯车速假设", "symbol": "v_s0", "value": 60, "source": "假设"},
    {"parameter_id": "p_delay", "name": "接警延迟", "symbol": "t_delay", "value": 3, "source": "题目"},
    {"parameter_id": "p_kmin", "name": "增设平台数下界", "symbol": "k_min", "value": 2, "source": "题目"},
    {"parameter_id": "p_kmax", "name": "增设平台数上界", "symbol": "k_max", "value": 5, "source": "题目"},
    {"parameter_id": "p_alpha", "name": "响应目标权重", "symbol": "alpha", "value": 0.5, "source": "假设"},
    {"parameter_id": "p_beta", "name": "均衡目标权重", "symbol": "beta", "value": 0.5, "source": "假设"},
    {"parameter_id": "p_nA", "name": "A区平台数", "symbol": "n_A", "value": 20, "source": "题目"},
    {"parameter_id": "p_nExit", "name": "A区要道数", "symbol": "n_E", "value": 13, "source": "题目"}
  ],
  "objectives": [
    {"objective_id": "OBJ_Q1", "type": "minimize", "expression": "min T_max = max_j t_j^resp，约束 T_max <= R_max=3min，为 20 平台分配管辖范围", "variables_refs": ["v_resp_max", "v_resp_j", "v_assign", "v_time"], "sub_question_binding": ["Q1"]},
    {"objective_id": "OBJ_Q2", "type": "minimize", "expression": "min T_block = max_k t_{a_k,k}，20 平台对 13 条要道快速全封锁的瓶颈指派", "variables_refs": ["v_block_max", "v_assign_exit", "v_time"], "sub_question_binding": ["Q2"]},
    {"objective_id": "OBJ_Q3", "type": "minimize", "expression": "min (alpha*T_max + beta*max_i W_i) over z_i，确定增设 2~5 个平台的个数与位置", "variables_refs": ["v_resp_max", "v_workload", "v_new_platform", "v_balance"], "sub_question_binding": ["Q3"]},
    {"objective_id": "OBJ_Q4", "type": "estimate", "expression": "estimate 全市六区平台设置的覆盖率 C、均衡度 G 与响应时间分布，识别不合理区域并给出调整方案", "variables_refs": ["v_coverage", "v_balance", "v_resp_max", "v_workload"], "sub_question_binding": ["Q4"]},
    {"objective_id": "OBJ_Q5", "type": "minimize", "expression": "min T_int = max_k t_{p_k,e_k}，约束 t_{p_k,e_k} <= t_s(e_k)，给出 P(32) 案最佳围堵方案", "variables_refs": ["v_intercept", "v_sus_time", "v_assign_exit", "v_time", "v_speed_s"], "sub_question_binding": ["Q5"]}
  ],
  "constraints": [
    {"constraint_id": "C1", "type": "integrality", "expression": "x_ij in {0,1} 且 sum_i x_ij = 1（每个节点恰好归属一个平台）", "variables_refs": ["v_assign"], "source": "定义", "sub_question_binding": ["Q1", "Q3"]},
    {"constraint_id": "C2", "type": "integrality", "expression": "y_ik in {0,1}，sum_i y_ik = 1（每出口恰一平台封锁），sum_k y_ik <= 1（一平台最多封锁一路口）", "variables_refs": ["v_assign_exit"], "source": "题意", "sub_question_binding": ["Q2"]},
    {"constraint_id": "C3", "type": "integrality", "expression": "z_i in {0,1} 且 k_min <= sum_i z_i <= k_max（增设平台数在 2~5 之间）", "variables_refs": ["v_new_platform"], "source": "题目", "sub_question_binding": ["Q3"]},
    {"constraint_id": "C4", "type": "response", "expression": "T_max = max_j t_j^resp <= R_max（3 分钟到达约束）", "variables_refs": ["v_resp_max", "v_resp_j"], "source": "题目", "sub_question_binding": ["Q1", "Q4"]},
    {"constraint_id": "C5", "type": "interception", "expression": "t_{p_k,e_k} <= t_s(e_k) = d(32,e_k)/v_s + t_delay（警车须早于嫌疑犯到达包围圈节点）", "variables_refs": ["v_intercept", "v_sus_time", "v_time"], "source": "机制假设", "sub_question_binding": ["Q5"]},
    {"constraint_id": "C6", "type": "nonnegativity", "expression": "W_i >= 0, r_j >= 0（工作量与权重非负）", "variables_refs": ["v_workload", "v_demand"], "source": "定义", "sub_question_binding": ["Q1", "Q3", "Q4"]}
  ],
  "mechanisms": [
    {"mechanism_id": "M1", "description": "最近分配与 3 分钟响应机制：节点按最短出行时间归属最近平台，响应时限约束决定管辖边界", "related_equations": ["EQ1", "EQ2", "EQ3", "EQ4", "EQ5"], "sub_question_binding": ["Q1"]},
    {"mechanism_id": "M2", "description": "瓶颈指派封锁机制：以最晚封锁完成时间最小化为目标的 13 要道-20 平台指派", "related_equations": ["EQ8"], "sub_question_binding": ["Q2"]},
    {"mechanism_id": "M3", "description": "平台增设选址机制：在响应时间与工作量失衡两个目标间权衡，选择新增平台个数与位置", "related_equations": ["EQ6", "EQ7", "EQ9"], "sub_question_binding": ["Q3"]},
    {"mechanism_id": "M4", "description": "全市覆盖均衡评估机制：以覆盖率、均衡度与响应时间分布评价六区设置合理性", "related_equations": ["EQ4", "EQ7", "EQ10"], "sub_question_binding": ["Q4"]},
    {"mechanism_id": "M5", "description": "动态围堵拦截机制：嫌疑犯 3 分钟延迟后逃逸，警力按包围圈节点先到原则调度", "related_equations": ["EQ11", "EQ12", "EQ13"], "sub_question_binding": ["Q5"]}
  ],
  "equations": [
    {"equation_id": "EQ1", "latex": "t_{ij} = \\min_{\\text{path } i\\to j} \\sum_{(a,b)\\in \\text{path}} \\frac{L_{ab}}{v_p}", "type": "shortest_path", "variables_refs": ["v_time", "v_edge_len", "p_vpolice"], "derivation_trace": "全源最短路：路径长度除以警车时速", "sub_question_binding": ["Q1", "Q2", "Q4", "Q5"]},
    {"equation_id": "EQ2", "latex": "x_{ij} = \\mathbb{1}\\left[t_{ij} = \\min_{l} t_{lj}\\right]", "type": "assignment", "variables_refs": ["v_assign", "v_time"], "derivation_trace": "最近平台分配规则（或作为优化变量配合响应约束）", "sub_question_binding": ["Q1"]},
    {"equation_id": "EQ3", "latex": "t_j^{resp} = \\sum_{i} x_{ij} t_{ij}", "type": "response", "variables_refs": ["v_resp_j", "v_assign", "v_time"], "derivation_trace": "节点响应时间 = 所属平台到该节点的最短时间", "sub_question_binding": ["Q1"]},
    {"equation_id": "EQ4", "latex": "T_{max} = \\max_{j} t_j^{resp}", "type": "aggregation", "variables_refs": ["v_resp_max", "v_resp_j"], "derivation_trace": "最大响应时间取全节点最大值", "sub_question_binding": ["Q1", "Q3", "Q4"]},
    {"equation_id": "EQ5", "latex": "T_{max} \\le R_{max} = 3\\,\\text{min}", "type": "constraint", "variables_refs": ["v_resp_max", "p_rmax"], "derivation_trace": "3 分钟到达约束", "sub_question_binding": ["Q1", "Q4"]},
    {"equation_id": "EQ6", "latex": "W_i = \\sum_{j} x_{ij} r_j", "type": "workload", "variables_refs": ["v_workload", "v_assign", "v_demand"], "derivation_trace": "平台工作量 = 管辖节点需求权重之和", "sub_question_binding": ["Q1", "Q3", "Q4"]},
    {"equation_id": "EQ7", "latex": "G = \\frac{\\max_i W_i}{\\frac{1}{n_p}\\sum_i W_i}", "type": "balance", "variables_refs": ["v_balance", "v_workload", "v_n_platform"], "derivation_trace": "工作量失衡度 = 最大值/均值", "sub_question_binding": ["Q3", "Q4"]},
    {"equation_id": "EQ8", "latex": "T_{block} = \\min_{\\text{指派}} \\max_{k} t_{a_k, k}", "type": "bottleneck_assignment", "variables_refs": ["v_block_max", "v_assign_exit", "v_time"], "derivation_trace": "瓶颈指派：最小化最晚封锁完成时间", "sub_question_binding": ["Q2"]},
    {"equation_id": "EQ9", "latex": "\\min_{z} \\left(\\alpha T_{max} + \\beta \\max_i W_i\\right),\\quad k_{min} \\le \\sum_i z_i \\le k_{max}", "type": "location", "variables_refs": ["v_resp_max", "v_workload", "v_new_platform", "p_alpha", "p_beta", "p_kmin", "p_kmax"], "derivation_trace": "增设平台多目标选址", "sub_question_binding": ["Q3"]},
    {"equation_id": "EQ10", "latex": "C = \\frac{1}{N}\\sum_{j} \\mathbb{1}\\left[t_j^{resp} \\le R_{max}\\right]", "type": "coverage", "variables_refs": ["v_coverage", "v_resp_j", "p_rmax"], "derivation_trace": "覆盖率 = 3 分钟内可达节点占比", "sub_question_binding": ["Q1", "Q4"]},
    {"equation_id": "EQ11", "latex": "t_s(e) = \\frac{d(32, e)}{v_s} + t_{delay}", "type": "pursuit", "variables_refs": ["v_sus_time", "v_time", "v_speed_s", "p_delay"], "derivation_trace": "嫌疑犯到出口 e 的时间 = 行程时间 + 3 分钟接警延迟", "sub_question_binding": ["Q5"]},
    {"equation_id": "EQ12", "latex": "t_{p_k, e_k} \\le t_s(e_k),\\quad \\forall e_k \\in \\text{包围圈}", "type": "constraint", "variables_refs": ["v_intercept", "v_sus_time", "v_time"], "derivation_trace": "警车先于嫌疑犯到达包围圈节点的先到条件", "sub_question_binding": ["Q5"]},
    {"equation_id": "EQ13", "latex": "T_{int} = \\max_{k} t_{p_k, e_k}", "type": "aggregation", "variables_refs": ["v_intercept", "v_time"], "derivation_trace": "围堵完成时间 = 最晚到达包围圈节点的警车时间", "sub_question_binding": ["Q5"]}
  ],
  "dependencies": [
    {"dependency_id": "DEP1", "from": "EQ3", "to": ["EQ1", "EQ2"], "type": "equation", "description": "响应时间依赖最短路与分配"},
