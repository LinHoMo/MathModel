    {"solver_id": "SOL2", "method": "瓶颈指派：二分答案 + 匹配判定（或匈牙利算法变体）求解 13 要道封锁", "implementation_ref": "research/P15/experiments/P15-K002-precheck/code/jj_block_dispatch.py", "sub_question_binding": ["Q2"]},
    {"solver_id": "SOL3", "method": "贪心 + 局部搜索选址：枚举 k=2..5 的增设平台组合，多目标权衡", "implementation_ref": "research/P15/experiments/P15-K002-precheck/code/jj_location.py", "sub_question_binding": ["Q3"]},
    {"solver_id": "SOL4", "method": "围堵方案枚举/仿真：对包围圈节点集合搜索最小 T_int 且满足先到条件", "implementation_ref": "research/P15/experiments/P15-K002-precheck/code/jj_intercept.py", "sub_question_binding": ["Q5"]}
  ],
  "experiments": [
    {"experiment_id": "EXP1", "type": "ablation", "inputs": "A 区路网数据 + 20 平台位置", "expected_outputs": "管辖分配方案、响应时间分布、覆盖率 C、最大响应 T_max", "sub_question_binding": ["Q1"]},
    {"experiment_id": "EXP2", "type": "optimization", "inputs": "13 条要道出口节点 + 20 平台位置", "expected_outputs": "全封锁调度方案与最晚封锁时间 T_block", "sub_question_binding": ["Q2"]},
    {"experiment_id": "EXP3", "type": "ablation", "inputs": "k = 2,3,4,5 增设平台枚举", "expected_outputs": "各 k 下的 T_max、max W_i、G 改善曲线与推荐方案", "sub_question_binding": ["Q3"]},
    {"experiment_id": "EXP4", "type": "evaluation", "inputs": "全市六区（A-F）路网与平台数据", "expected_outputs": "六区覆盖率、均衡度、响应时间分布与不合理区域清单", "sub_question_binding": ["Q4"]},
    {"experiment_id": "EXP5", "type": "simulation", "inputs": "案发点 32、接警延迟 3min、嫌疑犯车速 v_s", "expected_outputs": "最佳围堵方案与围堵完成时间 T_int", "sub_question_binding": ["Q5"]}
  ],
