  "assumptions": [
    {
      "assumption_id": "A-01",
      "text": "水和食物的购买量在优化模型中按连续量处理，允许非整数箱；实际填表时再取整到合法箱数。",
      "type": "simplification",
      "rationale": "游戏以箱为最小计量单位，但连续化可显著简化最优性条件求解，且箱数规模较大时取整误差可忽略。"
    },
    {
      "assumption_id": "A-02",
      "text": "天气对资源消耗的影响通过乘性倍率 α_w 作用于基础消耗量：晴朗 α=1，高温 α=3，沙暴 α=1 但禁止移动。",
      "type": "mechanism",
      "rationale": "题目规定每天天气为晴朗/高温/沙暴三态，附件给出各天气下基础消耗，乘性结构符合题意且可参数化。"
    },
    {
      "assumption_id": "A-03",
      "text": "玩家决策只依赖当前状态 (位置, 水量, 食物量, 资金, 当天天气)，即马尔可夫性成立，历史路径不影响后续最优决策。",
      "type": "projection",
      "rationale": "游戏的资源结算与转移规则均只涉及当天状态，满足动态规划的无后效性要求。"
    },
    {
      "assumption_id": "A-04",
      "text": "一天内按顺序结算：先进行移动/挖矿等行动并消耗资源，再执行购买行为，最后得到当天结束时的剩余量。",
      "type": "mechanism",
      "rationale": "与题目注2中‘剩余资金/水量/食物量指当日所需资源全部消耗完毕且完成购买后’的口径一致。"
    },
    {
      "assumption_id": "A-05",
      "text": "Q3 中 n 名玩家同质：初始资金、消耗参数、天气感知完全相同，仅通过同日同区域行动产生交互。",
      "type": "projection",
      "rationale": "题目给定相同的初始资金和公共天气，同质假设使多人问题可对称化，便于博弈分析。"
    },
    {
      "assumption_id": "A-06",
      "text": "Q2 与 Q3(2) 中玩家对未来天气仅有统计认知，未来天气概率 π_w 由历史同期统计或题设分布给定。",
      "type": "calibration",
      "rationale": "玩家仅知道当天天气，对未来只能采用概率刻画，这是部分可观测环境下的标准处理。"
    },
    {
      "assumption_id": "A-07",
      "text": "Q3 中玩家均为理性个体：Q3(1) 采用离线协调视角（第0天固定方案），Q3(2) 采用非合作动态博弈视角。",
      "type": "projection",
      "rationale": "多人相互影响消耗与收益，需区分离线合作与在线竞争两种信息结构。"
    }
  ],
