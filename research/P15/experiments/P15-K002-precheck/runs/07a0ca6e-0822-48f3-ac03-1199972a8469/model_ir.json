  "equations": [
    {
      "equation_id": "EQ-01",
      "latex": "\\rho_i c_i \\frac{\\partial T}{\\partial t} = k_i \\frac{\\partial^2 T}{\\partial x^2}, \\quad x \\in \\Omega_i,\\; i=1,2,3,4",
      "type": "pde",
      "variables_refs": [
        "v_T",
        "v_x",
        "v_t"
      ],
      "derivation_trace": "由 Fourier 定律与能量守恒导出的一维瞬态热传导方程，i 遍历 I..IV 层。",
      "sub_question_binding": [
        "Q1",
        "Q2",
        "Q3"
      ]
    },
    {
      "equation_id": "EQ-02",
      "latex": "-k_1 \\left.\\frac{\\partial T}{\\partial x}\\right|_{x=0} = h_1 (T_{env} - T(0,t))",
      "type": "boundary",
      "variables_refs": [
        "v_T",
        "v_x",
        "v_t"
      ],
      "derivation_trace": "外表面与高温空气的对流换热平衡（Robin 边界）。",
      "sub_question_binding": [
        "Q1",
        "Q2",
        "Q3"
      ]
    },
    {
      "equation_id": "EQ-03",
