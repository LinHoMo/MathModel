  "assumptions": [
    {
      "assumption_id": "A-01",
      "text": "服装-皮肤系统简化为一维多层平板传热模型，热流仅沿厚度方向（垂直皮肤表面）传播，忽略侧向边缘效应与曲率。",
      "type": "simplification",
      "rationale": "服装覆盖面积远大于厚度，边缘效应占比小，一维模型可精确刻画主要温度梯度，且便于解析与数值求解。"
    },
    {
      "assumption_id": "A-02",
      "text": "各层材料物性（导热系数 k、密度 ρ、比热 c）为常数，不随温度变化；层间为理想热接触（温度与热流连续）。",
      "type": "mechanism",
      "rationale": "附件1 只给出单点物性参数，恒物性假设是标准处理；理想接触是建立连续界面条件的基础。"
    },
    {
      "assumption_id": "A-03",
      "text": "外表面（I 层外侧）与高温环境之间为对流换热，皮肤侧（IV 层与皮肤界面）同样以对流/恒温边界刻画 37°C 恒温假人。",
      "type": "mechanism",
      "rationale": "环境高温空气与织物表面、皮肤与内层空气之间的换热以对流为主，采用 Robin 边界条件。"
    },
    {
      "assumption_id": "A-04",
      "text": "初始时刻整系统处于 37°C 均匀温度场（假人入炉前的稳态），从 t=0 起环境温度突变为给定高温值。",
      "type": "projection",
      "rationale": "题目描述假人置于高温环境开始测量，初始均匀 37°C 是自然且常用的初始条件。"
    },
    {
      "assumption_id": "A-05",
      "text": "Q1 中材料参数按附件1 直接采用（正问题）；若正问题与附件2 实测偏差超阈值，则在校准环节微调对流换热系数 h。",
      "type": "calibration",
      "rationale": "h1/h2 题目未直接给出，属不确定参数，需用附件2 测量数据校准，属于逆问题环节。"
    },
    {
      "assumption_id": "A-06",
      "text": "厚度设计变量在可行域内连续取值，最优厚度按 0.1mm 网格搜索或连续优化后取工程可行值。",
      "type": "simplification",
      "rationale": "生产厚度可视为连续，数值优化后用工程惯例取整，误差在工艺容差内。"
    },
    {
      "assumption_id": "A-07",
      "text": "皮肤外侧温度以 IV 层与皮肤界面处温度 T(L,t) 表示，即题面所测假人皮肤外侧温度。",
      "type": "projection",
      "rationale": "测量点位于皮肤外侧，即最内层边界，直接映射为模型边界温度。"
    }
  ],
