{
  "ir_version": "1.0",
  "model_id": "M-28df6ec4",
  "model_family": {
    "primary": "optimization",
    "secondary": ["simulation", "dynamic_programming"]
  },
  "problem_binding": {
    "problem_id": "2018_B",
    "sub_question_id": ["Q1", "Q2", "Q3", "Q4"],
    "problem_sha256": "f00ef29490cc2ef0ca87d7bf17b598ecae98021e8049addfa222649bee410152"
  },
  "assumptions": [
    {
      "assumption_id": "A1",
      "text": "RGV 在直线轨道上的移动时间仅由移动距离决定，忽略加减速、轨道占用与避让，移动时间为题目给定的离散常量。",
      "type": "simplification",
      "rationale": "题目仅给出移动 1/2/3 个单位的耗时，将其视为确定常量是唯一可标定的简化。"
    },
    {
      "assumption_id": "A2",
      "text": "每台 CNC 同时最多加工一个物料，加工过程不可中断；物料在任一台 CNC 上加工完成即为合格品。",
      "type": "mechanism",
      "rationale": "符合数控加工的单件作业特性，也是建立排队/周期模型的基础。"
    },
    {
      "assumption_id": "A3",
      "text": "班次内上料传送带物料供给充足、无缺料停线，RGV 与 CNC 在 8 小时内连续作业。",
      "type": "projection",
      "rationale": "题目未给出缺料情形，供给充足假设给出班次产量的上界视角，便于评估系统极限效率。"
    },
    {
      "assumption_id": "A4",
      "text": "CNC 故障相互独立，每台 CNC 每个加工周期以概率 p_f=1% 发生故障；故障排除时长在 [10,20] 分钟上均匀分布，排除后即刻重新加入作业序列。",
      "type": "calibration",
      "rationale": "题目给出故障概率约 1% 与排除时间 10~20 分钟，均匀分布是对区间信息的最小信息量假设。"
    },
    {
      "assumption_id": "A5",
      "text": "RGV 的初始停靠位置与首轮服务顺序可自由设定，属于调度优化的自由度。",
      "type": "simplification",
      "rationale": "初始位置对稳态班次产量的影响可被循环周期吸收，故不单独固定。"
    },
    {
      "assumption_id": "A6",
      "text": "两道工序情形下，第一道与第二道工序分别由两台不同 CNC 依次完成，RGV 负责工序间的物料搬运与第二道完工件的清洗。",
      "type": "mechanism",
      "rationale": "题意明确两道工序由不同 CNC 完成，RGV 搬运是衔接两道工序的唯一物流通道。"
    }
  ],
  "variables": [
    {"variable_id": "v_pos", "name": "RGV位置", "symbol": "p(t)", "definition": "t 时刻 RGV 停靠的 CNC 编号（1..8）", "unit": "CNC编号", "type": "state", "sub_question_binding": ["Q1", "Q2", "Q3"]},
    {"variable_id": "v_dispatch", "name": "调度决策", "symbol": "a_{t,i}", "definition": "t 时刻是否派 RGV 服务 CNC i（1 是 / 0 否）", "unit": "无", "type": "decision", "sub_question_binding": ["Q1", "Q2", "Q3", "Q4"]},
    {"variable_id": "v_cnc_state", "name": "CNC状态", "symbol": "s_i(t)", "definition": "CNC i 在 t 时刻的状态：IDLE/PROCESSING/WAITING/FAILED", "unit": "无", "type": "state", "sub_question_binding": ["Q1", "Q2", "Q3"]},
    {"variable_id": "v_fail", "name": "故障指示", "symbol": "f_i(t)", "definition": "CNC i 在 t 时刻是否处于故障（1 是 / 0 否）", "unit": "无", "type": "state", "sub_question_binding": ["Q3"]},
    {"variable_id": "v_repair", "name": "修复时长", "symbol": "tau_i", "definition": "CNC i 本次故障的排除（修复）时长", "unit": "s", "type": "state", "sub_question_binding": ["Q3"]},
    {"variable_id": "v_mov_time", "name": "移动时间", "symbol": "T_mov(i,j)", "definition": "RGV 从 CNC i 移动到 CNC j 的耗时", "unit": "s", "type": "observation", "sub_question_binding": ["Q1", "Q2", "Q3"]},
    {"variable_id": "v_serv", "name": "单次服务时间", "symbol": "T_si", "definition": "RGV 服务 CNC i 一次（上下料，必要时清洗）的耗时", "unit": "s", "type": "observation", "sub_question_binding": ["Q1", "Q2", "Q3"]},
    {"variable_id": "v_serv_avg", "name": "平均单次服务时间", "symbol": "T_sbar", "definition": "一轮中 8 台 CNC 单次服务时间的平均值", "unit": "s", "type": "observation", "sub_question_binding": ["Q1", "Q2"]},
    {"variable_id": "v_delta", "name": "清洗指示", "symbol": "delta_i", "definition": "本次在 CNC i 取出的物料是否为完工件（需清洗取 1，否则 0）", "unit": "无", "type": "observation", "sub_question_binding": ["Q1", "Q2"]},
    {"variable_id": "v_rnd", "name": "轮服务时间", "symbol": "T_rnd", "definition": "RGV 完成一轮（服务全部 8 台 CNC）的总耗时", "unit": "s", "type": "observation", "sub_question_binding": ["Q1"]},
    {"variable_id": "v_cyc", "name": "稳态循环周期", "symbol": "T_cyc", "definition": "一道工序稳态下每台 CNC 相邻两次被服务的时间间隔", "unit": "s", "type": "observation", "sub_question_binding": ["Q1"]},
    {"variable_id": "v_throughput1", "name": "一道工序班次产量", "symbol": "W", "definition": "一道工序情形下 8 小时班次完成的物料总数", "unit": "件", "type": "observation", "sub_question_binding": ["Q1", "Q4"]},
    {"variable_id": "v_throughput2", "name": "两道工序班次产量", "symbol": "W2", "definition": "两道工序情形下 8 小时班次完成的成品总数", "unit": "件", "type": "observation", "sub_question_binding": ["Q2", "Q4"]},
    {"variable_id": "v_util", "name": "CNC利用率", "symbol": "U", "definition": "CNC 平均加工时间占循环周期的比例", "unit": "无", "type": "observation", "sub_question_binding": ["Q1", "Q2"]},
    {"variable_id": "v_eff", "name": "系统作业效率", "symbol": "eta", "definition": "班次产量与班次时长的比值（单位时间完工件数）", "unit": "件/s", "type": "observation", "sub_question_binding": ["Q4"]},
    {"variable_id": "v_avail", "name": "CNC可用度", "symbol": "A_i", "definition": "故障场景下 CNC i 的稳态可用度（加工时间占比）", "unit": "无", "type": "observation", "sub_question_binding": ["Q3"]},
    {"variable_id": "v_w_exp", "name": "期望班次产量", "symbol": "W_exp", "definition": "故障场景下考虑可用度折损后的期望班次产量", "unit": "件", "type": "observation", "sub_question_binding": ["Q3"]},
    {"variable_id": "v_scrap", "name": "期望报废件数", "symbol": "L", "definition": "故障导致的在制品报废期望件数", "unit": "件", "type": "observation", "sub_question_binding": ["Q3"]},
    {"variable_id": "v_tau_mean", "name": "平均修复时长", "symbol": "tau_bar", "definition": "故障排除时长的期望值", "unit": "s", "type": "observation", "sub_question_binding": ["Q3"]},
    {"variable_id": "v_proc_i", "name": "单件加工时间", "symbol": "t_pi", "definition": "CNC i 的单件加工时间（一道工序取 t_p1，两道按工序取 t_p2a/t_p2b）", "unit": "s", "type": "observation", "sub_question_binding": ["Q3"]},
    {"variable_id": "v_n_proc", "name": "单机班次加工件数", "symbol": "N_i^proc", "definition": "CNC i 在一个班次内加工（或完工）的物料数", "unit": "件", "type": "observation", "sub_question_binding": ["Q1", "Q2", "Q3"]},
    {"variable_id": "v_nF", "name": "第一道CNC数", "symbol": "n_F", "definition": "承担第一道工序的 CNC 台数（标准配置 4 台）", "unit": "台", "type": "constant", "sub_question_binding": ["Q2"]},
    {"variable_id": "v_nS", "name": "第二道CNC数", "symbol": "n_S", "definition": "承担第二道工序的 CNC 台数（标准配置 4 台）", "unit": "台", "type": "constant", "sub_question_binding": ["Q2"]},
    {"variable_id": "v_wF", "name": "第一道产量", "symbol": "W_F", "definition": "第一道工序的班次加工能力", "unit": "件", "type": "observation", "sub_question_binding": ["Q2"]},
    {"variable_id": "v_wS", "name": "第二道产量", "symbol": "W_S", "definition": "第二道工序的班次加工能力（含清洗）", "unit": "件", "type": "observation", "sub_question_binding": ["Q2"]},
    {"variable_id": "v_cycF", "name": "第一道循环周期", "symbol": "T_cycF", "definition": "两道工序下第一道 CNC 的稳态循环周期", "unit": "s", "type": "observation", "sub_question_binding": ["Q2"]},
    {"variable_id": "v_cycS", "name": "第二道循环周期", "symbol": "T_cycS", "definition": "两道工序下第二道 CNC 的稳态循环周期", "unit": "s", "type": "observation", "sub_question_binding": ["Q2"]},
    {"variable_id": "v_rndF", "name": "第一道轮服务时间", "symbol": "T_rndF", "definition": "RGV 服务全部第一道 CNC 一轮的耗时", "unit": "s", "type": "observation", "sub_question_binding": ["Q2"]},
    {"variable_id": "v_rndS", "name": "第二道轮服务时间", "symbol": "T_rndS", "definition": "RGV 服务全部第二道 CNC 一轮的耗时", "unit": "s", "type": "observation", "sub_question_binding": ["Q2"]},
    {"variable_id": "v_servF", "name": "第一道单次服务时间", "symbol": "T_sF", "definition": "RGV 服务一台第一道 CNC 的平均耗时（上料+下料+搬运）", "unit": "s", "type": "observation", "sub_question_binding": ["Q2"]},
    {"variable_id": "v_servS", "name": "第二道单次服务时间", "symbol": "T_sS", "definition": "RGV 服务一台第二道 CNC 的平均耗时（上料+下料+清洗）", "unit": "s", "type": "observation", "sub_question_binding": ["Q2"]},
    {"variable_id": "v_arr", "name": "RGV到达时刻", "symbol": "t_arr_i", "definition": "RGV 到达 CNC i 的时刻", "unit": "s", "type": "state", "sub_question_binding": ["Q1", "Q2"]},
    {"variable_id": "v_ready", "name": "CNC就绪时刻", "symbol": "t_ready_i", "definition": "CNC i 可以被服务（空闲或已完工）的最早时刻", "unit": "s", "type": "state", "sub_question_binding": ["Q1", "Q2"]},
    {"variable_id": "v_dep", "name": "RGV离开时刻", "symbol": "t_dep_i", "definition": "RGV 完成 CNC i 服务后的离开时刻", "unit": "s", "type": "state", "sub_question_binding": ["Q1", "Q2"]}
  ],
  "parameters": [
    {"parameter_id": "p_v1", "name": "移动1单位时间", "symbol": "v_1", "value": 20, "source": "题目"},
    {"parameter_id": "p_v2", "name": "移动2单位时间", "symbol": "v_2", "value": 33, "source": "题目"},
    {"parameter_id": "p_v3", "name": "移动3单位时间", "symbol": "v_3", "value": 46, "source": "题目"},
    {"parameter_id": "p_tp1", "name": "一道工序加工时间", "symbol": "t_p1", "value": 560, "source": "题目"},
    {"parameter_id": "p_tp2a", "name": "两道第一道工序时间", "symbol": "t_p2a", "value": 400, "source": "题目"},
    {"parameter_id": "p_tp2b", "name": "两道第二道工序时间", "symbol": "t_p2b", "value": 378, "source": "题目"},
    {"parameter_id": "p_tld_odd", "name": "奇号CNC上下料时间", "symbol": "t_ld^odd", "value": 28, "source": "题目"},
    {"parameter_id": "p_tld_even", "name": "偶号CNC上下料时间", "symbol": "t_ld^even", "value": 31, "source": "题目"},
    {"parameter_id": "p_tw", "name": "清洗作业时间", "symbol": "t_w", "value": 25, "source": "题目"},
    {"parameter_id": "p_D", "name": "班次时长", "symbol": "D", "value": 28800, "source": "题目"},
    {"parameter_id": "p_pf", "name": "故障发生概率", "symbol": "p_f", "value": 0.01, "source": "题目"},
    {"parameter_id": "p_taumin", "name": "故障排除时间下界", "symbol": "tau_min", "value": 600, "source": "题目"},
    {"parameter_id": "p_taumax", "name": "故障排除时间上界", "symbol": "tau_max", "value": 1200, "source": "题目"},
    {"parameter_id": "p_ncnc", "name": "CNC总台数", "symbol": "n", "value": 8, "source": "题目"}
  ],
  "objectives": [
    {"objective_id": "OBJ_Q1", "type": "maximize", "expression": "max W = 8*floor(D/T_cyc)，通过最小化轮服务时间 T_rnd 与循环周期 T_cyc 实现", "variables_refs": ["v_throughput1", "v_cyc", "v_rnd", "v_serv_avg"], "sub_question_binding": ["Q1"]},
    {"objective_id": "OBJ_Q2", "type": "maximize", "expression": "max W2 = min(W_F, W_S)，平衡第一道与第二道工序能力，消除瓶颈", "variables_refs": ["v_throughput2", "v_wF", "v_wS", "v_cycF", "v_cycS"], "sub_question_binding": ["Q2"]},
    {"objective_id": "OBJ_Q3", "type": "maximize", "expression": "max W_exp = sum_i A_i*N_i^proc 且 min L = p_f*sum_i N_i^proc，故障场景下期望产量最大、报废最少", "variables_refs": ["v_w_exp", "v_avail", "v_scrap", "v_n_proc"], "sub_question_binding": ["Q3"]},
    {"objective_id": "OBJ_Q4", "type": "estimate", "expression": "estimate W、W2 与 eta 在 3 组系统作业参数下的取值，输出附件2 三个工作表要求的调度策略与作业效率", "variables_refs": ["v_throughput1", "v_throughput2", "v_eff"], "sub_question_binding": ["Q4"]}
  ],
  "constraints": [
    {"constraint_id": "C1", "type": "integrality", "expression": "a_{t,i} in {0,1} 且 sum_i a_{t,i} <= 1（RGV 同一时刻至多服务一台 CNC）", "variables_refs": ["v_dispatch"], "source": "机制假设", "sub_question_binding": ["Q1", "Q2", "Q3", "Q4"]},
    {"constraint_id": "C2", "type": "capacity", "expression": "s_i(t) in {IDLE, PROCESSING, WAITING, FAILED}，每台 CNC 同时最多一个物料", "variables_refs": ["v_cnc_state"], "source": "机制假设", "sub_question_binding": ["Q1", "Q2", "Q3"]},
    {"constraint_id": "C3", "type": "timing", "expression": "t_arr_i >= t_ready_i（RGV 到达不早于 CNC 就绪）", "variables_refs": ["v_arr", "v_ready"], "source": "机制假设", "sub_question_binding": ["Q1", "Q2"]},
    {"constraint_id": "C4", "type": "equality", "expression": "t_dep_i = t_arr_i + T_si（服务时间守恒）", "variables_refs": ["v_dep", "v_arr", "v_serv"], "source": "定义", "sub_question_binding": ["Q1", "Q2"]},
    {"constraint_id": "C5", "type": "flow_conservation", "expression": "sum_{i in F} N_i^proc = sum_{i in S} N_i^proc（两道工序物料流转守恒）", "variables_refs": ["v_n_proc", "v_nF", "v_nS"], "source": "题意", "sub_question_binding": ["Q2"]},
    {"constraint_id": "C6", "type": "bound", "expression": "tau_min <= tau_i <= tau_max（修复时长区间）", "variables_refs": ["v_repair"], "source": "题目", "sub_question_binding": ["Q3"]},
    {"constraint_id": "C7", "type": "horizon", "expression": "调度总时长 <= D（8 小时班次）", "variables_refs": ["v_dep"], "source": "题目", "sub_question_binding": ["Q1", "Q2", "Q3", "Q4"]}
  ],
  "mechanisms": [
    {"mechanism_id": "M1", "description": "循环服务机制：RGV 沿轨道按轮询序依次服务 8 台 CNC，完工件立即下料并清洗，形成稳定循环周期", "related_equations": ["EQ1", "EQ2", "EQ3", "EQ4", "EQ5", "EQ6"], "sub_question_binding": ["Q1"]},
    {"mechanism_id": "M2", "description": "两道工序流转机制：第一道完工物料由 RGV 搬运至第二道 CNC，第二道完工后清洗，两道工序能力取小决定成品产量", "related_equations": ["EQ9", "EQ10", "EQ11"], "sub_question_binding": ["Q2"]},
    {"mechanism_id": "M3", "description": "故障-修复-报废机制：加工周期内以概率 p_f 发生故障，在制品报废，修复时长在 [10,20] 分钟随机，修复后重新入列，可用度折损产量", "related_equations": ["EQ12", "EQ13", "EQ14", "EQ15"], "sub_question_binding": ["Q3"]},
    {"mechanism_id": "M4", "description": "参数适配机制：同一模型接受题目表 1 的三组系统作业参数，输出对应调度策略与作业效率并填表", "related_equations": ["EQ6", "EQ8", "EQ11"], "sub_question_binding": ["Q4"]}
  ],
  "equations": [
    {"equation_id": "EQ1", "latex": "T_{mov}(i,j) = v_{|i-j|}", "type": "definition", "variables_refs": ["v_mov_time", "p_v1", "p_v2", "p_v3"], "derivation_trace": "由题目表 1 移动时间定义直接给出", "sub_question_binding": ["Q1", "Q2", "Q3"]},
    {"equation_id": "EQ2", "latex": "T_{si} = T_{mov}(p(t),i) + t_{ld}(i) + \\delta_i t_w", "type": "balance", "variables_refs": ["v_serv", "v_mov_time", "v_pos", "v_delta", "p_tld_odd", "p_tld_even", "p_tw"], "derivation_trace": "单次服务时间 = 移动时间 + 上下料时间 + 完工件清洗时间", "sub_question_binding": ["Q1", "Q2"]},
    {"equation_id": "EQ3", "latex": "\\bar{T}_s = \\frac{1}{8}\\sum_{i=1}^{8} T_{si}", "type": "aggregation", "variables_refs": ["v_serv_avg", "v_serv"], "derivation_trace": "8 台 CNC 单次服务时间取平均", "sub_question_binding": ["Q1", "Q2"]},
    {"equation_id": "EQ4", "latex": "T_{rnd} = 8\\bar{T}_s", "type": "balance", "variables_refs": ["v_rnd", "v_serv_avg"], "derivation_trace": "一轮服务总时间为 8 次服务时间之和", "sub_question_binding": ["Q1"]},
    {"equation_id": "EQ5", "latex": "T_{cyc} = \\max(T_{rnd},\\, t_{p1} + \\bar{T}_s)", "type": "mechanism", "variables_refs": ["v_cyc", "v_rnd", "p_tp1", "v_serv_avg"], "derivation_trace": "稳态循环周期受 RGV 轮服务时间与 CNC 加工周期两者较大者约束（防饥饿条件）", "sub_question_binding": ["Q1"]},
    {"equation_id": "EQ6", "latex": "W = 8\\left\\lfloor \\frac{D}{T_{cyc}} \\right\\rfloor", "type": "throughput", "variables_refs": ["v_throughput1", "p_D", "v_cyc"], "derivation_trace": "班次时长除以循环周期取整，乘以 8 台 CNC", "sub_question_binding": ["Q1", "Q4"]},
    {"equation_id": "EQ7", "latex": "U = \\frac{t_{p1}}{T_{cyc}}", "type": "utilization", "variables_refs": ["v_util", "p_tp1", "v_cyc"], "derivation_trace": "CNC 加工时间占循环周期比例", "sub_question_binding": ["Q1"]},
    {"equation_id": "EQ8", "latex": "\\eta = \\frac{W}{D}", "type": "efficiency", "variables_refs": ["v_eff", "v_throughput1", "p_D"], "derivation_trace": "系统作业效率定义为单位时间完工件数", "sub_question_binding": ["Q4"]},
    {"equation_id": "EQ9", "latex": "T_{cycF} = \\max(T_{rndF},\\, t_{p2a} + T_{sF})", "type": "mechanism", "variables_refs": ["v_cycF", "v_rndF", "p_tp2a", "v_servF"], "derivation_trace": "第一道工序稳态周期取 RGV 轮服务与加工周期较大者", "sub_question_binding": ["Q2"]},
    {"equation_id": "EQ10", "latex": "T_{cycS} = \\max(T_{rndS},\\, t_{p2b} + T_{sS})", "type": "mechanism", "variables_refs": ["v_cycS", "v_rndS", "p_tp2b", "v_servS"], "derivation_trace": "第二道工序稳态周期，服务时间已含清洗", "sub_question_binding": ["Q2"]},
    {"equation_id": "EQ11", "latex": "W_2 = \\min\\left(n_F\\left\\lfloor \\frac{D}{T_{cycF}} \\right\\rfloor,\\, n_S\\left\\lfloor \\frac{D}{T_{cycS}} \\right\\rfloor\\right)", "type": "throughput", "variables_refs": ["v_throughput2", "v_nF", "v_nS", "p_D", "v_cycF", "v_cycS"], "derivation_trace": "成品产量受两道工序能力较小者约束（瓶颈决定）", "sub_question_binding": ["Q2", "Q4"]},
