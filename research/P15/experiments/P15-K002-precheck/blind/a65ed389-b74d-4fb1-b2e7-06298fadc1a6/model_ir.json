  "assumptions": [
    {
      "assumption_id": "A-01",
      "text": "出租车到达蓄车池与乘客到达乘车区的过程分别服从泊松过程（到达率 λ_t、λ_p 随时间分段平稳），服务时间服从指数分布。",
      "type": "projection",
      "rationale": "泊松到达/指数服务是排队论的标准假设，便于用 M/M/c 解析公式刻画队列，且可被真实数据检验。"
    },
    {
      "assumption_id": "A-02",
      "text": "司机完全理性且风险中性，以期望净收益最大化为决策准则，决策仅比较排队等待载客与放空返回两种方案的期望收益。",
      "type": "projection",
      "rationale": "题目明确司机决策取决于收益比较；期望效用框架是理性决策模型的基准。"
    },
    {
      "assumption_id": "A-03",
      "text": "载客收益与行驶里程线性相关（r_km·D），放空成本与空驶里程线性相关；乘客目的地分布已知（含短途比例）。",
      "type": "simplification",
      "rationale": "计价规则下收益近似线性于里程，便于解析；目的地分布由历史数据估计。"
    },
    {
      "assumption_id": "A-04",
      "text": "Q3 中两条车道可设置 m 个并行上车点（m ≤ 2），每个上车点独立服务且服务率相同 μ，管理方按分批定量（每批 K 辆）放行。",
      "type": "mechanism",
      "rationale": "并行服务台模型刻画双车道上车效率，分批放行是题述管理方式。"
    },
    {
      "assumption_id": "A-05",
      "text": "Q4 中短途乘客比例与目的地分布已知，优先权通过缩短短途司机再次排队的等效等待时间实现，不影响长短途司机单次载客收益。",
      "type": "projection",
      "rationale": "优先权机制的收益均衡效果用等待时间折扣刻画，是排队论中优先权队列的标准处理。"
    },
    {
      "assumption_id": "A-06",
      "text": "模型参数（λ_t、λ_p、μ、D̄、短途比例）由所收集机场的真实数据校准，跨时段分段常数。",
      "type": "calibration",
      "rationale": "Q2 要求结合真实数据，参数必须数据驱动，采用分段平稳估计。"
    },
    {
      "assumption_id": "A-07",
      "text": "忽略司机的个体异质（如对等待时间的主观偏好差异），收益均衡以可观测收益（而非效用）衡量。",
      "type": "simplification",
      "rationale": "管理方只能基于可观测指标设计规则，收益均衡定义在货币收益层面。"
    }
  ],
