  "equations": [
    {
      "equation_id": "EQ-01",
      "latex": "V_{wait} = R_{fare} - c_w\\, W_{wait}",
      "type": "decision_metric",
      "variables_refs": [
        "v_Vw",
        "v_Rf",
        "v_W"
      ],
      "derivation_trace": "排队等待方案的期望净收益 = 载客期望收益 − 等待时间成本。",
      "sub_question_binding": [
        "Q1",
        "Q2"
      ]
    },
    {
      "equation_id": "EQ-02",
      "latex": "V_{empty} = R_{empty} - C_{empty}",
      "type": "decision_metric",
      "variables_refs": [
        "v_Ve",
        "v_Re"
      ],
      "derivation_trace": "放空返回方案的期望净收益 = 返回后拉客期望收益 − 空驶成本。",
      "sub_question_binding": [
        "Q1",
        "Q2"
      ]
    },
    {
      "equation_id": "EQ-03",
      "latex": "p = \\mathbb{1}[V_{wait} \\ge V_{empty}]",
      "type": "decision_rule",
      "variables_refs": [
        "v_p",
        "v_Vw",
        "v_Ve"
      ],
      "derivation_trace": "理性司机选择净收益更高的方案，指示函数给出决策规则。",
      "sub_question_binding": [
        "Q1",
        "Q2"
      ]
    },
    {
      "equation_id": "EQ-04",
      "latex": "L_q = \\lambda_p\\, W_{wait}",
      "type": "queue_law",
      "variables_refs": [
        "v_Lq",
        "v_W"
      ],
      "derivation_trace": "Little 定律：稳态下平均队长 = 有效到达率 × 平均等待时间。",
      "sub_question_binding": [
        "Q1",
        "Q2",
        "Q3"
      ]
    },
    {
      "equation_id": "EQ-05",
      "latex": "\\rho = \\frac{\\lambda_p}{m\\, \\mu}",
      "type": "queue_metric",
      "variables_refs": [
        "v_rho",
        "v_m"
      ],
      "derivation_trace": "服务强度定义：乘客到达率与总服务能力之比，ρ<1 为稳定条件。",
      "sub_question_binding": [
        "Q1",
        "Q2",
        "Q3"
      ]
    },
    {
      "equation_id": "EQ-06",
      "latex": "W_{wait} = \\frac{L_q}{\\lambda_p}",
      "type": "queue_metric",
      "variables_refs": [
        "v_W",
        "v_Lq"
      ],
      "derivation_trace": "等待时间由队长与到达率反解（Little 定律变形）。",
      "sub_question_binding": [
        "Q1",
        "Q2",
        "Q3"
      ]
    },
    {
      "equation_id": "EQ-07",
      "latex": "R_{fare} = r_{km}\\, \\bar{D}",
      "type": "revenue",
      "variables_refs": [
        "v_Rf",
        "v_D"
      ],
      "derivation_trace": "载客期望收益 = 单位里程收益 × 平均载客里程。",
      "sub_question_binding": [
        "Q1",
        "Q2"
      ]
    },
    {
      "equation_id": "EQ-08",
      "latex": "eff = m\\, \\mu",
