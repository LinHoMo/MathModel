    },
    {
      "id": "M2",
      "name": "奖励函数",
      "equation": "R(s,a) = -cost(s,a) + reward(到达绿洲)",
      "derivation_notes": "代价+奖励"
    },
    {
      "id": "M3",
      "name": "Bellman 方程",
      "equation": "V(s) = max_a [R(s,a) + γ·E[V(s')]",
      "derivation_notes": "MDP 值迭代"
    }
