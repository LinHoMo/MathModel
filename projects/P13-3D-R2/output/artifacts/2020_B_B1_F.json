      "id": "M1",
      "name": "位置动态",
      "equation": "s(t+1) = s(t) + v(t)·Δt",
      "derivation_notes": "确定性前进"
    },
    {
      "id": "M2",
      "name": "资源消耗",
      "equation": "r(t+1) = r(t) - c(v, weather)·Δt",
      "derivation_notes": "消耗率依赖速度和天气"
    },
    {
      "id": "M3",
      "name": "天气转移",
      "equation": "P(w'=j | w=i) = T_ij",
      "derivation_notes": "马尔可夫转移矩阵"
    },
    {
      "id": "M4",
      "name": "Bellman 方程",
      "equation": "V(s,w) = min_a [cost(s,w,a) + γ·Σ_w' T(w,w')·V(s',w')]",
      "derivation_notes": "MDP 值迭代"
    }
  ],
  "candidate_models": [
