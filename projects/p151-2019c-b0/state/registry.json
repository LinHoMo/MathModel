        ],
        "objective": "建立机场出租车司机A/B选择决策模型与系统优化模型：Q1司机期望净收益最大化决策阈值，Q3双车道上车点布局吞吐率最大化，Q4短途优先权下司机收益方差最小化",
        "assumptions": [
          "乘客到达服从泊松过程，到达率随时段变化（非齐次泊松）",
          "出租车载客服务时间服从负指数分布，平均服务时间含上车+驶出",
          "蓄车池容量有限，出租车按FCFS排队进场",
          "司机为理性经济人，以期望净收益最大化为决策目标",
          "市区出租车需求在短时间窗内稳定，放空回市区后可在平均等待时间内获得乘客",
          "Q3中两条车道对称，车辆可在任意上车点服务",
          "Q4中短途定义为行驶里程低于阈值d_thresh的订单",
          "所有司机遵守管理规则，不拒载、不插队"
        ],
        "variables": [
          {
            "name": "乘客到达率",
            "symbol": "lambda(t)",
            "type": "时变输入"
          },
          {
            "name": "出租车服务率",
            "symbol": "mu",
            "type": "参数"
          },
          {
            "name": "蓄车池排队长度",
