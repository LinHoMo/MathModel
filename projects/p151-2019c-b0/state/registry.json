            "type": "状态变量"
          },
          {
            "name": "司机期望等待时间",
            "symbol": "E[W]",
            "type": "中间变量"
          },
          {
            "name": "选择A的期望净收益",
            "symbol": "Pi_A",
            "type": "决策变量"
          },
          {
            "name": "选择B的期望净收益",
            "symbol": "Pi_B",
            "type": "决策变量"
          },
          {
            "name": "上车点位置向量",
            "symbol": "x = (x_1,...,x_k)",
            "type": "决策变量(Q3)"
          },
          {
            "name": "优先权折扣因子",
            "symbol": "alpha",
            "type": "决策变量(Q4)"
          }
        ],
        "parameters": [
          {
            "name": "空载单位成本",
            "symbol": "c_e",
