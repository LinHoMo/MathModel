    "MH-ASSUMPTION-0001": {
      "schema_version": "3.1",
      "artifact_id": "MH-ASSUMPTION-0001",
      "type": "assumption",
      "version": 1,
      "status": "active",
      "title": "模型假设 A01-A08",
      "created_by": "model_construction",
      "created_at": "2026-09-10T13:16:23Z",
      "updated_at": "2026-09-10T13:16:23Z",
      "payload": {
        "items": [
          {
            "id": "A01",
            "type": "projection",
            "source": "problem_explicit",
            "confidence": 1.0,
            "text": "药材为圆柱形（长 25 cm、半径 2 cm），长径比 12.5 ⇒ 轴向梯度可忽略，仅考虑径向一维（1D 轴对称）传热传质。"
          },
          {
            "id": "A02",
            "type": "mechanism_assumption",
            "source": "problem_explicit",
            "confidence": 1.0,
            "text": "表面与烘房空气之间为对流换热 / 对流传质（Robin 条件），换热系数 h 与传质系数 h_m 取附录 2 给定值（h 只用于 Q1，因附录 2 给出；Q2–Q4 温度按恒温干燥设定）。"
          },
          {
            "id": "A03",
            "type": "calibration_anchor",
            "source": "reasonable_simplification",
            "confidence": 0.85,
            "text": "烘房空气湿度 C_air(t) 取两段阶跃：预热段 0.15 kg/kg，恒温干燥段 0.05 kg/kg；烘房温度按指数趋近恒温值 T_target（时间常数 450 s）。Q1 的 C_air 取 0.10 kg/kg 恒定常数。"
          },
          {
            "id": "A04",
            "type": "calibration_anchor",
            "source": "assumption_derived",
            "confidence": 0.8,
            "text": "恒温干燥目标温度取 T_target = 50 °C（中药材低温热风干燥的典型工艺温度），与题面「烘干一般持续 2–3 天」自洽。"
          },
          {
            "id": "A05",
            "type": "simplification",
            "source": "reasonable_simplification",
            "confidence": 0.9,
            "text": "物性随 (C,T) 变化时，在隐式格式中取其上一时步的值（半隐式滞后），使每个时间步的离散方程仍为线性三对角系统。"
          },
          {
            "id": "A06",
            "type": "mechanism_assumption",
            "source": "problem_explicit",
            "confidence": 1.0,
            "text": "烘干收缩为各向同性：药材保持圆柱形，半径按 R(t) 均匀收缩，长度方向不变（干物质总量守恒）。"
          },
          {
            "id": "A07",
            "type": "simplification",
            "source": "reasonable_simplification",
            "confidence": 0.9,
            "text": "忽略水分迁移引起的对流通量（Darcy 渗流）、忽略温度对相变/汽化潜热的显式耦合，热与质通过物性 D(C,T) 单向耦合（温度影响扩散系数，水分通过热容影响温度）。"
          },
          {
            "id": "A08",
            "type": "verification_invariant",
            "source": "assumption_derived",
            "confidence": 1.0,
            "text": "烘干判据：药材各处（含中心 r=0）含水率同时低于 0.15 kg/kg；因中心扩散路径最长，等价于中心含水率 C(0,t) < 0.15。"
          }
        ]
      }
    },
