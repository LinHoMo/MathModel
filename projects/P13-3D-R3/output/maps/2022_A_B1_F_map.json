      "artifact_type": "mechanism",
      "artifact_id": "M4",
      "artifact_name": "入射波功率",
      "artifact_expression": "P_wave = (ρ_w·g·A²·ω)/(2k_w) · S",
      "paper_section": "Section 5",
      "paper_role": "equation"
