      "artifact_type": "mechanism",
      "artifact_id": "M3",
      "artifact_name": "输出功率",
      "artifact_expression": "P = η·c·v² = η·c·A²·ω²·cos²(ωt)",
      "paper_section": "Section 5",
      "paper_role": "equation"
    },
