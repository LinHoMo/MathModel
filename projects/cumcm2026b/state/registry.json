    "MH-ASSUMPTION-0001": {
      "schema_version": "3.1",
      "artifact_id": "MH-ASSUMPTION-0001",
      "type": "assumption",
      "version": 1,
      "status": "active",
      "title": "模型假设 A01-A08",
      "created_by": "model_construction",
      "created_at": "2026-09-10T13:16:24Z",
      "updated_at": "2026-09-10T13:16:24Z",
      "payload": {
        "items": [
          {
            "id": "A01",
            "type": "problem_statement",
            "source": "problem_explicit",
            "confidence": 1.0,
            "text": "示向度含全局误差，落在 [−1°,1°] 内；故一条示向度对应一个夹角 2° 的楔形角域（射线 ±1°）。"
          },
          {
            "id": "A02",
            "type": "mechanism_assumption",
            "source": "problem_explicit",
            "confidence": 1.0,
            "text": "有效接收半径 1000–1500 m，信号在覆盖角内均匀辐射，场强仅随距离衰减；距离过近（≤5 m）时信号过强无法测向，可直接光学清除。"
          },
          {
            "id": "A03",
            "type": "simplification",
            "source": "reasonable_simplification",
            "confidence": 0.9,
            "text": "本地模拟器复现附录 1/2 规则：每源频道互异、信号互不影响、定向源覆盖角为定向方向两侧各 90°；检测点须静止（切换频道+调天线+稳定读数合计 5 s），机器狗直线移动 5 m/s。"
          },
          {
            "id": "A04",
            "type": "measurement_model",
            "source": "assumption_derived",
            "confidence": 0.9,
            "text": "机器狗只能使用可观测量（示向度 + 信号相对强度）决策；真实源坐标仅由模拟器内部用于判定“是否进入 20 m 光学作用距离”，策略代码不含任何真值导向。"
          },
          {
            "id": "A05",
            "type": "coverage_guarantee",
            "source": "assumption_derived",
            "confidence": 1.0,
            "text": "全向源覆盖完备性：圆域 R=1800 m、r_rec ≥ 1000 m 时，取同心环路径半径 {450,1350} m，则圆域内任意点到最近环的径向距离 ≤ 450 m ≪ 1000 m，故任意全向源必被扫到。"
          },
          {
            "id": "A06",
            "type": "coverage_guarantee",
            "source": "assumption_derived",
            "confidence": 0.98,
            "text": "定向源覆盖：定向源仅在波束（半平面）内侧可测向，朝外定向源只能从外侧接近。除 {450,1350} 外增加环 {1200,1799} m 形成全 360° 外侧覆盖；数值验证（各 2×10⁴ 随机源）全向漏检率 0.0000、含定向漏检率 0.00025（仅剩贴边界极薄环带）。"
          },
          {
            "id": "A07",
            "type": "modeling_choice",
            "source": "reasoning",
            "confidence": 0.9,
            "text": "以交会角 φ 作为定位质量判据（GDOP ∝ 1/sin φ，φ=90° 最优）；在估计源 G_est 处交会角恒 90° 的点集为过 G_est 且垂直于 S1→G_est 的直线（Thales 圆在 G_est 处的切线）。"
          },
          {
            "id": "A08",
            "type": "design_choice",
            "source": "reasoning",
            "confidence": 0.9,
            "text": "定位采用“交会定位 + beam-safe 归航”双机制：交会给出估计点用于远距离跳转，归航沿当前示向度逐步逼近（沿指向源的射线移动不会脱离波束），对定向源天然稳健；清除时机由模拟器在距离 ≤20 m 时触发。"
          }
        ]
      }
    },
