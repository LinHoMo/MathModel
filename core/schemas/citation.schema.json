{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "引用条目 Citation Entry",
  "description": "用于承诺-兑现检查与占位符扫描的结构化引用条目。",
  "type": "object",
  "required": ["id", "type"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_:-]*$",
      "description": "BibTeX 引用键（如 spiral_kinematics），排除 {cite_XXX} 占位符"
    },
    "type": {
      "type": "string",
      "enum": ["article", "book", "inproceedings", "misc", "online", "thesis", "techreport"],
      "description": "文献类型"
    },
    "doi": {
      "type": "string",
      "pattern": "^10\\.[0-9]{4,9}/[-._;()/:A-Za-z0-9]+$",
      "description": "DOI（10.xxxx/... 格式；缺失表示未标注，不一定是错误）"
    },
    "title": { "type": "string" },
    "authors": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "container": { "type": "string", "description": "期刊/会议/出版社" },
    "year": {
      "type": "integer",
      "minimum": 1900,
      "maximum": 2030
    },
    "claims_supported": {
      "type": "array",
      "items": { "type": "string" },
      "description": "本条目所支持的声明 ID 列表（对应 main.tex 中 \\label{claim:...} 或标注）"
    },
    "verified": {
      "type": "string",
      "enum": ["pending", "ok", "unreachable", "broken"],
      "default": "pending",
      "description": "验证状态：ok=已确认可达；unreachable=DOI/链接失效；broken=条目与声明不符"
    },
    "first_cited_in": {
      "type": "string",
      "description": "首次在论文哪个小节被引用（如 section:method:model）"
    }
  }
}
