{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MODEL_PAPER_MAP v1（P13-3D-R3 Structure-Preserving Transmission Layer）",
  "description": "纯映射中间表示：把 Frozen MODEL_ARTIFACT 的元素索引到 Paper 的目标位置。不允许创造任何模型内容。每个 entry 必须有 artifact_ref。",
  "type": "object",
  "required": ["claim_inventory", "element_map", "question_map", "candidate_model_map", "sensitivity_map", "section_map"],
  "properties": {
    "claim_inventory": {
      "type": "array",
      "minItems": 1,
      "description": "模型的核心主张清单：selected_model + selection_reason + key claims",
      "items": {
        "type": "object",
        "required": ["id", "claim_type", "text", "artifact_ref"],
        "properties": {
          "id": {"type": "string", "description": "Claim ID (C1, C2, ...)"},
          "claim_type": {
            "type": "string",
            "enum": ["model_selection", "model_justification", "key_finding", "assumption", "limitation"],
            "description": "主张类型"
          },
          "text": {"type": "string", "description": "主张的自然语言表述"},
          "artifact_ref": {
            "type": "string",
            "description": "Artifact 中的引用路径，如 'selected_model', 'selection_reason', 'assumptions.A1'"
          },
          "paper_target": {
            "type": "string",
            "description": "论文中应出现的目标位置，如 'Section 3.2', 'Abstract'"
          }
        }
      }
    },
    "element_map": {
      "type": "array",
      "minItems": 1,
      "description": "Artifact 元素到 Paper 位置的映射",
      "items": {
        "type": "object",
        "required": ["id", "artifact_type", "artifact_id", "artifact_name", "paper_section", "paper_role"],
        "properties": {
          "id": {"type": "string", "description": "Map entry ID (E1, E2, ...)"},
          "artifact_type": {
            "type": "string",
            "enum": ["variable", "parameter", "constraint", "mechanism", "assumption", "objective"],
            "description": "Artifact 中的元素类型"
          },
          "artifact_id": {"type": "string", "description": "Artifact 中的元素 ID"},
          "artifact_name": {"type": "string", "description": "Artifact 中的元素名称"},
          "artifact_expression": {"type": "string", "description": "如果是 mechanism/constraint/objective，记录完整表达式"},
          "paper_section": {"type": "string", "description": "论文中应出现的目标章节"},
          "paper_role": {
            "type": "string",
            "enum": ["definition", "equation", "derivation", "table", "figure", "discussion"],
            "description": "在论文中的角色"
          }
        }
      }
    },
    "question_map": {
      "type": "array",
      "minItems": 1,
      "description": "子问题到 Artifact 元素的映射",
      "items": {
        "type": "object",
        "required": ["question_id", "question_text", "primary_elements", "mechanism_elements"],
        "properties": {
          "question_id": {"type": "string", "description": "子问题 ID (Q1, Q2, ...)"},
          "question_text": {"type": "string", "description": "子问题简述"},
          "primary_elements": {
            "type": "array",
            "items": {"type": "string"},
            "description": "该问题主要涉及的 Element Map IDs"
          },
          "mechanism_elements": {
            "type": "array",
            "items": {"type": "string"},
            "description": "该问题涉及的 Mechanism Element IDs"
          },
          "paper_section": {"type": "string", "description": "论文中应出现的目标章节"}
        }
      }
    },
    "candidate_model_map": {
      "type": "array",
      "minItems": 1,
      "description": "候选模型对比的结构化映射（R2 核心遗漏目标）",
      "items": {
        "type": "object",
        "required": ["model_id", "model_name", "pros", "cons", "artifact_ref"],
        "properties": {
          "model_id": {"type": "string", "description": "模型 ID (M1, M2, ...)"},
          "model_name": {"type": "string", "description": "模型名称"},
          "pros": {"type": "string", "description": "优点"},
          "cons": {"type": "string", "description": "缺点"},
          "artifact_ref": {"type": "string", "description": "Artifact 中的引用路径，如 'candidate_models.0'"},
          "is_selected": {"type": "boolean", "description": "是否为选定模型"},
          "selection_reason_ref": {"type": "string", "description": "如果是选定模型，引用 selection_reason"}
        }
      }
    },
    "sensitivity_map": {
      "type": "array",
      "minItems": 1,
      "description": "灵敏度分析计划的结构化映射（R2 核心遗漏目标）",
      "items": {
        "type": "string", "type": "object",
        "required": ["parameter_ref", "parameter_name", "range", "metric", "paper_section"],
        "properties": {
          "parameter_ref": {"type": "string", "description": "Artifact 中参数的引用路径"},
          "parameter_name": {"type": "string", "description": "参数名称"},
          "range": {"type": "string", "description": "扰动范围"},
          "metric": {"type": "string", "description": "评估指标"},
          "paper_section": {"type": "string", "description": "论文中应出现的目标章节"}
        }
      }
    },
    "section_map": {
      "type": "array",
      "minItems": 1,
      "description": "论文章节到 Artifact 元素的反向映射",
      "items": {
        "type": "object",
        "required": ["section_id", "section_name", "required_elements", "required_claims"],
        "properties": {
          "section_id": {"type": "string", "description": "章节 ID (S1, S2, ...)"},
          "section_name": {"type": "string", "description": "章节名称"},
          "required_elements": {
            "type": "array",
            "items": {"type": "string"},
            "description": "该章节必须包含的 Element Map IDs"
          },
          "required_claims": {
            "type": "array",
            "items": {"type": "string"},
            "description": "该章节必须包含的 Claim IDs"
          }
        }
      }
    }
  }
}
