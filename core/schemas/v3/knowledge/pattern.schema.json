{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "v3/knowledge/pattern.schema.json",
  "title": "Innovation Pattern（创新模式）",
  "description": "创新模式卡：pattern_id / problem_type / baseline_method / innovation / required_evidence / risks / examples。检索时按问题特征推荐组合式创新路径。",
  "type": "object",
  "required": [
    "pattern_id", "title", "problem_types", "baseline_method",
    "innovation", "required_evidence", "risks"
  ],
  "additionalProperties": false,
  "properties": {
    "pattern_id": {
      "type": "string",
      "pattern": "^ip-[a-z0-9-]{2,48}$"
    },
    "title": {"type": "string", "minLength": 2},
    "problem_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "baseline_method": {"type": "string", "description": "常规做法（对照基线）"},
    "innovation": {"type": "string", "description": "创新点：在基线上叠加什么"},
    "required_evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}, "description": "创新成立必需的对比证据（基线 vs 创新）"},
    "risks": {"type": "array", "items": {"type": "string"}, "description": "为创新而创新的风险"},
    "examples": {"type": "array", "items": {"type": "string"}, "description": "历史赛题应用示例"},
    "cards": {"type": "array", "items": {"type": "string"}, "description": "涉及的方法卡 card_id"}
  }
}
