{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "v3/knowledge/method_card.schema.json",
  "title": "Method Card（方法卡）",
  "description": "方法卡 = 建模知识约束/先验/验证（Constraint / Prior / Validation），不是答案库。提供使用前提、风险、验证方式和反模式，不指定“必须使用”。检索输出候选方法 + 适用条件 + 风险 + 验证方式 + 历史失败案例。LLM 可自由提出 catalog 外的新方法；Evidence = Adjudication，实验和证据才决定模型是否成立。",
  "type": "object",
  "required": [
    "card_id",
    "name",
    "family",
    "version",
    "problem_types",
    "good_for",
    "requires",
    "risks",
    "validation",
    "often_combined_with",
    "anti_patterns"
  ],
  "additionalProperties": false,
  "properties": {
    "card_id": {
      "type": "string",
      "pattern": "^mc-[a-z0-9-]{2,48}$",
      "description": "稳定卡片 ID，如 mc-topsis"
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "description": "方法人类可读名称"
    },
    "family": {
      "type": "string",
      "description": "方法族（与 METHOD-DECISION-TREE.json 的 family 对齐），如 composite_evaluation / metaheuristics / classical_timeseries"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "problem_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      },
      "description": "适配的问题类型标签（兼容性提示），不是硬限制。LLM 可将方法用于其他问题类型，但需自行验证适用性。"
    },
    "match": {
      "type": "object",
      "description": "仅用于检索排序的软特征，不参与硬过滤或自动选方法。Knowledge coverage constrains evaluation, not constrain creativity.",
      "additionalProperties": false,
      "properties": {
        "requires_data": {
          "type": "boolean"
        },
        "sample_size": {
          "type": "array",
          "items": {
            "enum": [
              "small",
              "medium",
              "large"
            ]
          },
          "description": "兼容样本档（small<200 / medium 200-1000 / large>=1000）"
        },
        "time_series": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "null 表示与是否时序无关"
        },
        "multi_objective": {
          "type": "boolean"
        },
        "handles_uncertainty": {
          "type": "boolean"
        }
      }
    },
    "good_for": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "description": "适用场景描述（兼容性提示），不是排他性推荐。不意味着其他方法不可用。"
    },
    "problem_structures": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "该方法适配的问题结构（如 motion, network, scheduling, diffusion, allocation, ranking, prediction, classification, inverse_problem, equilibrium, transport 等）。兼容性提示，可选。"
    },
    "modeling_patterns": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "该方法体现的建模模式（如 state_transition, conservation, flow, distance, optimization_objective, probability_distribution, graph_traversal, feedback_loop 等）。兼容性提示，可选。"
    },
    "mathematical_forms": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "该方法的数学形式（如 optimization, differential_equation, graph, probability, linear_algebra, statistics, recurrence, integral 等）。兼容性提示，可选。"
    },
    "mechanism": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "建模机理（Model Construction Knowledge 核心）——该方法成立所依赖的问题内在结构/因果机制，如 Bellman 最优性原理、守恒律（积分形式→微分形式）、状态-动作-转移-奖励五元组。区别于标签：这是可供 LLM 判断“这个问题是否具有该结构”的机理描述。可选。"
    },
    "formulations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "典型数学表述/核心公式（如 Bellman 方程、热方程 ∂u/∂t=α∇²u+S、M/M/1 的 L=ρ/(1-ρ)）。帮助 LLM 评估数学结构是否匹配；不是强制实现清单。可选。"
    },
    "solvers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "常用求解器/求解策略（如值迭代、Crank-Nicolson、离散事件仿真）。与 Mathematical Formulation 严格区分：PDE ≠ numerical_PDE，optimization ≠ GA。可选。"
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "使用前提（数据/假设/规模条件）"
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "必做验证清单——使用该方法时必须执行的验证步骤（灵敏度/交叉检验/多起点/残差分析等）。Evidence = Adjudication：这些验证产生成立证据。"
    },
    "often_combined_with": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "常组合方法 card_id"
    },
    "anti_patterns": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "误用形态——使用该方法时常见的错误模式。对应 Failure Memory。出现这些模式时模型可信度存疑。"
    },
    "known_failures": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "关联 failure_id 列表"
    },
    "reference": {
      "type": "string",
      "description": "human-readable 详档（core/knowledge/methodology/ 相对路径），不强制"
    },
    "objective_types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "positive": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "negative": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required_conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "overfitting": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "data_sensitivity": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "numerical_instability": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "interpretability": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "competition_risk": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        }
      }
    },
    "evidence_requirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimum": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recommended": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "typical_metrics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "compatible_methods": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "incompatible_methods": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "costs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "data": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "compute": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        }
      }
    },
    "robustness": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "overfitting_risk": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "competition_suitability": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "innovation_potential": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "interpretability": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "draft",
        "deprecated"
      ]
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "source_type": {
      "type": "string",
      "enum": [
        "official",
        "paper",
        "competition_archive",
        "expert_knowledge",
        "empirical",
        "generated"
      ]
    }
  }
}