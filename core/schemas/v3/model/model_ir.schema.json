{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathmodel.harness/model-ir/1.0",
  "title": "MODEL_IR — Executable Model Specification Contract (template-aligned)",
  "description": "与 P15-K002 S/SV 模板 18 字段承诺精确对齐的可执行契约（2026-09-09 重建）。顶层 required = 模板 18 字段；嵌套约束 = 模板承诺字段与词表（中文 enum 与模板一致）；模板未承诺的深层结构不约束（additionalProperties: true）。历史：旧版契约从未被产物满足（K001 55/55、K002 预检 6/6 违反，159–403 错误/份），register 从不校验——本重建使 jsonschema 校验成为真实可执行的门槛。 修订：validations.type enum 增加 constraint/consistency（约束满足/一致性验证，2024_A VS-001 真实类型）。audit FIX-5.4。",
  "type": "object",
  "required": [
    "ir_version",
    "model_id",
    "model_family",
    "problem_binding",
    "assumptions",
    "variables",
    "parameters",
    "objectives",
    "constraints",
    "mechanisms",
    "equations",
    "dependencies",
    "solvers",
    "experiments",
    "validations",
    "claims",
    "model_graph",
    "modeling_trace"
  ],
  "properties": {
    "code_mapping": {
      "type": "object",
      "description": "audit FIX-2.3：equation_id → code section/symbol 映射（可选）",
      "additionalProperties": {
        "type": "string"
      }
    },
    "ir_version": {
      "const": "1.0",
      "description": "固定 '1.0'"
    },
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "model_family": {
      "type": "object",
      "required": [
        "primary",
        "description"
      ],
      "properties": {
        "primary": {
          "type": "string",
          "minLength": 1,
          "description": "受控词表（模板『建模结构词表』）；out_of_catalog 不自动判错"
        },
        "secondary": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "candidates": {
          "type": "array",
          "description": "候选模型对比（E4 评分承载）：≥2 个候选 + 各自选择/排除依据",
          "items": {
            "type": "object",
            "required": [
              "family",
              "rationale"
            ],
            "properties": {
              "family": {
                "type": "string",
                "minLength": 1
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          },
          "default": []
        }
      },
      "additionalProperties": true
    },
    "problem_binding": {
      "type": "object",
      "required": [
        "problem_id",
        "sub_question_id",
        "problem_sha256"
      ],
      "properties": {
        "problem_id": {
          "type": "string",
          "minLength": 1
        },
        "sub_question_id": {
          "type": "string",
          "minLength": 1
        },
        "problem_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": true
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "假设（模板承诺字段，additionalProperties 开放）",
        "additionalProperties": true,
        "required": [
          "assumption_id",
          "text",
          "type",
          "rationale"
        ],
        "properties": {
          "assumption_id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "projection",
              "calibration",
              "mechanism",
              "simplification",
              "mechanism_assumption"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "variables": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "变量（模板承诺字段，additionalProperties 开放）",
        "additionalProperties": true,
        "required": [
          "variable_id",
          "name",
          "symbol",
          "definition",
          "unit",
          "type",
          "sub_question_binding"
        ],
        "properties": {
          "variable_id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "symbol": {
            "type": "string",
            "minLength": 1
          },
          "definition": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "default": ""
          },
          "type": {
            "type": "string",
            "enum": [
              "state",
              "decision",
              "observation",
              "constant",
              "derived",
              "parameter"
            ]
          },
          "sub_question_binding": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          }
        }
      }
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "参数（模板承诺字段，additionalProperties 开放）",
        "additionalProperties": true,
        "required": [
          "parameter_id",
          "name",
          "symbol",
          "value",
          "source"
        ],
        "properties": {
          "parameter_id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "symbol": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ]
          },
          "source": {
            "type": "string",
            "enum": [
              "题目",
              "校准",
              "文献",
              "假设",
              "推导",
              "derived",
              "problem_given",
              "computed",
              "test_fixture"
            ]
          }
        }
      }
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "目标（模板承诺字段，additionalProperties 开放）",
        "additionalProperties": true,
        "required": [
          "objective_id",
          "type",
          "expression",
          "variables_refs",
          "sub_question_binding"
        ],
        "properties": {
          "objective_id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "minimize",
              "maximize",
              "estimate",
              "satisfy",
              "simulate",
              "find",
              "compute",
              "predict",
              "classify",
              "optimize"
            ]
          },
          "expression": {
            "type": "string",
            "minLength": 1
          },
          "variables_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "default": []
          },
          "sub_question_binding": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          }
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "约束（模板承诺字段，additionalProperties 开放）",
        "additionalProperties": true,
        "required": [
          "constraint_id",
          "type",
          "expression",
          "variables_refs",
          "source",
          "sub_question_binding"
        ],
        "properties": {
          "constraint_id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "expression": {
            "type": "string",
            "minLength": 1
          },
          "variables_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "default": []
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "sub_question_binding": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          }
        }
      }
    },
    "mechanisms": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "机理（模板承诺字段，additionalProperties 开放）",
        "additionalProperties": true,
        "required": [
          "mechanism_id",
          "description",
          "related_equations",
          "sub_question_binding"
        ],
        "properties": {
          "mechanism_id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "related_equations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "default": []
          },
          "sub_question_binding": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          }
        }
      }
    },
    "equations": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "方程（模板承诺字段，additionalProperties 开放）",
        "additionalProperties": true,
        "required": [
          "equation_id",
          "latex",
          "type",
          "variables_refs",
          "derivation_trace",
          "sub_question_binding"
        ],
        "properties": {
          "equation_id": {
            "type": "string",
            "minLength": 1
          },
          "latex": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "variables_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "default": []
          },
          "derivation_trace": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "additionalProperties": true
                }
              ]
            }
          },
          "sub_question_binding": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "solvers": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "求解器（模板承诺字段，additionalProperties 开放）",
        "additionalProperties": true,
        "required": [
          "solver_id",
          "method",
          "implementation_ref",
          "sub_question_binding"
        ],
        "properties": {
          "solver_id": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "implementation_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "sub_question_binding": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          }
        }
      }
    },
    "experiments": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "实验（模板承诺字段，additionalProperties 开放）",
        "additionalProperties": true,
        "required": [
          "experiment_id",
          "type",
          "inputs",
          "expected_outputs",
          "sub_question_binding"
        ],
        "properties": {
          "experiment_id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "inputs": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": true
              },
              {
                "type": "array",
                "items": {}
              }
            ]
          },
          "expected_outputs": {
            "type": "array",
            "items": {}
          },
          "sub_question_binding": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          }
        }
      }
    },
    "validations": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "验证（模板承诺字段，additionalProperties 开放）",
        "additionalProperties": true,
        "required": [
          "validation_id",
          "type",
          "method",
          "targets_refs",
          "sub_question_binding"
        ],
        "properties": {
          "validation_id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "baseline",
              "sensitivity",
              "limit",
              "reproducibility",
              "convergence",
              "uncertainty",
              "constraint",
              "consistency",
              "constraint_check",
              "consistency_check"
            ]
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "targets_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "default": []
          },
          "sub_question_binding": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "结论（模板承诺字段，additionalProperties 开放）",
        "additionalProperties": true,
        "required": [
          "claim_id",
          "text",
          "type",
          "evidence_refs",
          "model_refs",
          "sub_question_binding",
          "status"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "default": []
          },
          "model_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "default": []
          },
          "sub_question_binding": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "status": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "model_graph": {
      "description": "模型结构图（节点-边描述，宽松承载）",
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": true
        },
        {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      ]
    },
    "modeling_trace": {
      "description": "建模过程简要溯源（宽松承载）",
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        {
          "type": "object",
          "additionalProperties": true
        },
        {
          "type": "string"
        }
      ]
    }
  },
  "additionalProperties": true
}