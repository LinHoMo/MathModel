{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Decision Log Schema",
  "type": "object",
  "required": ["project_name", "created_at", "updated_at", "entries"],
  "properties": {
    "project_name": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["timestamp", "stage", "agent", "decision_type", "question", "options", "choice", "rationale", "confidence", "alternatives_considered", "time_spent_seconds"],
        "properties": {
          "timestamp": { "type": "string", "format": "date-time" },
          "stage": { "type": "string" },
          "agent": { "type": "string" },
          "decision_type": { "type": "string", "enum": ["model_selection", "verdict", "refine", "parameter", "template", "structure", "figure", "reference", "other"] },
          "question": { "type": "string" },
          "options": {
            "type": "array",
            "items": { "type": "object", "properties": { "label": { "type": "string" }, "description": { "type": "string" } } }
          },
          "choice": { "type": "string" },
          "rationale": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "alternatives_considered": { "type": "array", "items": { "type": "string" } },
          "time_spent_seconds": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}