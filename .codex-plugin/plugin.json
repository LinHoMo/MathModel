{
  "name": "mathmodeling-skills",
  "version": "2.0.0",
  "description": "数学建模竞赛全流程 AI 技能包：从赛题到论文，支持 CUMCM/MCM/ICM/电工杯/华为杯/华数杯/APMCM/MathorCup/认证杯/数维杯。基于 UTG 六层防御架构，29 个 agent 串联，契约化交付、可追溯、可复现。",
  "author": "MathModelSkills Team",
  "license": "MIT",
  "repository": "https://github.com/your-org/MathModelSkills",
  "homepage": "https://github.com/your-org/MathModelSkills",
  "keywords": [
    "mathematical-modeling",
    "cumcm",
    "mcm-icm",
    "ai-agent",
    "latex",
    "paper-writing",
    "verification"
  ],
  "entry_points": {
    "skill": "agents/openai.yaml"
  },
  "skills": [
    {
      "name": "mathmodeling",
      "description": "数学建模竞赛全流程技能",
      "entry_point": "core/AGENTS.md"
    }
  ],
  "hooks": {
    "on_project_start": "python core/tools/doctor.py --project {project} --competition {competition}",
    "on_new_problem": "python core/tools/new_project.py {project} --competition {competition} --problem {problem_file}"
  },
  "config_schema": {
    "type": "object",
    "properties": {
      "competition": {
        "type": "string",
        "enum": ["cumcm", "mcm", "icm", "diangong", "huawei", "huashu", "apmcm", "mathorcup", "renzhengbei", "shuweibei"],
        "default": "cumcm",
        "description": "竞赛类型"
      },
      "language": {
        "type": "string",
        "enum": ["zh", "en"],
        "default": "zh",
        "description": "论文语言"
      },
      "strict_mode": {
        "type": "boolean",
        "default": true,
        "description": "严格模式：阈值不达即阻塞"
      },
      "friendly_mode": {
        "type": "boolean",
        "default": true,
        "description": "友好模式：关键决策以编号选项呈现"
      },
      "compile_pdf": {
        "type": "string",
        "enum": ["auto", "always", "never"],
        "default": "auto",
        "description": "PDF 编译策略"
      }
    }
  },
  "runtime_requirements": {
    "python": ">=3.10",
    "packages": [
      "numpy>=1.24",
      "scipy>=1.10",
      "pandas>=2.0",
      "matplotlib>=3.7",
      "networkx>=3.1",
      "scikit-learn>=1.3",
      "pulp>=2.7",
      "ortools>=9.8",
      "pymoo>=0.6",
      "salib>=1.4",
      "shap>=0.42",
      "nashpy>=0.1",
      "graphviz>=0.20"
    ],
    "system_tools": [
      "xelatex (TeX Live/MiKTeX)",
      "graphviz (dot)",
      "git"
    ]
  }
}