{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "mathmodel:v3/artifact/registry.schema.json",
  "title": "V3 Artifact Registry",
  "type": "object",
  "required": ["registry_version", "counters", "artifacts"],
  "properties": {
    "registry_version": { "const": 3 },
    "project": { "type": "string" },
    "updated_at": { "type": "string" },
    "counters": {
      "type": "object",
      "description": "type → 已发放 ID 数（永不回退，保证 ID 不复用）",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "artifacts": {
      "type": "object",
      "description": "artifact_id → 最新版本 contract",
      "additionalProperties": { "$ref": "mathmodel:v3/artifact/artifact.schema.json" }
    },
    "history": {
      "type": "object",
      "description": "artifact_id → {version: 旧版本快照}（不可变）",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": { "$ref": "mathmodel:v3/artifact/artifact.schema.json" }
      }
    }
  }
}
